---
import type { NewsItem } from '../../lib/types';

export interface Props {
    news: NewsItem;
}

const { news } = Astro.props;
---

<article class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 flex flex-col h-full hover:-translate-y-1">
    <!-- Image -->
    <div class="relative h-48 sm:h-52 w-full overflow-hidden bg-slate-100">
        <img
            src={news.imageUrl}
            alt={news.title}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            onerror="this.src='/assets/images/foto-utama-wiz.jpg'"
        />
        <div class="absolute top-3 left-3">
            <span class="text-[11px] font-bold px-3 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-emerald-300 border border-slate-700 shadow-sm">
                {news.category}
            </span>
        </div>
    </div>

    <!-- Content -->
    <div class="p-5 sm:p-6 flex flex-col flex-grow">
        <div class="flex items-center gap-3 text-xs text-slate-400 mb-2">
            <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-[15px]">calendar_today</span>
                {news.date}
            </span>
            <span>•</span>
            <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-[15px]">schedule</span>
                {news.readTime}
            </span>
        </div>

        <h3 class="font-bold text-slate-900 text-base sm:text-lg line-clamp-2 group-hover:text-[#006834] transition-colors leading-snug mb-2">
            <a href={`/berita/${news.id}`}>
                {news.title}
            </a>
        </h3>

        <p class="text-xs sm:text-sm text-slate-500 line-clamp-3 mb-4 leading-relaxed flex-grow">
            {news.summary}
        </p>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-400">{news.author}</span>
            <a
                href={`/berita/${news.id}`}
                class="inline-flex items-center gap-1 text-xs font-bold text-[#006834] group-hover:translate-x-1 transition-transform"
            >
                Baca Selengkapnya
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
        </div>
    </div>
</article>
