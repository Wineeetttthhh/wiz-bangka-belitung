---
// Hero Banner Section
---

<section class="relative overflow-hidden bg-gradient-to-b from-emerald-900 via-[#005a2d] to-[#004d26] text-white pt-12 pb-20 lg:pt-16 lg:pb-28">
    <!-- Decorative Ambient Glows -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-emerald-400/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 -left-20 w-80 h-80 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Left Headline & CTA -->
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <!-- Trust Badge Pill -->
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-800/80 border border-emerald-600/50 text-emerald-200 text-xs sm:text-sm font-semibold shadow-inner">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>Lembaga Amil Zakat Terpercaya Bangka Belitung</span>
                </div>

                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
                    Tebarkan <span class="text-amber-300 underline decoration-amber-400/40 underline-offset-8">Kebaikan</span> Hingga Pelosok Negeri
                </h1>

                <p class="text-base sm:text-lg text-emerald-100/90 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                    Salurkan Zakat, Infak, dan Sedekah terbaik Anda bersama Wahdah Inspirasi Zakat. Menjangkau ribuan santri, yatim, mualaf, dan keluarga dhuafa di Kepulauan Bangka Belitung.
                </p>

                <!-- Dual Action Buttons -->
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
                    <a
                        href="/donasi"
                        class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-base shadow-xl shadow-amber-950/20 hover:scale-[1.03] active:scale-[0.98] transition-all flex items-center justify-center gap-2.5"
                    >
                        <span class="material-symbols-outlined text-[22px] text-emerald-950">volunteer_activism</span>
                        <span>Donasi Sekarang</span>
                    </a>
                    <a
                        href="/program"
                        class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-base border border-white/20 backdrop-blur-md hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[20px]">explore</span>
                        <span>Pilih Program</span>
                    </a>
                </div>

                <!-- Trust Metrics Pill -->
                <div class="pt-6 border-t border-emerald-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-emerald-200">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-amber-400 text-base">verified_user</span>
                        <span>SK Kemenag RI No. 805</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-emerald-400 text-base">account_balance</span>
                        <span>Rekening BSI 4999 000 005</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-teal-300 text-base">receipt_long</span>
                        <span>Kuitansi Resmi & Transparan</span>
                    </div>
                </div>
            </div>

            <!-- Right Visual Banner Card -->
            <div class="lg:col-span-5">
                <div class="relative mx-auto max-w-md lg:max-w-none">
                    <!-- Glow behind card -->
                    <div class="absolute -inset-1.5 bg-gradient-to-r from-amber-400 to-emerald-400 rounded-3xl blur-lg opacity-40 group-hover:opacity-60 transition duration-1000 group-hover:duration-200"></div>

                    <div class="relative bg-slate-900/90 rounded-3xl p-4 sm:p-5 border border-emerald-500/30 backdrop-blur-xl shadow-2xl text-white space-y-4">
                        <!-- Main Card Image -->
                        <div class="relative h-60 sm:h-72 rounded-2xl overflow-hidden bg-slate-800">
                            <img
                                src="/assets/images/foto-utama-wiz.jpg"
                                alt="Kegiatan WIZ Bangka Belitung"
                                class="w-full h-full object-cover"
                                onerror="this.src='/assets/images/default-program-wiz.jpg'"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                            <div class="absolute bottom-3 left-3 right-3">
                                <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-500 text-slate-950 mb-1 inline-block">Program Prioritas</span>
                                <h3 class="font-bold text-white text-base drop-shadow-md">Tebar Iftar & Buka Puasa Nusantara</h3>
                            </div>
                        </div>

                        <!-- Card Quick Stats & CTA -->
                        <div class="p-3 bg-slate-800/80 rounded-2xl border border-slate-700/80 space-y-2">
                            <div class="flex justify-between text-xs">
                                <span class="text-slate-400">Terkumpul: <strong class="text-white">Rp 73.500.000</strong></span>
                                <span class="text-amber-400 font-bold">74%</span>
                            </div>
                            <div class="w-full h-2 bg-slate-700 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-amber-400 to-emerald-400 rounded-full" style="width: 74%"></div>
                            </div>
                            <div class="flex justify-between items-center pt-2">
                                <span class="text-[11px] text-slate-400">280 Donatur Bergabung</span>
                                <a
                                    href="/donasi?program=tebar-iftar-nusantara"
                                    class="px-4 py-1.5 rounded-xl bg-[#006834] hover:bg-[#008444] text-white text-xs font-bold shadow-md transition-all"
                                >
                                    Ikut Donasi
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
