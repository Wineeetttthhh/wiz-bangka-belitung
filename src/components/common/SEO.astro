---
export interface Props {
    title?: string;
    description?: string;
    image?: string;
    url?: string;
    type?: string;
    keywords?: string;
}

const {
    title = 'WIZ Bangka Belitung - Tebarkan Kebaikan Hingga Pelosok',
    description = 'Wahdah Inspirasi Zakat (WIZ) Bangka Belitung - Lembaga Amil Zakat Terpercaya. Melayani Zakat, Infak, Sedekah & Wakaf untuk kemandirian ummat di Bangka Belitung.',
    image = 'https://www.wizbangkabelitung.or.id/assets/images/foto-utama-wiz.jpg',
    url = 'https://www.wizbangkabelitung.or.id',
    type = 'website',
    keywords = 'WIZ Bangka Belitung, Wahdah Inspirasi Zakat, Donasi Bangka, Zakat Babel, Sedekah Bangka Belitung, Zakat Maal, Beasiswa Tahfidz, Laznas Bangka'
} = Astro.props;

const siteTitle = title.includes('WIZ') ? title : `${title} | WIZ Bangka Belitung`;
const cleanImgPath = image ? (image.startsWith('/') ? image : `/${image}`) : '/assets/images/foto-utama-wiz.jpg';
const fullImageUrl = image.startsWith('http://') || image.startsWith('https://') ? image : `https://www.wizbangkabelitung.or.id${cleanImgPath}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{siteTitle}</title>
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Wahdah Inspirasi Zakat Bangka Belitung" />
<link rel="icon" type="image/png" href="/assets/images/logo-wiz-babel.png" />
<link rel="canonical" href={url} />

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="WIZ Bangka Belitung" />
<meta property="og:url" content={url} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:secure_url" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={siteTitle} />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={url} />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Google Fonts & Material Symbols -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

<!-- Structured Data (JSON-LD) for Charity & Non-Profit -->
<script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "Wahdah Inspirasi Zakat (WIZ) Bangka Belitung",
    "alternateName": "WIZ Babel",
    "url": "https://www.wizbangkabelitung.or.id",
    "logo": "https://www.wizbangkabelitung.or.id/assets/images/logo-wiz-babel.png",
    "description": description,
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Ahmad Yani",
        "addressLocality": "Pangkalpinang",
        "addressRegion": "Kepulauan Bangka Belitung",
        "addressCountry": "ID"
    },
    "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+628117811900",
        "contactType": "Customer Support",
        "areaServed": "ID",
        "availableLanguage": "Indonesian"
    },
    "sameAs": [
        "https://www.instagram.com/wizbangkabelitung",
        "https://www.facebook.com/wizbangkabelitung"
    ]
})} />
