                                <span class="material-symbols-outlined text-[15px]">open_in_new</span>
                            </a>
                        </div>
                    </div>
                </div>`;
            }).join('');
        }

        let isFetchingAffiliateQuotes = false;
        async function fetchFreshQuotesDirectly() {
            if (isFetchingAffiliateQuotes) return;
            isFetchingAffiliateQuotes = true;
            try {
                if (window.wizSupabase && window.wizSupabase.isConfigured()) {
                    const res = await window.wizSupabase.select('site_settings', { filter: 'key=eq.quotes' });
                    if (res && Array.isArray(res.data) && res.data.length > 0 && res.data[0].value) {
                        const quotesList = Array.isArray(res.data[0].value) ? res.data[0].value : [];
                        localStorage.setItem('wiz_quotes', JSON.stringify(quotesList));
                        renderAffiliateQuotesGrid();
                    }
                }
            } catch(e) {
                console.warn('[Affiliate Sync Quotes Error]', e);
            } finally {
                isFetchingAffiliateQuotes = false;
            }
        }

        function shareAffiliateQuoteWA(quoteId) {
            let allQuotes = [];
            if (window.wizStore && window.wizStore.quotes) {
                try { allQuotes = window.wizStore.quotes.getAll() || []; } catch(e) {}
            }
            if (allQuotes.length === 0) {
                try { allQuotes = JSON.parse(localStorage.getItem('wiz_quotes') || '[]'); } catch(e) {}
            }
            const quote = allQuotes.find(q => String(q.id) === String(quoteId)) || allQuotes[0];
            const refCode = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
            const origin = window.location.origin || 'https://www.wizbangkabelitung.or.id';
            const finalShareUrl = `${origin}/quote/${encodeURIComponent(quoteId)}?ref=${encodeURIComponent(refCode)}`;

            let textMsg = '';
            if (quote && quote.text && quote.text.trim()) {
                const source = quote.source || 'Wahdah Inspirasi Zakat';
                textMsg = `*${source}*\n\n"${quote.text.trim()}"\n\n📲 Dapatkan flyer inspirasi & tunaikan sedekah melalui:\n${finalShareUrl}`;
            } else {
                textMsg = `*Inspirasi & Syiar Kebaikan WIZ Bangka Belitung*\n\n📲 Simak flyer dakwah & raih pahala jariyah melalui:\n${finalShareUrl}`;
            }

            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(textMsg)}`, '_blank');
        }

        function copyAffiliateQuoteFull(quoteId) {
            let allQuotes = [];
            if (window.wizStore && window.wizStore.quotes) {
                try { allQuotes = window.wizStore.quotes.getAll() || []; } catch(e) {}
            }
            if (allQuotes.length === 0) {
                try { allQuotes = JSON.parse(localStorage.getItem('wiz_quotes') || '[]'); } catch(e) {}
            }
            const quote = allQuotes.find(q => String(q.id) === String(quoteId)) || allQuotes[0];
            const refCode = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
            const origin = window.location.origin || 'https://www.wizbangkabelitung.or.id';
            const finalShareUrl = `${origin}/quote/${encodeURIComponent(quoteId)}?ref=${encodeURIComponent(refCode)}`;

            let fullText = '';
            if (quote && quote.text && quote.text.trim()) {
                const source = quote.source || 'Wahdah Inspirasi Zakat';
                fullText = `*${source}*\n\n"${quote.text.trim()}"\n\n📲 Mari raih keberkahan dengan berinfak melalui WIZ Bangka Belitung:\n${finalShareUrl}`;
            } else {
                fullText = `*Inspirasi WIZ Bangka Belitung*\n\n📲 Buka flyer & salurkan donasi melalui:\n${finalShareUrl}`;
            }

            navigator.clipboard.writeText(fullText).then(() => {
                alert(`✅ Teks Quote & Link Referral (${refCode}) berhasil disalin ke clipboard:\n\n${fullText}`);
            });
        }

        function copyAffiliateQuoteLink(quoteId) {
            const refCode = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
            const origin = window.location.origin || 'https://www.wizbangkabelitung.or.id';
            const finalShareUrl = `${origin}/quote/${encodeURIComponent(quoteId)}?ref=${encodeURIComponent(refCode)}`;

            navigator.clipboard.writeText(finalShareUrl).then(() => {
                alert(`✅ Link Quote (${refCode}) berhasil disalin:\n\n${finalShareUrl}`);
            });
        }

        function copyFundraisingLink() {
            const activeRef = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
            const origin = window.location.origin || 'https://www.wizbangkabelitung.or.id';
            const url = `${origin}/?ref=${encodeURIComponent(activeRef)}`;
            navigator.clipboard.writeText(url).then(() => {
                alert(`✅ Link Website Utama dengan Kode Mitra (${activeRef}) berhasil disalin:\n\n${url}\n\nDonasi apa pun dari link ini otomatis tercatat atas nama Anda.`);
            });
        }

        async function handleUpdateProfile(e) {
            e.preventDefault();
            if (!currentLoggedAffiliate) return;

            const name = document.getElementById('prof-name').value.trim();
            const bankName = document.getElementById('prof-bank').value.trim();
            const accountNumber = document.getElementById('prof-acc-no').value.trim();
            const accountHolder = document.getElementById('prof-acc-holder').value.trim();
            const pin = document.getElementById('prof-pin').value.trim();

            const updated = {
                ...currentLoggedAffiliate,
                name: name || currentLoggedAffiliate.name,
                bankName: bankName || currentLoggedAffiliate.bankName,
                accountNumber: accountNumber || currentLoggedAffiliate.accountNumber,
                accountHolder: accountHolder || currentLoggedAffiliate.accountHolder
            };
            if (pin) updated.pin = pin;

            if (window.wizStore && window.wizStore.referrals) {
                await window.wizStore.referrals.update(currentLoggedAffiliate.id, updated);
            }
            currentLoggedAffiliate = updated;
            sessionStorage.setItem('wiz_logged_affiliate', JSON.stringify(updated));
            localStorage.setItem('wiz_logged_affiliate', JSON.stringify(updated));
            alert('✅ Perubahan profil dan data rekening berhasil disimpan!');
        }

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const saved = sessionStorage.getItem('wiz_logged_affiliate') || localStorage.getItem('wiz_logged_affiliate');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if (parsed && (parsed.id || parsed.code)) {
                        currentLoggedAffiliate = parsed;
                        activateMemberState(parsed);
                    }
                }
            } catch(e) {}

            renderAffiliateNewsGrid();
            renderAffiliateProgramsGrid();
            renderAffiliateQuotesGrid();

            // Synchronize Latest News, Programs & Quotes from Cloud for all Devices
            fetchFreshNewsDirectly();
            fetchFreshQuotesDirectly();
            if (window.wizStore && typeof window.wizStore.syncFromCloud === 'function') {
                try {
                    await window.wizStore.syncFromCloud(true);
                } catch(err) {}
                renderAffiliateNewsGrid();
                renderAffiliateProgramsGrid();
                renderAffiliateQuotesGrid();
            }
        });

        window.addEventListener('wiz-sync-complete', () => {
            renderAffiliateNewsGrid();
            renderAffiliateProgramsGrid();
            renderAffiliateQuotesGrid();
        });
        window.addEventListener('wiz-news-changed', () => renderAffiliateNewsGrid());
        window.addEventListener('wiz-programs-changed', () => renderAffiliateProgramsGrid());
        window.addEventListener('wiz-quotes-changed', () => renderAffiliateQuotesGrid());
    </script>
</MitraLayout>
