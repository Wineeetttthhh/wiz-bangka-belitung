            const refCode = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
            const origin = window.location.origin || 'https://www.wizbangkabelitung.or.id';
            const finalShareUrl = `${origin}/berita/${encodeURIComponent(newsId)}?ref=${encodeURIComponent(refCode)}`;
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(finalShareUrl)}`, '_blank');
        }

        function copyAffiliateNewsLink(newsId) {
            const refCode = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
