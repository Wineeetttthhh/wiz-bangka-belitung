---
import MitraLayout from '../layouts/MitraLayout.astro';
---

<MitraLayout
    title="Portal Member & Pendaftaran Mitra Penghimpunan Kebaikan — WIZ Bangka Belitung"
    description="Daftar sebagai Mitra Penghimpunan Resmi WIZ Bangka Belitung. Dapatkan Kode Referral khusus, bagi link kebaikan dan peroleh hak insentif 6% atas setiap donasi yang Anda himpun."
    image="/assets/images/default-program-wiz.png"
>
    <style is:global>
        #member-periode-filter option {
            background-color: #ffffff !important;
            color: #0f172a !important;
        }
        #member-kpi-activity-container {
            width: 100% !important;
            display: block !important;
        }
        #member-kpi-activity-container p {
            display: block !important;
            width: 100% !important;
            max-width: 650px !important;
            margin-left: auto !important;
            margin-right: auto !important;
            text-align: center !important;
            white-space: normal !important;
            word-break: normal !important;
        }
    </style>

    <!-- Header Banner -->
    <section class="bg-gradient-to-r from-emerald-900 via-emerald-800 to-teal-900 text-white py-10 sm:py-14 relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 text-center space-y-3">
            <div class="inline-flex items-center gap-2 bg-emerald-700/60 border border-emerald-500/40 px-3.5 py-1 rounded-full text-xs font-semibold text-emerald-200">
                <span class="material-symbols-outlined text-sm">handshake</span>
                <span>Program Kemitraan Kebaikan &amp; Relawan Fundraiser</span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight">Portal Mitra Penghimpunan Kebaikan</h1>
            <p class="text-xs sm:text-base text-emerald-100 max-w-2xl mx-auto leading-relaxed">
                Jadilah jembatan kebaikan ummat. Sebarkan link program donasi resmi WIZ Bangka Belitung, raih pahala jariyah tanpa batas, dan peroleh <strong>Hak Insentif 6%</strong> atas setiap donasi yang terhimpun secara transparan!
            </p>
        </div>
    </section>

    <!-- Main Container: Guest (Auth) vs Member (Dashboard) -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

        <!-- ======================================================== -->
        <!-- STATE 1: GUEST AUTH VIEW (Login / Register Form)         -->
        <!-- ======================================================== -->
        <div id="auth-state-container" class="w-full flex justify-center py-2 sm:py-4">

            <!-- Premium Professional Auth Form Box -->
            <div class="w-full bg-white rounded-2xl sm:rounded-3xl shadow-xl border border-slate-200/80 p-5 sm:p-8" style="width: 100% !important; max-width: 520px !important; margin: 0 auto !important; box-sizing: border-box !important;">
                
                <!-- Card Header -->
                <div class="text-center mb-6 space-y-2">
                    <div class="inline-flex items-center gap-2 bg-emerald-50 border border-emerald-200 px-3.5 py-1 rounded-full text-xs font-bold text-emerald-800">
                        <span class="material-symbols-outlined text-sm">handshake</span>
                        <span>Portal Resmi Mitra WIZ Babel</span>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">Kemitraan Penghimpunan Kebaikan</h2>
                    <p class="text-slate-500 text-xs sm:text-sm">Silakan masuk atau mendaftar akun baru untuk memantau insentif &amp; link donasi.</p>
                </div>

                <!-- Tab Switcher -->
                <div class="flex bg-slate-100 p-1.5 rounded-2xl gap-1.5 mb-6">
                    <button type="button" id="btn-auth-signin" onclick="toggleAuthTab('signin')"
                        class="flex-1 py-3 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-emerald-700 text-white shadow-md cursor-pointer">
                        <span class="material-symbols-outlined text-base">login</span>
                        <span>Masuk Mitra</span>
                    </button>
                    <button type="button" id="btn-auth-signup" onclick="toggleAuthTab('signup')"
                        class="flex-1 py-3 text-xs sm:text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 text-slate-500 hover:text-slate-800 hover:bg-white/80 cursor-pointer">
                        <span class="material-symbols-outlined text-base">person_add</span>
                        <span>Daftar Baru</span>
                    </button>
                </div>

                <!-- Tab 1: Login Form -->
                <div id="auth-signin-view" class="w-full space-y-4">

                        <form id="affiliate-login-form" onsubmit="handleAffiliateLogin(event)" class="space-y-4 flex-1">
                            <div>
                                <label class="block text-xs font-extrabold text-slate-600 mb-2 uppercase tracking-widest">No. WhatsApp / Kode Mitra</label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xl pointer-events-none">smartphone</span>
                                    <input type="text" id="login-identifier" required placeholder="081234567890 atau WIZ-ABC-001"
                                        class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl pl-12 pr-4 py-4 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-slate-600 mb-2 uppercase tracking-widest">PIN Login (4–6 Digit)</label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xl pointer-events-none">lock</span>
                                    <input type="password" id="login-pin" required placeholder="••••••"
                                        class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl pl-12 pr-4 py-4 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                                </div>
                            </div>
                            <button type="submit"
                                class="w-full bg-gradient-to-r from-emerald-700 to-emerald-600 hover:from-emerald-600 hover:to-emerald-500 text-white font-extrabold py-4 rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2.5 cursor-pointer active:scale-[0.99] mt-1">
                                <span class="material-symbols-outlined text-xl">login</span>
                                <span>Masuk ke Dashboard</span>
                            </button>

                            <!-- Lupa PIN Link -->
                            <div class="text-center pt-1">
                                <button type="button" onclick="toggleForgotPin()" class="text-xs text-slate-400 hover:text-emerald-700 font-semibold transition-colors cursor-pointer underline underline-offset-2">
                                    Lupa PIN? Minta reset via WhatsApp
                                </button>
                            </div>
                        </form>

                        <!-- Lupa PIN Panel (hidden by default) -->
                        <div id="forgot-pin-panel" class="hidden mt-4 p-5 bg-slate-50 rounded-2xl border border-slate-200">
                            <div class="flex items-center gap-2 mb-3">
                                <span class="material-symbols-outlined text-emerald-700 text-xl">lock_reset</span>
                                <h4 class="font-extrabold text-slate-900 text-sm">Reset PIN Sendiri</h4>
                            </div>
                            <p class="text-slate-500 text-xs leading-relaxed mb-4">Masukkan nomor WhatsApp yang terdaftar dan buat PIN baru. Sistem akan memverifikasi bahwa nomor tersebut terdaftar sebagai Mitra.</p>
                            <div class="space-y-3">
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">smartphone</span>
                                    <input type="tel" id="forgot-pin-phone" placeholder="No. WhatsApp terdaftar"
                                        class="w-full bg-white border-2 border-slate-200 rounded-xl pl-10 pr-4 py-3 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                                </div>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">lock</span>
                                    <input type="password" id="forgot-pin-new" placeholder="PIN baru (4–6 digit angka)" maxlength="6"
                                        class="w-full bg-white border-2 border-slate-200 rounded-xl pl-10 pr-4 py-3 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                                </div>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">lock_clock</span>
                                    <input type="password" id="forgot-pin-confirm" placeholder="Konfirmasi PIN baru" maxlength="6"
                                        class="w-full bg-white border-2 border-slate-200 rounded-xl pl-10 pr-4 py-3 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                                </div>
                                <button type="button" onclick="doResetPin()" class="w-full bg-gradient-to-r from-emerald-700 to-emerald-600 hover:from-emerald-600 hover:to-emerald-500 text-white font-extrabold py-3 rounded-xl transition-all flex items-center justify-center gap-2 text-sm cursor-pointer shadow-md">
                                    <span class="material-symbols-outlined text-lg">lock_reset</span>
                                    <span>Reset PIN Sekarang</span>
                                </button>
                                <button type="button" onclick="toggleForgotPin()" class="w-full text-xs text-slate-400 hover:text-slate-600 font-semibold py-1.5 cursor-pointer transition-colors">Batal</button>
                            </div>
                        </div>

                    </div>

                    <!-- Tab 2: Register Form -->
                    <div id="auth-signup-view" class="hidden flex-1 flex flex-col">
                        <div class="mb-7">
                            <h3 class="text-2xl font-extrabold text-slate-900">Daftar Mitra Penghimpunan</h3>
                            <p class="text-slate-500 text-sm mt-1.5">Lengkapi data diri untuk mendapatkan Kode Mitra resmi WIZ Babel.</p>
                        </div>

                        <form id="affiliate-register-form" onsubmit="handleAffiliateRegister(event)" class="space-y-4 flex-1">
                            <div>
                                <label class="block text-xs font-extrabold text-slate-600 mb-2 uppercase tracking-widest">Nama Lengkap / Nama Komunitas *</label>
                                <input type="text" id="reg-name" required placeholder="Ahmad Sahal / Majelis Taklim Al-Ikhlas"
                                    class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl px-4 py-4 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-slate-600 mb-2 uppercase tracking-widest">Nomor WhatsApp Aktif *</label>
                                <input type="tel" id="reg-phone" required placeholder="Contoh: 081271718890"
                                    class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl px-4 py-4 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-extrabold text-slate-600 mb-2 uppercase tracking-widest">Nama Bank *</label>
                                    <input type="text" id="reg-bank" required placeholder="BSI / BCA / Mandiri"
                                        class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl px-4 py-4 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                                </div>
                                <div>
                                    <label class="block text-xs font-extrabold text-slate-600 mb-2 uppercase tracking-widest">No. Rekening *</label>
                                    <input type="text" id="reg-acc-no" required placeholder="Nomor Rekening Bank"
                                        class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl px-4 py-4 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-slate-600 mb-2 uppercase tracking-widest">Nama Pemilik Rekening *</label>
                                <input type="text" id="reg-acc-holder" required placeholder="Sesuai nama di buku tabungan"
                                    class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl px-4 py-4 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-slate-600 mb-2 uppercase tracking-widest">Buat PIN Login (4–6 Digit) *</label>
                                <input type="password" id="reg-pin" required placeholder="Contoh: 123456"
                                    class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl px-4 py-4 text-sm font-semibold text-slate-900 outline-none focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all placeholder:font-normal placeholder:text-slate-400">
                            </div>
                            <button type="submit"
                                class="w-full bg-gradient-to-r from-emerald-700 to-emerald-600 hover:from-emerald-600 hover:to-emerald-500 text-white font-extrabold py-4 rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2.5 cursor-pointer active:scale-[0.99]">
                                <span class="material-symbols-outlined text-xl">check_circle</span>
                                <span>Daftar Sebagai Mitra Sekarang</span>
                            </button>
                        </form>
                    </div>

                </div>
            </div>

        <!-- ======================================================== -->
        <!-- STATE 2: LOGGED-IN MEMBER DASHBOARD VIEW                 -->
        <!-- ======================================================== -->
        <!-- STATE 2: LOGGED-IN MEMBER DASHBOARD VIEW                 -->
        <!-- ======================================================== -->
        <div id="member-state-container" class="space-y-6 hidden w-full">

            <!-- Member Header Card -->
            <div class="bg-gradient-to-r from-emerald-950 via-emerald-900 to-teal-950 text-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 shadow-xl border border-emerald-500/30 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-5 w-full relative overflow-hidden">
                <div class="absolute -top-12 -right-12 w-48 h-48 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-12 -left-12 w-48 h-48 bg-teal-500/20 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10 flex items-center gap-4">
                    <div id="member-avatar" class="w-14 h-14 rounded-2xl bg-white text-emerald-900 font-extrabold text-2xl flex items-center justify-center shadow-lg ring-4 ring-white/10 shrink-0">
                        M
                    </div>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap mb-1">
                            <span id="member-cabang-badge" class="bg-emerald-500/25 border border-emerald-400/40 text-emerald-200 text-[11px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                                Cabang Pangkalpinang
                            </span>
                            <span id="member-status-badge" class="bg-emerald-700/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-md uppercase tracking-wider">
                                Fundraiser Aktif
                            </span>
                            <span id="member-code-badge" class="bg-white/20 text-white font-mono text-xs font-bold px-2.5 py-0.5 rounded-md border border-white/20">
                                WIZ-000
                            </span>
                        </div>
                        <h2 id="member-welcome-title" class="text-xl sm:text-2xl font-black text-white">Selamat Datang, Mitra Kebaikan!</h2>
                        <p class="text-xs text-emerald-200/80 mt-0.5">Jembatan kebaikan ummat Bangka Belitung • WIZ Babel</p>
                    </div>
                </div>

                <!-- Right Header Actions (Link Bar + Period Filter + QR Code + Logout) -->
                <div class="relative z-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 w-full lg:w-auto">
                    <!-- Period Filter Selector -->
                    <div class="flex items-center gap-1.5 bg-emerald-950/40 px-3 py-1.5 rounded-xl border border-white/20 shadow-inner">
                        <span class="material-symbols-outlined text-base text-emerald-300">calendar_month</span>
                        <select id="member-periode-filter" onchange="renderMemberDashboard()" class="bg-transparent text-white font-bold text-xs outline-none cursor-pointer border-none py-0.5 [&>option]:bg-white [&>option]:text-slate-900">
                            <!-- Populated dynamically by generatePeriods() -->
                        </select>
                    </div>

                    <!-- Readonly Link + Copy Button -->
                    <div class="flex items-center gap-1 bg-white/10 backdrop-blur-md p-1 rounded-xl border border-white/20 flex-1 sm:flex-none">
                        <input type="text" id="member-referral-link-input" readonly onclick="this.select()" class="bg-transparent text-white font-mono text-xs px-2 py-1 w-full sm:w-44 outline-none truncate select-all" value="" title="Tautan Donasi Anda">
                        <button onclick="copyFundraisingLink()" type="button" class="bg-white text-emerald-900 hover:bg-emerald-50 px-3 py-1.5 rounded-lg font-bold text-xs flex items-center justify-center gap-1 shadow-xs transition-all cursor-pointer whitespace-nowrap" title="Salin Tautan">
                            <span class="material-symbols-outlined text-sm">content_copy</span>
                            <span>Salin</span>
                        </button>
                    </div>

                    <button onclick="toggleMemberQrModal()" type="button" class="bg-emerald-800/80 hover:bg-emerald-700 text-white border border-emerald-400/30 px-3 py-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1 transition-all cursor-pointer shadow-xs whitespace-nowrap" title="Tampilkan QR Code Donasi">
                        <span class="material-symbols-outlined text-base">qr_code_2</span>
                        <span class="hidden sm:inline">QR Code</span>
                    </button>

                    <button onclick="handleAffiliateLogout()" type="button" class="bg-red-500/20 hover:bg-red-600 text-white border border-red-400/30 px-3 py-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1 transition-all cursor-pointer shadow-xs" title="Keluar dari Akun">
                        <span class="material-symbols-outlined text-base">logout</span>
                    </button>
                </div>
            </div>

            <!-- Member Sub-Navigation Tabs (5 Subtabs) -->
            <div class="w-full bg-white border-b border-slate-200 rounded-2xl shadow-xs overflow-hidden">
                <div class="flex justify-start gap-1 sm:gap-2 overflow-x-auto p-1.5">
                    <button onclick="switchMemberSubTab('subtab-kpi')" id="btn-subtab-kpi" class="member-nav-btn active shrink-0 whitespace-nowrap px-3.5 sm:px-5 py-2.5 sm:py-3 font-bold text-xs sm:text-sm flex items-center gap-1.5 sm:gap-2 transition-all rounded-xl border-b-2 border-primary text-primary bg-primary/5 cursor-pointer">
                        <span class="material-symbols-outlined text-base sm:text-lg">analytics</span>
                        <span>Penghimpunan &amp; KPI</span>
                    </button>
                    <button onclick="switchMemberSubTab('subtab-news')" id="btn-subtab-news" class="member-nav-btn shrink-0 whitespace-nowrap px-3.5 sm:px-5 py-2.5 sm:py-3 font-bold text-xs sm:text-sm flex items-center gap-1.5 sm:gap-2 transition-all rounded-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 cursor-pointer">
                        <span class="material-symbols-outlined text-base sm:text-lg">feed</span>
                        <span>Kabar Berita &amp; Kegiatan</span>
                    </button>
                    <button onclick="switchMemberSubTab('subtab-catalog')" id="btn-subtab-catalog" class="member-nav-btn shrink-0 whitespace-nowrap px-3.5 sm:px-5 py-2.5 sm:py-3 font-bold text-xs sm:text-sm flex items-center gap-1.5 sm:gap-2 transition-all rounded-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 cursor-pointer">
                        <span class="material-symbols-outlined text-base sm:text-lg">grid_view</span>
                        <span>Program &amp; Link</span>
                    </button>
                    <button onclick="switchMemberSubTab('subtab-quotes')" id="btn-subtab-quotes" class="member-nav-btn shrink-0 whitespace-nowrap px-3.5 sm:px-5 py-2.5 sm:py-3 font-bold text-xs sm:text-sm flex items-center gap-1.5 sm:gap-2 transition-all rounded-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 cursor-pointer">
                        <span class="material-symbols-outlined text-base sm:text-lg">format_quote</span>
                        <span>Quotes &amp; Flyer</span>
                    </button>
                    <button onclick="switchMemberSubTab('subtab-profile')" id="btn-subtab-profile" class="member-nav-btn shrink-0 whitespace-nowrap px-3.5 sm:px-5 py-2.5 sm:py-3 font-bold text-xs sm:text-sm flex items-center gap-1.5 sm:gap-2 transition-all rounded-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 cursor-pointer">
                        <span class="material-symbols-outlined text-base sm:text-lg">settings</span>
                        <span>Pengaturan Rekening</span>
                    </button>
                </div>
            </div>

            <!-- SUBTAB 1: Performance Dashboard & KPI -->
            <div id="subtab-kpi" class="member-subtab space-y-6 sm:space-y-8 w-full">
                <!-- 4 Dashboard Metric Cards (Dynamic Reactivity with Period Dropdown) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 w-full">
                    <!-- Card 1: Total Donasi Dibawa -->
                    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] text-slate-500 font-bold uppercase tracking-wider">Donasi Dihimpun</span>
                            <span id="kpi-tier-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">Mitra Aktif</span>
                        </div>
                        <div>
                            <span id="kpi-total-amount" class="text-2xl sm:text-3xl font-black text-slate-900 block">Rp 0</span>
                            <p class="text-xs font-semibold text-emerald-700 mt-1" id="kpi-fix-fee-info">Hak Fix (6%): Rp 0</p>
                        </div>
                        <p class="text-[11px] text-slate-400 font-medium border-t border-slate-100 pt-1.5" id="kpi-donation-count-info">0 transaksi donasi</p>
                    </div>

                    <!-- Card 2: Akumulasi Poin KPI -->
                    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] text-slate-500 font-bold uppercase tracking-wider">Poin KPI Anda</span>
                            <span class="material-symbols-outlined text-blue-600 text-lg">workspace_premium</span>
                        </div>
                        <div>
                            <span id="kpi-total-points" class="text-2xl sm:text-3xl font-black text-blue-600 block">0 Pts</span>
                            <p class="text-xs font-semibold text-blue-800 mt-1 truncate" id="kpi-points-breakdown">Belum ada catatan aktivitas</p>
                        </div>
                        <p class="text-[11px] text-slate-400 font-medium border-t border-slate-100 pt-1.5" id="kpi-pool-share-info">0% dari Poin Global</p>
                    </div>

