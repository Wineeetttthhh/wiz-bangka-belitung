        function toggleForgotPin() {
            const panel = document.getElementById('forgot-pin-panel');
            if (!panel) return;
            panel.classList.toggle('hidden');
            if (!panel.classList.contains('hidden')) {
                // Isi otomatis dari field identifier jika ada
                const identifier = document.getElementById('login-identifier');
                const phoneInput = document.getElementById('forgot-pin-phone');
                if (identifier && phoneInput && identifier.value.trim()) {
                    const val = identifier.value.trim();
                    // Hanya isi jika berupa nomor HP (bukan kode mitra)
                    if (/^\d/.test(val)) phoneInput.value = val;
                }
                const phoneInput2 = document.getElementById('forgot-pin-phone');
                if (phoneInput2) phoneInput2.focus();
            }
        }

        function sendForgotPinWA() {
            // Deprecated - kept for compatibility, redirects to doResetPin
            doResetPin();
        }

        async function doResetPin() {
            const phoneInput = document.getElementById('forgot-pin-phone');
            const newPinInput = document.getElementById('forgot-pin-new');
            const confirmInput = document.getElementById('forgot-pin-confirm');

            const phone = phoneInput ? phoneInput.value.trim() : '';
            const newPin = newPinInput ? newPinInput.value.trim() : '';
            const confirmPin = confirmInput ? confirmInput.value.trim() : '';

            // Validasi input
            if (!phone || phone.length < 8) {
                alert('Mohon masukkan nomor WhatsApp yang terdaftar.');
                if (phoneInput) phoneInput.focus();
                return;
            }
            if (!newPin || newPin.length < 4) {
                alert('PIN baru harus minimal 4 digit angka.');
                if (newPinInput) newPinInput.focus();
                return;
            }
            if (!/^\d+$/.test(newPin)) {
                alert('PIN hanya boleh berisi angka.');
                if (newPinInput) newPinInput.focus();
                return;
            }
            if (newPin !== confirmPin) {
                alert('Konfirmasi PIN tidak cocok. Pastikan keduanya sama.');
                if (confirmInput) confirmInput.focus();
                return;
            }

            // Normalisasi nomor: hapus +, spasi, leading 0 → simpan sebagai 08xxx
            let normalizedPhone = phone.replace(/\D/g, '');
            if (normalizedPhone.startsWith('62')) normalizedPhone = '0' + normalizedPhone.substring(2);
            if (!normalizedPhone.startsWith('0')) normalizedPhone = '0' + normalizedPhone;

            try {
                const resetBtn = document.querySelector('#forgot-pin-panel button[onclick="doResetPin()"]');
                if (resetBtn) { resetBtn.disabled = true; resetBtn.textContent = 'Memverifikasi...'; }

                // Cari mitra berdasarkan nomor WA di wizStore
                const allAffiliates = await window.wizStore.affiliates.list();
                const mitra = allAffiliates.find(a => {
                    let ap = (a.phone || '').replace(/\D/g, '');
                    if (ap.startsWith('62')) ap = '0' + ap.substring(2);
                    if (!ap.startsWith('0')) ap = '0' + ap;
                    return ap === normalizedPhone;
                });

                if (!mitra) {
                    alert('Nomor WhatsApp ' + phone + ' tidak ditemukan sebagai Mitra terdaftar.\n\nPastikan nomor yang Anda masukkan sama persis dengan saat pendaftaran.');
                    if (resetBtn) { resetBtn.disabled = false; resetBtn.innerHTML = '<span class="material-symbols-outlined text-lg">lock_reset</span><span>Reset PIN Sekarang</span>'; }
                    return;
                }

                // Update PIN via wizStore
                await window.wizStore.affiliates.update(mitra.id, { password: newPin, pin: newPin });

                // Tutup panel dan reset form
                document.getElementById('forgot-pin-panel').classList.add('hidden');
                if (phoneInput) phoneInput.value = '';
                if (newPinInput) newPinInput.value = '';
                if (confirmInput) confirmInput.value = '';

                // Isi field login dengan nomor WA
                const loginId = document.getElementById('login-identifier');
                if (loginId) loginId.value = phone;

                alert('✅ PIN berhasil direset!\n\nSilakan masuk menggunakan PIN baru Anda.');

            } catch (err) {
                console.error('[WIZ] Reset PIN error:', err);
                alert('Terjadi kesalahan saat mereset PIN. Coba lagi atau hubungi admin WIZ.\n\nError: ' + (err.message || err));
                const resetBtn = document.querySelector('#forgot-pin-panel button[onclick="doResetPin()"]');
                if (resetBtn) { resetBtn.disabled = false; resetBtn.innerHTML = '<span class="material-symbols-outlined text-lg">lock_reset</span><span>Reset PIN Sekarang</span>'; }
            }
        }

        function activateMemberState(ref) {
            document.getElementById('auth-state-container').classList.add('hidden');
            document.getElementById('member-state-container').classList.remove('hidden');

            const initial = (ref.name || 'A').charAt(0).toUpperCase();
            const avatarEl = document.getElementById('member-avatar');
            if (avatarEl) avatarEl.textContent = initial;

            const nameEl = document.getElementById('member-welcome-title');
            if (nameEl) nameEl.textContent = `Selamat Datang, ${ref.name}!`;

            const codeEl = document.getElementById('member-code-badge');
            if (codeEl) codeEl.textContent = ref.code || ref.id;

            if (document.getElementById('prof-name')) document.getElementById('prof-name').value = ref.name || '';
            if (document.getElementById('prof-phone')) document.getElementById('prof-phone').value = ref.phone || '';
            if (document.getElementById('prof-bank')) document.getElementById('prof-bank').value = ref.bankName || '';
            if (document.getElementById('prof-acc-no')) document.getElementById('prof-acc-no').value = ref.accountNumber || '';
            if (document.getElementById('prof-acc-holder')) document.getElementById('prof-acc-holder').value = ref.accountHolder || '';

            switchMemberSubTab('subtab-kpi');
        }

        function deactivateMemberState() {
            document.getElementById('auth-state-container').classList.remove('hidden');
            document.getElementById('member-state-container').classList.add('hidden');
            currentLoggedAffiliate = null;
        }

        function switchMemberSubTab(subtabId) {
            currentActiveSubTab = subtabId;
            document.querySelectorAll('.member-subtab').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.member-nav-btn').forEach(el => {
                el.classList.remove('border-primary', 'text-primary', 'bg-primary/5');
                el.classList.add('border-transparent', 'text-slate-600');
            });

            const target = document.getElementById(subtabId);
            if (target) target.classList.remove('hidden');

            const btn = document.getElementById('btn-' + subtabId);
            if (btn) {
                btn.classList.add('border-primary', 'text-primary', 'bg-primary/5');
                btn.classList.remove('border-transparent', 'text-slate-600');
            }

            if (subtabId === 'subtab-kpi') {
                renderMemberDashboard();
            } else if (subtabId === 'subtab-news') {
                renderAffiliateNewsGrid();
            } else if (subtabId === 'subtab-catalog') {
                renderAffiliateProgramsGrid();
            } else if (subtabId === 'subtab-quotes') {
                renderAffiliateQuotesGrid();
            }
        }

        async function handleAffiliateLogin(e) {
            e.preventDefault();
            const identifier = (document.getElementById('login-identifier').value || '').trim();
            const pin = (document.getElementById('login-pin').value || '').trim();

            if (!identifier) {
                alert('Silakan masukkan No. WhatsApp atau Kode Mitra Anda.');
                return;
            }

            const TEST_MITRA_LIST = [
                {
                    id: 'ref-test-01',
                    code: 'WIZ-TEST-001',
                    name: 'Mitra Test WIZ',
                    phone: '081234567890',
                    bankName: 'BSI (Bank Syariah Indonesia)',
                    accountNumber: '7168008001',
                    accountHolder: 'Mitra Test WIZ Babel',
                    pin: '123456',
                    defaultRate: 6,
                    status: 'approved',
                    totalDonationAmount: 0,
                    donationsCount: 0,
                    totalEarned: 0,
                    pendingBalance: 0
                },
                {
                    id: 'ref-relawan-01',
                    code: 'WIZ-20260828-001',
                    name: 'Relawan Mitra Kebaikan',
                    phone: '082180808080',
                    bankName: 'BSI',
                    accountNumber: '7112233445',
                    accountHolder: 'Relawan Mitra Kebaikan',
                    pin: '1234',
                    defaultRate: 6,
                    status: 'approved',
                    totalDonationAmount: 0,
                    donationsCount: 0,
                    totalEarned: 0,
                    pendingBalance: 0
                }
            ];

            const cleanId = identifier.toLowerCase().replace(/[^a-z0-9]/g, '');
            const testMatch = TEST_MITRA_LIST.find(m => 
                (m.code && m.code.toLowerCase().replace(/[^a-z0-9]/g, '') === cleanId) ||
                (m.phone && m.phone.replace(/[^0-9]/g, '') === identifier.replace(/[^0-9]/g, ''))
            );

            if (testMatch) {
                if (pin && testMatch.pin && pin !== testMatch.pin) {
                    alert('⚠️ PIN yang Anda masukkan salah. Gunakan PIN: ' + testMatch.pin);
                    return;
                }
                currentLoggedAffiliate = testMatch;
                sessionStorage.setItem('wiz_logged_affiliate', JSON.stringify(testMatch));
                localStorage.setItem('wiz_logged_affiliate', JSON.stringify(testMatch));
                activateMemberState(testMatch);
                return;
            }

            if (window.wizStore && window.wizStore.referrals) {
                try {
                    const res = await window.wizStore.referrals.login({ identifier, pin });
                    if (res.success) {
                        currentLoggedAffiliate = res.referral;
                        sessionStorage.setItem('wiz_logged_affiliate', JSON.stringify(res.referral));
                        localStorage.setItem('wiz_logged_affiliate', JSON.stringify(res.referral));
                        activateMemberState(res.referral);
                        return;
                    } else {
                        alert(`⚠️ ${res.message}`);
                        return;
                    }
                } catch(err) {
                    console.warn('Login error:', err);
                }
            }

            try {
                const storedRefs = JSON.parse(localStorage.getItem('wiz_referrals') || '[]');
                const found = storedRefs.find(r => 
                    (r.code && r.code.toLowerCase() === identifier.toLowerCase()) || 
                    (r.phone && r.phone.replace(/\D/g,'') === identifier.replace(/\D/g,''))
                );
                if (found) {
                    const actualPin = found.pin || (found.phone ? found.phone.slice(-4) : '1234');
                    if (pin && pin !== actualPin) {
                        alert('⚠️ PIN yang Anda masukkan salah.');
                        return;
                    }
                    currentLoggedAffiliate = found;
                    sessionStorage.setItem('wiz_logged_affiliate', JSON.stringify(found));
                    localStorage.setItem('wiz_logged_affiliate', JSON.stringify(found));
                    activateMemberState(found);
                    return;
                }
            } catch(e) {}

            alert('⚠️ Akun Mitra tidak ditemukan. Silakan periksa No. WA / Kode Mitra Anda atau lakukan pendaftaran Mitra baru.');
        }

        async function handleAffiliateRegister(e) {
            e.preventDefault();
            const name = document.getElementById('reg-name').value.trim();
            const phone = document.getElementById('reg-phone').value.trim();
            const bankName = document.getElementById('reg-bank').value.trim();
            const accountNumber = document.getElementById('reg-acc-no').value.trim();
            const accountHolder = document.getElementById('reg-acc-holder').value.trim();
            const pin = document.getElementById('reg-pin').value.trim();

            if (window.wizStore && window.wizStore.referrals) {
                const res = await window.wizStore.referrals.registerPublic({ name, phone, bankName, accountNumber, accountHolder, pin });
                if (res.success) {
                    currentLoggedAffiliate = res.referral;
                    sessionStorage.setItem('wiz_logged_affiliate', JSON.stringify(res.referral));
                    localStorage.setItem('wiz_logged_affiliate', JSON.stringify(res.referral));
                    alert(`✅ Pendaftaran berhasil! Kode Mitra Anda: ${res.referral.code || res.referral.id}`);
                    activateMemberState(res.referral);
                } else {
                    alert(`⚠️ ${res.message}`);
                }
            }
        }

        function handleAffiliateLogout() {
            sessionStorage.removeItem('wiz_logged_affiliate');
            localStorage.removeItem('wiz_logged_affiliate');
            deactivateMemberState();
            alert('Anda telah keluar dari Portal Member Mitra Penghimpunan.');
        }

        function renderMemberDashboard() {
            if (!currentLoggedAffiliate) return;
            const refId = currentLoggedAffiliate.id || currentLoggedAffiliate.code;
            const fullRef = (window.wizStore && window.wizStore.referrals) ? (window.wizStore.referrals.getById(refId) || currentLoggedAffiliate) : currentLoggedAffiliate;

            const kpiCount = document.getElementById('kpi-total-count');
            const kpiAmt = document.getElementById('kpi-total-amount');
            const kpiEarned = document.getElementById('kpi-total-earned');
            const kpiPending = document.getElementById('kpi-pending-balance');

            if (kpiCount) kpiCount.textContent = fullRef.donationsCount || 0;
            if (kpiAmt) kpiAmt.textContent = `Rp ${(fullRef.totalDonationAmount || 0).toLocaleString('id-ID')}`;
            if (kpiEarned) kpiEarned.textContent = `Rp ${(fullRef.totalEarned || 0).toLocaleString('id-ID')}`;
            if (kpiPending) kpiPending.textContent = `Rp ${(fullRef.pendingBalance || 0).toLocaleString('id-ID')}`;

            const tbody = document.getElementById('member-donations-tbody');
            if (tbody) {
                const donList = (window.wizStore && window.wizStore.donations) ? window.wizStore.donations.getByReferral(refId) : [];
                if (donList.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-slate-400">Belum ada transaksi donasi melalui link Anda. Bagikan program dan berita untuk mulai menghimpun kebaikan!</td></tr>';
                } else {
                    tbody.innerHTML = donList.map(d => `
                        <tr class="border-b border-slate-100 hover:bg-slate-50">
                            <td class="p-3">${(d.createdAt || '').split('T')[0]}</td>
                            <td class="p-3 font-semibold">${d.donorName || 'Hamba Allah'}</td>
                            <td class="p-3">${d.program || d.program_title || 'Umum'}</td>
                            <td class="p-3 font-bold text-primary">Rp ${(Number(d.amount)||0).toLocaleString('id-ID')}</td>
                            <td class="p-3 font-bold text-emerald-800">Rp ${Math.round((Number(d.amount)||0) * 0.06).toLocaleString('id-ID')}</td>
                            <td class="p-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Terverifikasi</span></td>
                        </tr>
                    `).join('');
                }
            }
        }

        function renderAffiliateNewsGrid() {
            if (!window.wizStore || !window.wizStore.news) return;
            const published = window.wizStore.news.getPublished();
            const activeRef = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';

            const featuredCard = document.getElementById('affiliate-featured-news');
            const grid = document.getElementById('affiliate-news-grid');
            if (!published || published.length === 0) {
                if (featuredCard) featuredCard.style.display = 'none';
                if (grid) grid.innerHTML = '<div class="col-span-2 p-6 text-center text-slate-400">Belum ada berita yang dipublikasikan.</div>';
                return;
            }

            const latest = published[0];
            const defaultImg = '/assets/images/default-program-wiz.png';

            const fImg = document.getElementById('aff-featured-news-img');
            const fCat = document.getElementById('aff-featured-news-category');
            const fDate = document.getElementById('aff-featured-news-date');
            const fTitle = document.getElementById('aff-featured-news-title');
            const fExcerpt = document.getElementById('aff-featured-news-excerpt');
            const fWaBtn = document.getElementById('aff-featured-share-wa-btn');
            const fCopyBtn = document.getElementById('aff-featured-copy-btn');
            const fViewBtn = document.getElementById('aff-featured-view-btn');

            if (fImg) { fImg.src = latest.imageUrl || defaultImg; fImg.onerror = () => { fImg.src = defaultImg; }; }
            if (fCat) fCat.textContent = latest.category || 'Kegiatan & Penyaluran';
            if (fDate) fDate.textContent = (latest.eventDate || latest.createdAt || '').split('T')[0];
            if (fTitle) fTitle.textContent = latest.title;
            if (fExcerpt) fExcerpt.textContent = (latest.content || '').slice(0, 160).replace(/\r?\n/g, ' ') + '...';

            if (fWaBtn) fWaBtn.onclick = () => shareAffiliateNewsWA(latest.id);
            if (fCopyBtn) fCopyBtn.onclick = () => copyAffiliateNewsLink(latest.id);
            if (fViewBtn) fViewBtn.href = `/berita/${encodeURIComponent(latest.id)}?ref=${encodeURIComponent(activeRef)}`;

            if (grid) {
                grid.innerHTML = published.map(n => {
                    const rawExcerpt = (n.content || '').slice(0, 120).replace(/\r?\n/g, ' ') + '...';
                    const img = n.imageUrl || defaultImg;
                    const dateStr = (n.eventDate || n.createdAt || '').split('T')[0];
                    return `
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs hover:shadow-md transition-shadow flex items-start gap-4">
                        <img src="${img}" class="w-24 h-24 rounded-xl object-cover border border-slate-200 shrink-0 bg-slate-100" onerror="this.src='${defaultImg}'" alt="${n.title}">
                        <div class="flex-1 space-y-1.5 min-w-0">
                            <div class="flex items-center justify-between gap-1">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 truncate">${n.category || 'Kegiatan'}</span>
                                <span class="text-[10px] text-slate-400 font-mono shrink-0">${dateStr}</span>
                            </div>
                            <h4 class="text-xs font-bold text-slate-900 line-clamp-2 leading-snug">${n.title}</h4>
                            <p class="text-[11px] text-slate-500 line-clamp-1">${rawExcerpt}</p>
                            <div class="pt-1 flex items-center gap-1.5">
                                <button type="button" onclick="shareAffiliateNewsWA('${n.id}')" class="flex-1 bg-[#25D366] hover:bg-[#1ebd5a] text-white font-bold text-xs py-1.5 px-2 rounded-lg flex items-center justify-center gap-1 shadow-xs transition-colors cursor-pointer" title="Bagikan ke WhatsApp">
                                    <span class="material-symbols-outlined text-sm">send</span>
                                    <span>Share WA</span>
                                </button>
                                <button type="button" onclick="copyAffiliateNewsLink('${n.id}')" class="p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold text-xs flex items-center justify-center transition-colors cursor-pointer" title="Salin Link">
                                    <span class="material-symbols-outlined text-[15px]">content_copy</span>
                                </button>
                                <a href="/berita/${encodeURIComponent(n.id)}?ref=${encodeURIComponent(activeRef)}" target="_blank" class="p-1.5 bg-primary/10 hover:bg-primary/20 text-primary rounded-lg font-bold text-xs flex items-center justify-center transition-colors" title="Buka Halaman Berita">
                                    <span class="material-symbols-outlined text-[15px]">open_in_new</span>
                                </a>
                            </div>
                        </div>
                    </div>`;
                }).join('');
            }
        }

        function shareAffiliateNewsWA(newsId) {
            const refCode = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
            const n = (window.wizStore && window.wizStore.news) ? window.wizStore.news.getById(newsId) : null;
            if (!n) return;

            const origin = 'https://www.wizbangkabelitung.or.id';
            const newsUrlObj = new URL(`${origin}/berita/${encodeURIComponent(n.id)}`);
            if (refCode) newsUrlObj.searchParams.set('ref', refCode);
            const newsUrl = newsUrlObj.toString();

            window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(newsUrl), '_blank');
        }

        function copyAffiliateNewsLink(newsId) {
            const refCode = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
            const origin = 'https://www.wizbangkabelitung.or.id';
            const newsUrlObj = new URL(`${origin}/berita/${encodeURIComponent(newsId)}`);
            if (refCode) newsUrlObj.searchParams.set('ref', refCode);
            const newsUrl = newsUrlObj.toString();

            navigator.clipboard.writeText(newsUrl).then(() => {
                alert(`✅ Link Berita dengan Kode Mitra (${refCode}) berhasil disalin:\n\n${newsUrl}`);
            });
        }

        function renderAffiliateProgramsGrid() {
            const grid = document.getElementById('affiliate-programs-grid');
            if (!grid) return;

            const progs = (window.wizStore && window.wizStore.programs) ? window.wizStore.programs.getPublished() : [];
            const activeRef = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';

            if (progs.length === 0) {
                grid.innerHTML = '<div class="col-span-3 p-6 text-center text-slate-400">Belum ada program yang aktif.</div>';
                return;
            }

            grid.innerHTML = progs.map(p => {
                const slug = p.slug || (p.title ? p.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : 'program');
                const progUrl = `https://www.wizbangkabelitung.or.id/program/${slug}?ref=${encodeURIComponent(activeRef)}`;
                const dynamicImg = (window.wizStore.allocationRulesManager && typeof window.wizStore.allocationRulesManager.getSpecificProgramImage === 'function')
                    ? window.wizStore.allocationRulesManager.getSpecificProgramImage(p.title, p.pillar)
                    : (p.imageUrl || '/assets/images/default-program-wiz.png');

                return `
                <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-xs hover:shadow-md transition-shadow flex flex-col">
                    <div class="aspect-video relative overflow-hidden bg-slate-100">
                        <img src="${dynamicImg}" class="w-full h-full object-cover" alt="${p.title}" onerror="this.src='/assets/images/default-program-wiz.png'">
                        <span class="absolute top-2 left-2 bg-primary text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full">${p.pillar || 'Kebaikan'}</span>
                    </div>
                    <div class="p-4 flex flex-col flex-grow space-y-2">
                        <h4 class="text-sm font-bold text-slate-900 line-clamp-1">${p.title}</h4>
                        <p class="text-xs text-slate-500 line-clamp-2">${p.description || ''}</p>
                        <div class="pt-3 mt-auto flex items-center gap-2">
                            <button type="button" onclick="copyProgramShareLink('${progUrl}')" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs py-2 rounded-xl flex items-center justify-center gap-1 transition-colors cursor-pointer">
                                <span>Salin Link</span>
                            </button>
                            <button type="button" onclick="shareProgramWA('${p.title}', '${progUrl}')" class="bg-[#25D366] hover:bg-[#1ebd5a] text-white p-2 rounded-xl flex items-center justify-center transition-colors cursor-pointer" title="Share WhatsApp">
                                <span class="material-symbols-outlined text-base">send</span>
                            </button>
                        </div>
                    </div>
                </div>`;
            }).join('');
        }

        function copyProgramShareLink(url) {
            navigator.clipboard.writeText(url).then(() => {
                alert(`✅ Link Program berhasil disalin:\n\n${url}\n\nSetiap donasi dari link ini otomatis tersambung ke hak insentif 6% Anda.`);
            });
        }

        function shareProgramWA(title, url) {
            window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(url), '_blank');
        }

        function renderAffiliateQuotesGrid() {
            const grid = document.getElementById('affiliate-quotes-grid');
            if (!grid) return;
            grid.innerHTML = '<div class="col-span-3 p-6 text-center text-slate-400">Koleksi flyer dakwah siap dibagikan oleh mitra.</div>';
        }

        function copyFundraisingLink() {
            const activeRef = (currentLoggedAffiliate ? (currentLoggedAffiliate.code || currentLoggedAffiliate.id) : '') || 'WIZ';
            const url = `https://www.wizbangkabelitung.or.id/?ref=${encodeURIComponent(activeRef)}`;
            navigator.clipboard.writeText(url).then(() => {
                alert(`✅ Link Website Utama dengan Kode Mitra (${activeRef}) berhasil disalin:\n\n${url}\n\nDonasi apa pun dari link ini otomatis tercatat atas nama Anda.`);
            });
        }

        async function handleUpdateProfile(e) {
            e.preventDefault();
            if (!currentLoggedAffiliate) return;

            const name = document.getElementById('prof-name').value.trim();
            const bankName = document.getElementById('prof-bank').value.trim();
            const accountNumber = document.getElementById('prof-acc-no').value.trim();
            const accountHolder = document.getElementById('prof-acc-holder').value.trim();
            const pin = document.getElementById('prof-pin').value.trim();

            const updated = {
                ...currentLoggedAffiliate,
                name: name || currentLoggedAffiliate.name,
                bankName: bankName || currentLoggedAffiliate.bankName,
                accountNumber: accountNumber || currentLoggedAffiliate.accountNumber,
                accountHolder: accountHolder || currentLoggedAffiliate.accountHolder
            };
            if (pin) updated.pin = pin;

            if (window.wizStore && window.wizStore.referrals) {
                await window.wizStore.referrals.update(currentLoggedAffiliate.id, updated);
            }
            currentLoggedAffiliate = updated;
            sessionStorage.setItem('wiz_logged_affiliate', JSON.stringify(updated));
            localStorage.setItem('wiz_logged_affiliate', JSON.stringify(updated));
            alert('✅ Perubahan profil dan data rekening berhasil disimpan!');
        }

        document.addEventListener('DOMContentLoaded', () => {
            try {
                const saved = sessionStorage.getItem('wiz_logged_affiliate') || localStorage.getItem('wiz_logged_affiliate');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if (parsed && (parsed.id || parsed.code)) {
                        currentLoggedAffiliate = parsed;
                        activateMemberState(parsed);
                    }
                }
            } catch(e) {}
        });
    </script>
</MitraLayout>
