    <!-- Interactive Script for Portal Mitra -->
    <script is:inline>
        let currentLoggedAffiliate = null;
        let currentActiveSubTab = 'subtab-kpi';

        function toggleAuthTab(tab) {
            const signinView = document.getElementById('auth-signin-view');
            const signupView = document.getElementById('auth-signup-view');
            const btnSignin = document.getElementById('btn-auth-signin');
            const btnSignup = document.getElementById('btn-auth-signup');

            if (tab === 'signin') {
                signinView.classList.remove('hidden');
                signupView.classList.add('hidden');
                btnSignin.className = 'flex-1 py-3 text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-emerald-700 text-white shadow-md cursor-pointer';
                btnSignup.className = 'flex-1 py-3 text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 text-slate-500 hover:text-slate-800 hover:bg-white/80 cursor-pointer';
                // Tutup panel lupa PIN saat ganti tab
                const panel = document.getElementById('forgot-pin-panel');
                if (panel) panel.classList.add('hidden');
            } else {
                signupView.classList.remove('hidden');
                signinView.classList.add('hidden');
                btnSignup.className = 'flex-1 py-3 text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 bg-emerald-700 text-white shadow-md cursor-pointer';
                btnSignin.className = 'flex-1 py-3 text-sm font-bold rounded-xl transition-all flex items-center justify-center gap-2 text-slate-500 hover:text-slate-800 hover:bg-white/80 cursor-pointer';
            }
        }

        function toggleForgotPin() {
            const panel = document.getElementById('forgot-pin-panel');
            if (!panel) return;
            panel.classList.toggle('hidden');
            if (!panel.classList.contains('hidden')) {
                // Isi otomatis dari field identifier jika ada
                const identifier = document.getElementById('login-identifier');
                const phoneInput = document.getElementById('forgot-pin-phone');
                if (identifier && phoneInput && identifier.value.trim()) {
                    const val = identifier.value.trim();
                    // Hanya isi jika berupa nomor HP (bukan kode mitra)
                    if (/^\d/.test(val)) phoneInput.value = val;
                }
                const phoneInput2 = document.getElementById('forgot-pin-phone');
                if (phoneInput2) phoneInput2.focus();
            }
        }

        function sendForgotPinWA() {
            // Deprecated - kept for compatibility, redirects to doResetPin
            doResetPin();
        }

        async function doResetPin() {
            const phoneInput = document.getElementById('forgot-pin-phone');
            const newPinInput = document.getElementById('forgot-pin-new');
            const confirmInput = document.getElementById('forgot-pin-confirm');

            const phone = phoneInput ? phoneInput.value.trim() : '';
            const newPin = newPinInput ? newPinInput.value.trim() : '';
            const confirmPin = confirmInput ? confirmInput.value.trim() : '';

            // Validasi input
            if (!phone || phone.length < 8) {
                alert('Mohon masukkan nomor WhatsApp yang terdaftar.');
                if (phoneInput) phoneInput.focus();
                return;
            }
            if (!newPin || newPin.length < 4) {
                alert('PIN baru harus minimal 4 digit angka.');
                if (newPinInput) newPinInput.focus();
                return;
            }
            if (!/^\d+$/.test(newPin)) {
                alert('PIN hanya boleh berisi angka.');
                if (newPinInput) newPinInput.focus();
                return;
            }
            if (newPin !== confirmPin) {
                alert('Konfirmasi PIN tidak cocok. Pastikan keduanya sama.');
                if (confirmInput) confirmInput.focus();
                return;
            }

            // Normalisasi nomor: hapus +, spasi, leading 0 → simpan sebagai 08xxx
            let normalizedPhone = phone.replace(/\D/g, '');
            if (normalizedPhone.startsWith('62')) normalizedPhone = '0' + normalizedPhone.substring(2);
            if (!normalizedPhone.startsWith('0')) normalizedPhone = '0' + normalizedPhone;

            try {
                const resetBtn = document.querySelector('#forgot-pin-panel button[onclick="doResetPin()"]');
                if (resetBtn) { resetBtn.disabled = true; resetBtn.textContent = 'Memverifikasi...'; }

                // Cari mitra berdasarkan nomor WA di wizStore
                const allAffiliates = await window.wizStore.affiliates.list();
                const mitra = allAffiliates.find(a => {
                    let ap = (a.phone || '').replace(/\D/g, '');
                    if (ap.startsWith('62')) ap = '0' + ap.substring(2);
                    if (!ap.startsWith('0')) ap = '0' + ap;
                    return ap === normalizedPhone;
                });

                if (!mitra) {
                    alert('Nomor WhatsApp ' + phone + ' tidak ditemukan sebagai Mitra terdaftar.\n\nPastikan nomor yang Anda masukkan sama persis dengan saat pendaftaran.');
                    if (resetBtn) { resetBtn.disabled = false; resetBtn.innerHTML = '<span class="material-symbols-outlined text-lg">lock_reset</span><span>Reset PIN Sekarang</span>'; }
                    return;
                }

                // Update PIN via wizStore
                await window.wizStore.affiliates.update(mitra.id, { password: newPin, pin: newPin });

                // Tutup panel dan reset form
                document.getElementById('forgot-pin-panel').classList.add('hidden');
                if (phoneInput) phoneInput.value = '';
                if (newPinInput) newPinInput.value = '';
                if (confirmInput) confirmInput.value = '';

                // Isi field login dengan nomor WA
                const loginId = document.getElementById('login-identifier');
                if (loginId) loginId.value = phone;

                alert('✅ PIN berhasil direset!\n\nSilakan masuk menggunakan PIN baru Anda.');

            } catch (err) {
                console.error('[WIZ] Reset PIN error:', err);
                alert('Terjadi kesalahan saat mereset PIN. Coba lagi atau hubungi admin WIZ.\n\nError: ' + (err.message || err));
                const resetBtn = document.querySelector('#forgot-pin-panel button[onclick="doResetPin()"]');
                if (resetBtn) { resetBtn.disabled = false; resetBtn.innerHTML = '<span class="material-symbols-outlined text-lg">lock_reset</span><span>Reset PIN Sekarang</span>'; }
            }
        }

        function populateMemberPeriodFilter() {
            const sel = document.getElementById('member-periode-filter');
            if (!sel) return;
            const currentVal = sel.value;
            const periods = (typeof generatePeriods === 'function') 
                ? generatePeriods(12) 
                : (window.wizStore && typeof window.wizStore.utils?.generatePeriods === 'function' ? window.wizStore.utils.generatePeriods(12) : []);
            
            const curMonth = (typeof getCurrentPeriod === 'function')
                ? getCurrentPeriod()
                : (window.wizStore && typeof window.wizStore.utils?.getCurrentPeriod === 'function' ? window.wizStore.utils.getCurrentPeriod() : new Date().toISOString().slice(0, 7));

            let html = `<option value="ALL" class="text-slate-900 bg-white" style="color:#0f172a;background-color:#ffffff;">Semua Periode</option>`;
            periods.forEach(p => {
                html += `<option value="${p.value}" class="text-slate-900 bg-white" style="color:#0f172a;background-color:#ffffff;" ${p.value === curMonth ? 'selected' : ''}>${p.label} ${p.isCurrent ? '(Bulan Ini)' : ''}</option>`;
            });
            sel.innerHTML = html;
            if (currentVal && Array.from(sel.options).some(o => o.value === currentVal)) {
                sel.value = currentVal;
            }
        }

        function toggleMemberQrModal() {
            const modal = document.getElementById('member-qr-modal');
            if (!modal) return;
            const isHidden = modal.classList.contains('hidden');
            if (isHidden) {
                if (!currentLoggedAffiliate) return;
                const mitra = currentLoggedAffiliate;
                const activeRefCode = mitra.code || mitra.id || 'WIZ';
