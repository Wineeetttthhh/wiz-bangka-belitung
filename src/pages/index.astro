---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="WIZ Bangka Belitung - Tebarkan Kebaikan"
    description="Wahdah Inspirasi Zakat (WIZ) Bangka Belitung - Lembaga Amil Zakat Terpercaya. Melayani Zakat, Infak, Sedekah & Wakaf untuk pemberdayaan umat di Bangka Belitung."
    image="/assets/images/foto-utama-wiz.jpg"
>
    <!-- Hero Section -->
    <section class="relative pt-6 sm:pt-12 pb-10 sm:pb-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
            <div class="lg:col-span-7 space-y-4 sm:space-y-6 z-10">
                <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-emerald-950 leading-[1.2] tracking-tight">
                    Tebarkan Kebaikan, <br class="hidden sm:inline" />
                    <span class="text-emerald-700">Hadirkan Kebermanfaatan</span>
                </h1>
                <p class="text-sm sm:text-base md:text-lg text-slate-700 leading-relaxed font-normal max-w-2xl">
                    Bersama Wahdah Inspirasi Zakat Bangka Belitung, wujudkan kepedulian melalui Zakat, Infak, dan Sedekah untuk membangun masyarakat yang lebih berdaya dan mandiri.
                </p>
                <div class="grid grid-cols-2 sm:flex sm:flex-row gap-3 pt-1 w-full sm:w-auto">
                    <a href="/donasi" class="bg-[#F7941D] hover:bg-[#ea7e00] text-white px-4 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl shadow-md shadow-orange-500/20 hover:shadow-orange-500/30 transition-all text-xs sm:text-base font-extrabold flex items-center justify-center gap-1.5 sm:gap-2 active:scale-98">
                        <span class="material-symbols-outlined text-lg sm:text-xl">volunteer_activism</span>
                        <span>Donasi Sekarang</span>
                    </a>
                    <a href="/program" class="bg-white hover:bg-emerald-50 text-emerald-800 border-2 border-emerald-600/80 px-4 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl shadow-xs hover:shadow-md transition-all text-xs sm:text-base font-bold flex items-center justify-center gap-1.5 sm:gap-2 active:scale-98">
                        <span class="material-symbols-outlined text-lg sm:text-xl">grid_view</span>
                        <span>Lihat Program</span>
                    </a>
                </div>
            </div>
            <div class="lg:col-span-5 relative aspect-[16/10] sm:aspect-[16/10] lg:aspect-auto lg:h-[460px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-xl border-2 border-emerald-100 bg-slate-100">
                <img id="main-hero-img" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" data-site-img="hero_card" data-alt="Relawan WIZ Bangka Belitung" src="/assets/images/foto-utama-wiz.jpg" onerror="this.src='/assets/images/sedekah-beras-dhuafa.jpg';" alt="Relawan WIZ Bangka Belitung Menyerahkan Sedekah Beras"/>
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/25 via-transparent to-transparent pointer-events-none"></div>
            </div>
        </div>
    </section>

    <!-- Section: Tentang Kami, Legalitas, Visi & Misi WIZ -->
    <section id="tentang-kami" class="py-10 sm:py-16 bg-white border-t border-b border-slate-200/80">
        <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
            
            <!-- Section Header -->
            <div class="max-w-3xl space-y-2">
                <span class="inline-flex items-center gap-2 text-emerald-700 font-extrabold text-xs sm:text-sm uppercase tracking-wider bg-emerald-50 px-3.5 py-1 rounded-full border border-emerald-200">
                    <span class="material-symbols-outlined text-base">info</span>
                    Tentang Kami
                </span>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">Wahdah Inspirasi Zakat (WIZ) Bangka Belitung</h2>
                <p class="text-sm sm:text-lg text-slate-600 font-medium">Lembaga Amil Zakat Nasional yang Amanah, Profesional, dan Berkelanjutan.</p>
            </div>

            <!-- Content Grid: Profil Lengkap & Visi Misi -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-start">
                
                <!-- Left Column: Profil & Legalitas Formal (7 Cols) -->
                <div class="lg:col-span-7 bg-slate-50 p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl border border-slate-200/80 shadow-sm space-y-4 sm:space-y-5">
                    <h3 class="text-base sm:text-xl font-black text-emerald-800 flex items-center gap-2">
                        <span class="material-symbols-outlined text-xl sm:text-2xl text-emerald-700">verified_user</span>
                        <span>Profil &amp; Legal Formal Kelembagaan</span>
                    </h3>
                    
                    <div class="space-y-3.5 text-slate-700 text-xs sm:text-base leading-relaxed text-justify">
                        <p>
                            <strong class="text-slate-900">Wahdah Inspirasi Zakat (WIZ)</strong> merupakan Lembaga Amil Zakat Nasional (LAZNAS) yang berfokus pada pengelolaan dana zakat, infak, sedekah (ZIS), serta dana kemanusiaan. WIZ berkomitmen menghadirkan program-program pemberdayaan umat yang berorientasi pada kemaslahatan dan keberlanjutan yang mencakup bidang dakwah, pendidikan, ekonomi, kesehatan, dan sosial kemanusiaan.
                        </p>

                        <!-- Legal Badge Box -->
                        <div class="p-3.5 sm:p-5 bg-emerald-50/90 border border-emerald-200 rounded-xl sm:rounded-2xl space-y-1.5 text-emerald-950">
                            <p class="font-extrabold flex items-center gap-1.5 text-emerald-900 text-xs sm:text-base">
                                <span class="material-symbols-outlined text-base sm:text-lg text-emerald-700">gavel</span>
                                Pengakuan Legal Formal LAZNAS:
                            </p>
                            <ul class="list-disc list-inside space-y-1 font-medium text-emerald-800 text-[11px] sm:text-sm">
                                <li>SK Kementerian Agama Republik Indonesia <strong>Nomor 1209 Tahun 2024</strong> (LAZNAS)</li>
                                <li>SK Kantor Wilayah Kementerian Agama Prov. Kep. Bangka Belitung <strong>Nomor 290 Tahun 2023</strong></li>
                            </ul>
                        </div>

                        <p>
                            Dengan dukungan jaringan relawan, dai, dan mitra di berbagai wilayah Indonesia, WIZ terus berupaya menghadirkan manfaat nyata bagi masyarakat melalui berbagai program sosial, pendidikan, dakwah, dan kemanusiaan yang tepat sasaran dan berkelanjutan.
                        </p>

                        <p>
                            Sebelumnya, Wahdah Inspirasi Zakat dikenal dengan nama <strong>LAZIS Wahdah Islamiyah</strong> yang telah menjalankan aktivitas pengelolaan dan penyaluran zakat sejak tahun 2002. Pengalaman tersebut menjadi fondasi penting dalam meningkatkan kualitas pelayanan, penghimpunan, dan pengelolaan dana umat secara amanah, profesional, dan transparan.
                        </p>

                        <p>
                            Dengan landasan syariat Islam serta tata kelola kelembagaan yang baik, Wahdah Inspirasi Zakat berkomitmen menjalankan perannya sebagai lembaga amil zakat nasional yang amanah, profesional, dan berorientasi pada kebermanfaatan umat.
                        </p>
                    </div>
                </div>

                <!-- Right Column: Visi & Misi WIZ (5 Cols) -->
                <div class="lg:col-span-5 space-y-4 sm:space-y-6">
                    <!-- Visi Card -->
                    <div class="bg-gradient-to-br from-emerald-800 to-emerald-950 text-white p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl shadow-md space-y-2.5 border border-emerald-700/50">
                        <div class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-emerald-300 text-lg">visibility</span>
                            <span class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest text-emerald-300">VISI WIZ</span>
                        </div>
                        <h3 class="text-base sm:text-xl font-bold text-white leading-snug">
                            Menjadi Lembaga Amil Zakat Nasional Yang Amanah Dan Profesional.
                        </h3>
                    </div>

                    <!-- Misi Card -->
                    <div class="bg-slate-50 p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl border border-slate-200/80 shadow-sm space-y-3.5">
                        <div class="flex items-center gap-2 border-b border-slate-200 pb-2.5">
                            <span class="material-symbols-outlined text-emerald-700 text-lg">target</span>
                            <span class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest text-emerald-800">MISI WIZ</span>
                        </div>

                        <ul class="space-y-3 text-xs sm:text-base text-slate-700">
                            <li class="flex items-start gap-2.5">
                                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center shrink-0 text-xs mt-0.5 border border-emerald-300">1</span>
                                <span class="font-medium text-slate-800">Meningkatkan Kesadaran Ummat Tentang Urgensi Menunaikan Ibadah Zakat.</span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center shrink-0 text-xs mt-0.5 border border-emerald-300">2</span>
                                <span class="font-medium text-slate-800">Meningkatkan Penghimpunan dan Pendayagunaan Dana Zakat, Infaq dan Sedekah Secara Profesional, Transparan, Tepat Guna dan Tepat Sasaran.</span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center shrink-0 text-xs mt-0.5 border border-emerald-300">3</span>
                                <span class="font-medium text-slate-800">Memaksimalkan Kualitas Pelayanan Berbasis Kerja Yang Solutif, Praktis Dan Aplikatif.</span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center shrink-0 text-xs mt-0.5 border border-emerald-300">4</span>
                                <span class="font-medium text-slate-800">Memaksimalkan Peran Lembaga Dalam Bidang Sosial, Dakwah dan Kemandirian Ummat.</span>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Program Preview Section (5 Berkah WIZ) -->
    <section class="py-10 sm:py-16 px-3.5 sm:px-6 lg:px-8 bg-slate-50">
        <div class="max-w-7xl mx-auto space-y-8 sm:space-y-12">
            <div class="text-center max-w-2xl mx-auto space-y-2">
                <span class="inline-flex items-center gap-1.5 bg-emerald-100 text-emerald-800 px-3.5 py-1 rounded-full text-xs sm:text-sm font-extrabold uppercase tracking-wider">
                    <span class="material-symbols-outlined text-base">stars</span>
                    Program Unggulan WIZ
                </span>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">5 Berkah WIZ Bangka Belitung</h2>
                <p class="text-xs sm:text-base text-slate-600 font-medium">Pilar program penyaluran zakat, infak, dan sedekah tepat sasaran untuk masyarakat Babel.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8" id="home-featured-programs-grid">
                <!-- 1. Berkah Hidayah (Dakwah) - Pembangunan Markaz -->
                <article data-title="Pembangunan Markaz" class="program-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all border border-slate-200 flex flex-col group">
                    <div class="relative aspect-video overflow-hidden bg-slate-100">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/assets/images/foto-utama-wiz.jpg" onerror="this.onerror=null; this.src='/assets/images/default-program-wiz.jpg';" alt="Pembangunan Markaz Dakwah"/>
                        <span class="absolute top-2.5 left-2.5 bg-emerald-700 text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold shadow-xs flex items-center gap-1">
                            <span>Berkah Hidayah</span>
                        </span>
                    </div>
                    <div class="p-4 sm:p-5 flex flex-col flex-grow space-y-2.5">
                        <h3 class="text-base sm:text-lg font-black text-slate-900 line-clamp-1 group-hover:text-emerald-700 transition-colors" title="Pembangunan Markaz Dakwah">Pembangunan Markaz Dakwah</h3>
                        <p class="text-xs sm:text-sm text-slate-600 flex-grow line-clamp-2 leading-relaxed">Pembangunan pusat markaz dakwah dan sarana pembinaan Al-Qur'an untuk umat di Bangka Belitung.</p>
                        <div class="space-y-1 pt-1">
                            <div class="flex justify-between text-xs text-slate-600 font-semibold">
                                <span>Terkumpul: <strong class="text-slate-900">Rp 0</strong></span>
                                <span class="font-bold text-emerald-700">0%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                <div class="bg-emerald-700 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <a href="/donasi?program=pembangunan-markaz" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-2.5 sm:py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-xs sm:text-sm text-center cursor-pointer shadow-xs active:scale-98">Donasi Sekarang</a>
                    </div>
                </article>

                <!-- 2. Berkah Peduli (Sosial) - Sedekah Beras Dhuafa -->
                <article data-title="Sedekah Beras Dhuafa" class="program-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all border border-slate-200 flex flex-col group">
                    <div class="relative aspect-video overflow-hidden bg-slate-100">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/assets/images/sedekah-beras-dhuafa.jpg" onerror="this.onerror=null; this.src='/assets/images/tebar-sembako.jpg';" alt="Sedekah Beras Dhuafa"/>
                        <span class="absolute top-2.5 left-2.5 bg-amber-600 text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold shadow-xs flex items-center gap-1">
                            <span>Berkah Peduli</span>
                        </span>
                    </div>
                    <div class="p-4 sm:p-5 flex flex-col flex-grow space-y-2.5">
                        <h3 class="text-base sm:text-lg font-black text-slate-900 line-clamp-1 group-hover:text-emerald-700 transition-colors" title="Sedekah Beras Dhuafa">Sedekah Beras Dhuafa</h3>
                        <p class="text-xs sm:text-sm text-slate-600 flex-grow line-clamp-2 leading-relaxed">Bantuan pangan beras dan sembako untuk lansia dhuafa serta keluarga pra-sejahtera.</p>
                        <div class="space-y-1 pt-1">
                            <div class="flex justify-between text-xs text-slate-600 font-semibold">
                                <span>Terkumpul: <strong class="text-slate-900">Rp 0</strong></span>
                                <span class="font-bold text-amber-600">0%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                <div class="bg-amber-600 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <a href="/donasi?program=sedekah-beras-dhuafa" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-2.5 sm:py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-xs sm:text-sm text-center cursor-pointer shadow-xs active:scale-98">Donasi Sekarang</a>
                    </div>
                </article>

                <!-- 3. Berkah Juara (Pendidikan) - Beasiswa Pendidikan Juara -->
                <article data-title="Beasiswa Pendidikan Juara" class="program-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all border border-slate-200 flex flex-col group">
                    <div class="relative aspect-video overflow-hidden bg-slate-100">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/assets/images/beasiswa-pendidikan-juara.jpg" onerror="this.onerror=null; this.src='/assets/images/beasiswa-tahfidz.jpg';" alt="Beasiswa Pendidikan Juara"/>
                        <span class="absolute top-2.5 left-2.5 bg-blue-600 text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold shadow-xs flex items-center gap-1">
                            <span>Berkah Juara</span>
                        </span>
                    </div>
                    <div class="p-4 sm:p-5 flex flex-col flex-grow space-y-2.5">
                        <h3 class="text-base sm:text-lg font-black text-slate-900 line-clamp-1 group-hover:text-emerald-700 transition-colors" title="Beasiswa Pendidikan Juara">Beasiswa Pendidikan Juara</h3>
                        <p class="text-xs sm:text-sm text-slate-600 flex-grow line-clamp-2 leading-relaxed">Bantuan biaya sekolah, SPP, dan perlengkapan belajar bagi anak-anak yatim &amp; dhuafa berprestasi.</p>
                        <div class="space-y-1 pt-1">
                            <div class="flex justify-between text-xs text-slate-600 font-semibold">
                                <span>Terkumpul: <strong class="text-slate-900">Rp 0</strong></span>
                                <span class="font-bold text-blue-600">0%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                <div class="bg-blue-600 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <a href="/donasi?program=beasiswa-pendidikan-juara" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-2.5 sm:py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-xs sm:text-sm text-center cursor-pointer shadow-xs active:scale-98">Donasi Sekarang</a>
                    </div>
                </article>

                <!-- 4. Berkah Sehat (Kesehatan) - Khitanan Massal Dhuafa -->
                <article data-title="Khitanan Massal Dhuafa" class="program-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all border border-slate-200 flex flex-col group">
                    <div class="relative aspect-video overflow-hidden bg-slate-100">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/assets/images/khitanan-massal-dhuafa.jpg" onerror="this.onerror=null; this.src='/assets/images/khitanan-massal.jpg';" alt="Khitanan Massal Dhuafa"/>
                        <span class="absolute top-2.5 left-2.5 bg-rose-600 text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold shadow-xs flex items-center gap-1">
                            <span>Berkah Sehat</span>
                        </span>
                    </div>
                    <div class="p-4 sm:p-5 flex flex-col flex-grow space-y-2.5">
                        <h3 class="text-base sm:text-lg font-black text-slate-900 line-clamp-1 group-hover:text-emerald-700 transition-colors" title="Khitanan Massal Dhuafa">Khitanan Massal Dhuafa</h3>
                        <p class="text-xs sm:text-sm text-slate-600 flex-grow line-clamp-2 leading-relaxed">Layanan khitanan massal medis dan bingkisan berkah cuma-cuma bagi anak-anak dhuafa.</p>
                        <div class="space-y-1 pt-1">
                            <div class="flex justify-between text-xs text-slate-600 font-semibold">
                                <span>Terkumpul: <strong class="text-slate-900">Rp 0</strong></span>
                                <span class="font-bold text-rose-600">0%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                <div class="bg-rose-600 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <a href="/donasi?program=khitanan-massal-dhuafa" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-2.5 sm:py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-xs sm:text-sm text-center cursor-pointer shadow-xs active:scale-98">Donasi Sekarang</a>
                    </div>
                </article>

                <!-- 5. Berkah Sehat (Kesehatan) - Layanan Pengobatan Gratis -->
                <article data-title="Layanan Pengobatan Gratis" class="program-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all border border-slate-200 flex flex-col group">
                    <div class="relative aspect-video overflow-hidden bg-slate-100">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/assets/images/bantuan-pengobatan.jpg" onerror="this.onerror=null; this.src='/assets/images/ambulance-gratis-ummat.jpg';" alt="Bantuan Kesehatan Dhuafa"/>
                        <span class="absolute top-2.5 left-2.5 bg-rose-600 text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold shadow-xs flex items-center gap-1">
                            <span>Berkah Sehat</span>
                        </span>
                    </div>
                    <div class="p-4 sm:p-5 flex flex-col flex-grow space-y-2.5">
                        <h3 class="text-base sm:text-lg font-black text-slate-900 line-clamp-1 group-hover:text-emerald-700 transition-colors" title="Bantuan Kesehatan Dhuafa">Bantuan Kesehatan Dhuafa</h3>
                        <p class="text-xs sm:text-sm text-slate-600 flex-grow line-clamp-2 leading-relaxed">Bantuan biaya pengobatan medis dan pendampingan kesehatan bagi pasien dhuafa.</p>
                        <div class="space-y-1 pt-1">
                            <div class="flex justify-between text-xs text-slate-600 font-semibold">
                                <span>Terkumpul: <strong class="text-slate-900">Rp 0</strong></span>
                                <span class="font-bold text-rose-600">0%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                <div class="bg-rose-600 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <a href="/donasi?program=layanan-pengobatan-gratis" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-2.5 sm:py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-xs sm:text-sm text-center cursor-pointer shadow-xs active:scale-98">Donasi Sekarang</a>
                    </div>
                </article>

                <!-- 6. Berkah Mandiri (Ekonomi) - Modal Usaha Dhuafa -->
                <article data-title="Modal Usaha Dhuafa" class="program-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all border border-slate-200 flex flex-col group">
                    <div class="relative aspect-video overflow-hidden bg-slate-100">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/assets/images/modal-usaha-dhuafa.jpg" onerror="this.onerror=null; this.src='/assets/images/pelatihan-keterampilan-wirausaha.jpg';" alt="Modal Usaha Dhuafa"/>
                        <span class="absolute top-2.5 left-2.5 bg-purple-600 text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold shadow-xs flex items-center gap-1">
                            <span>Berkah Mandiri</span>
                        </span>
                    </div>
