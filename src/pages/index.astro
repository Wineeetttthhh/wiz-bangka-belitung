---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="WIZ Bangka Belitung - Tebarkan Kebaikan"
    description="Wahdah Inspirasi Zakat (WIZ) Bangka Belitung - Lembaga Amil Zakat Terpercaya. Melayani Zakat, Infak, Sedekah & Wakaf untuk pemberdayaan umat di Bangka Belitung."
    image="/assets/images/foto-utama-wiz.jpg"
>
    <!-- Hero Section -->
    <section class="relative pt-6 sm:pt-12 pb-12 sm:pb-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <div class="lg:col-span-7 space-y-5 sm:space-y-6 z-10">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm font-bold shadow-2xs">
                    <span class="material-symbols-outlined text-base text-emerald-700">verified</span>
                    <span>Lembaga Amil Zakat Resmi SK Kemenag RI No. 1209/2024</span>
                </div>
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-emerald-950 leading-[1.15] tracking-tight">
                    Tebarkan Kebaikan, <br class="hidden sm:inline" />
                    <span class="text-emerald-700">Hadirkan Kebermanfaatan</span>
                </h1>
                <p class="text-base sm:text-lg md:text-xl text-slate-700 leading-relaxed font-normal max-w-2xl">
                    Bersama Wahdah Inspirasi Zakat Bangka Belitung, wujudkan kepedulian melalui Zakat, Infak, dan Sedekah untuk membangun masyarakat yang lebih berdaya dan mandiri.
                </p>
                <div class="flex flex-col sm:flex-row gap-3.5 pt-2 w-full sm:w-auto">
                    <a href="/donasi" class="bg-[#F7941D] hover:bg-[#ea7e00] text-white px-8 py-4 rounded-2xl shadow-lg shadow-orange-500/20 hover:shadow-orange-500/30 transition-all text-base sm:text-lg font-extrabold flex items-center justify-center gap-2.5 active:scale-98">
                        <span class="material-symbols-outlined text-xl">volunteer_activism</span>
                        <span>Donasi Sekarang</span>
                    </a>
                    <a href="/program" class="bg-white hover:bg-emerald-50 text-emerald-800 border-2 border-emerald-600/80 px-8 py-4 rounded-2xl shadow-sm hover:shadow-md transition-all text-base sm:text-lg font-bold flex items-center justify-center gap-2.5 active:scale-98">
                        <span class="material-symbols-outlined text-xl">grid_view</span>
                        <span>Lihat Program</span>
                    </a>
                </div>
            </div>
            <div class="lg:col-span-5 relative h-[320px] sm:h-[420px] lg:h-[480px] rounded-3xl overflow-hidden shadow-2xl border-2 border-emerald-100 bg-slate-100">
                <img id="main-hero-img" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 hover:scale-105" data-site-img="hero_card" data-alt="Relawan WIZ Bangka Belitung" src="/assets/images/foto-utama-wiz.jpg" onerror="this.src='/assets/images/sedekah-beras-dhuafa.jpg';" alt="Relawan WIZ Bangka Belitung Menyerahkan Sedekah Beras"/>
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/35 via-transparent to-transparent"></div>
            </div>
        </div>
    </section>

    <!-- Section: Tentang Kami, Legalitas, Visi & Misi WIZ -->
    <section id="tentang-kami" class="py-14 sm:py-20 bg-white border-t border-b border-slate-200/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
            
            <!-- Section Header -->
            <div class="max-w-3xl space-y-2">
                <span class="inline-flex items-center gap-2 text-emerald-700 font-extrabold text-xs sm:text-sm uppercase tracking-wider bg-emerald-50 px-3.5 py-1 rounded-full border border-emerald-200">
                    <span class="material-symbols-outlined text-base">info</span>
                    Tentang Kami
                </span>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">Wahdah Inspirasi Zakat (WIZ) Bangka Belitung</h2>
                <p class="text-base sm:text-lg text-slate-600 font-medium">Lembaga Amil Zakat Nasional yang Amanah, Profesional, dan Berkelanjutan.</p>
            </div>

            <!-- Content Grid: Profil Lengkap & Visi Misi -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
                
                <!-- Left Column: Profil & Legalitas Formal (7 Cols) -->
                <div class="lg:col-span-7 bg-slate-50 p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-5">
                    <h3 class="text-lg sm:text-xl font-black text-emerald-800 flex items-center gap-2.5">
                        <span class="material-symbols-outlined text-2xl text-emerald-700">verified_user</span>
                        <span>Profil &amp; Legal Formal Kelembagaan</span>
                    </h3>
                    
                    <div class="space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed text-justify">
                        <p>
                            <strong class="text-slate-900">Wahdah Inspirasi Zakat (WIZ)</strong> merupakan Lembaga Amil Zakat Nasional (LAZNAS) yang berfokus pada pengelolaan dana zakat, infak, sedekah (ZIS), serta dana kemanusiaan. WIZ berkomitmen menghadirkan program-program pemberdayaan umat yang berorientasi pada kemaslahatan dan keberlanjutan yang mencakup bidang dakwah, pendidikan, ekonomi, kesehatan, dan sosial kemanusiaan.
                        </p>

                        <!-- Legal Badge Box -->
                        <div class="p-4 sm:p-5 bg-emerald-50/90 border border-emerald-200 rounded-2xl space-y-2 text-emerald-950">
                            <p class="font-extrabold flex items-center gap-2 text-emerald-900 text-sm sm:text-base">
                                <span class="material-symbols-outlined text-lg text-emerald-700">gavel</span>
                                Pengakuan Legal Formal LAZNAS:
                            </p>
                            <ul class="list-disc list-inside space-y-1.5 font-medium text-emerald-800 text-xs sm:text-sm">
                                <li>SK Kementerian Agama Republik Indonesia <strong>Nomor 1209 Tahun 2024</strong> (LAZNAS)</li>
                                <li>SK Kantor Wilayah Kementerian Agama Prov. Kep. Bangka Belitung <strong>Nomor 290 Tahun 2023</strong></li>
                            </ul>
                        </div>

                        <p>
                            Dengan dukungan jaringan relawan, dai, dan mitra di berbagai wilayah Indonesia, WIZ terus berupaya menghadirkan manfaat nyata bagi masyarakat melalui berbagai program sosial, pendidikan, dakwah, dan kemanusiaan yang tepat sasaran dan berkelanjutan.
                        </p>

                        <p>
                            Sebelumnya, Wahdah Inspirasi Zakat dikenal dengan nama <strong>LAZIS Wahdah Islamiyah</strong> yang telah menjalankan aktivitas pengelolaan dan penyaluran zakat sejak tahun 2002. Pengalaman tersebut menjadi fondasi penting dalam meningkatkan kualitas pelayanan, penghimpunan, dan pengelolaan dana umat secara amanah, profesional, dan transparan.
                        </p>

                        <p>
                            Dengan landasan syariat Islam serta tata kelola kelembagaan yang baik, Wahdah Inspirasi Zakat berkomitmen menjalankan perannya sebagai lembaga amil zakat nasional yang amanah, profesional, dan berorientasi pada kebermanfaatan umat.
                        </p>
                    </div>
                </div>

                <!-- Right Column: Visi & Misi WIZ (5 Cols) -->
                <div class="lg:col-span-5 space-y-6">
                    <!-- Visi Card -->
                    <div class="bg-gradient-to-br from-emerald-800 to-emerald-950 text-white p-6 sm:p-8 rounded-3xl shadow-md space-y-3 border border-emerald-700/50">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-emerald-300">visibility</span>
                            <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-300">VISI WIZ</span>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-white leading-snug">
                            Menjadi Lembaga Amil Zakat Nasional Yang Amanah Dan Profesional.
                        </h3>
                    </div>

                    <!-- Misi Card -->
                    <div class="bg-slate-50 p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center gap-2 border-b border-slate-200 pb-3">
                            <span class="material-symbols-outlined text-emerald-700">target</span>
                            <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-800">MISI WIZ</span>
                        </div>

                        <ul class="space-y-3.5 text-sm sm:text-base text-slate-700">
                            <li class="flex items-start gap-3">
                                <span class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center shrink-0 text-xs mt-0.5 border border-emerald-300">1</span>
                                <span class="font-medium text-slate-800">Meningkatkan Kesadaran Ummat Tentang Urgensi Menunaikan Ibadah Zakat.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center shrink-0 text-xs mt-0.5 border border-emerald-300">2</span>
                                <span class="font-medium text-slate-800">Meningkatkan Penghimpunan dan Pendayagunaan Dana Zakat, Infaq dan Sedekah Secara Profesional, Transparan, Tepat Guna dan Tepat Sasaran.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center shrink-0 text-xs mt-0.5 border border-emerald-300">3</span>
                                <span class="font-medium text-slate-800">Memaksimalkan Kualitas Pelayanan Berbasis Kerja Yang Solutif, Praktis Dan Aplikatif.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center shrink-0 text-xs mt-0.5 border border-emerald-300">4</span>
                                <span class="font-medium text-slate-800">Memaksimalkan Peran Lembaga Dalam Bidang Sosial, Dakwah dan Kemandirian Ummat.</span>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Program Preview Section (5 Berkah WIZ) -->
    <section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 bg-slate-50">
        <div class="max-w-7xl mx-auto space-y-10 sm:space-y-12">
            <div class="text-center max-w-2xl mx-auto space-y-2">
                <span class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 px-4 py-1 rounded-full text-xs sm:text-sm font-extrabold uppercase tracking-wider">
                    <span class="material-symbols-outlined text-base">stars</span>
                    Program Unggulan WIZ
                </span>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">5 Berkah WIZ Bangka Belitung</h2>
                <p class="text-base sm:text-lg text-slate-600 font-medium">Pilar program penyaluran zakat, infak, dan sedekah tepat sasaran untuk masyarakat Babel.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8" id="home-featured-programs-grid">
                <!-- Program Preview Card 1 -->
                <article data-title="Sedekah Beras Dhuafa" class="program-card bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all border border-slate-200 flex flex-col">
                    <div class="relative aspect-video overflow-hidden">
                        <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" src="/assets/images/sedekah-beras-dhuafa.jpg" onerror="this.onerror=null; this.src='/assets/images/sedekah-beras-dai.jpg';" alt="Sedekah Beras Dhuafa"/>
                        <span class="absolute top-3 left-3 bg-emerald-600 text-white text-xs px-3 py-1 rounded-full font-bold shadow-sm">Sosial</span>
                    </div>
                    <div class="p-5 sm:p-6 flex flex-col flex-grow space-y-3">
                        <h3 class="text-lg sm:text-xl font-black text-slate-900">Sedekah Beras &amp; Sembako Dhuafa</h3>
                        <p class="text-sm sm:text-base text-slate-600 flex-grow line-clamp-2 leading-relaxed">Bantuan kebutuhan pokok untuk lansia dan keluarga pra-sejahtera.</p>
                        <div class="space-y-1.5 pt-1">
                            <div class="flex justify-between text-xs sm:text-sm text-slate-600 font-semibold">
                                <span>Terkumpul: <strong>Rp 0</strong></span>
                                <span class="font-bold text-emerald-700">0%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2">
                                <div class="bg-emerald-600 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <a href="/donasi?program=sedekah-beras-dhuafa" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-sm sm:text-base text-center cursor-pointer shadow-sm">Donasi Sekarang</a>
                    </div>
                </article>

                <!-- Program Preview Card 2 -->
                <article data-title="Beasiswa Tahfidz Qur'an" class="program-card bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all border border-slate-200 flex flex-col">
                    <div class="relative aspect-video overflow-hidden">
                        <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" src="/assets/images/beasiswa-tahfidz.jpg" onerror="this.onerror=null; this.src='/assets/images/beasiswa-tahfidz.jpg';" alt="Beasiswa Tahfidz"/>
                        <span class="absolute top-3 left-3 bg-emerald-600 text-white text-xs px-3 py-1 rounded-full font-bold shadow-sm">Pendidikan</span>
                    </div>
                    <div class="p-5 sm:p-6 flex flex-col flex-grow space-y-3">
                        <h3 class="text-lg sm:text-xl font-black text-slate-900">Beasiswa Tahfidz Qur'an</h3>
                        <p class="text-sm sm:text-base text-slate-600 flex-grow line-clamp-2 leading-relaxed">Beasiswa pendidikan penuh dan asrama bagi santri penghafal Al-Qur'an yatim dhuafa.</p>
                        <div class="space-y-1.5 pt-1">
                            <div class="flex justify-between text-xs sm:text-sm text-slate-600 font-semibold">
                                <span>Terkumpul: <strong>Rp 0</strong></span>
                                <span class="font-bold text-emerald-700">0%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2">
                                <div class="bg-teal-600 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <a href="/donasi?program=tahfidz" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-sm sm:text-base text-center cursor-pointer shadow-sm">Donasi Sekarang</a>
                    </div>
                </article>

                <!-- Program Preview Card 3 -->
                <article data-title="Beasiswa Pendidikan Juara" class="program-card bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all border border-slate-200 flex flex-col">
                    <div class="relative aspect-video overflow-hidden">
                        <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" src="/assets/images/beasiswa-pendidikan-juara.jpg" onerror="this.onerror=null; this.src='/assets/images/default-program-wiz.jpg';" alt="Beasiswa Pendidikan"/>
                        <span class="absolute top-3 left-3 bg-amber-600 text-white text-xs px-3 py-1 rounded-full font-bold shadow-sm">Pendidikan</span>
                    </div>
                    <div class="p-5 sm:p-6 flex flex-col flex-grow space-y-3">
                        <h3 class="text-lg sm:text-xl font-black text-slate-900">Beasiswa Pendidikan Juara</h3>
                        <p class="text-sm sm:text-base text-slate-600 flex-grow line-clamp-2 leading-relaxed">Bantuan biaya sekolah dan kelengkapan perlengkapan belajar.</p>
                        <div class="space-y-1.5 pt-1">
                            <div class="flex justify-between text-xs sm:text-sm text-slate-600 font-semibold">
                                <span>Terkumpul: <strong>Rp 0</strong></span>
                                <span class="font-bold text-emerald-700">0%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2">
                                <div class="bg-amber-500 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <a href="/donasi?program=beasiswa-pendidikan-juara" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-sm sm:text-base text-center cursor-pointer shadow-sm">Donasi Sekarang</a>
                    </div>
                </article>
            </div>

            <div class="text-center pt-2">
                <a href="/program" class="inline-flex items-center gap-2 bg-emerald-700 text-white px-8 py-4 rounded-2xl text-base sm:text-lg font-extrabold hover:bg-emerald-800 transition-all shadow-md">
                    <span>Lihat Semua Program Kebaikan</span>
                    <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Visualisasi Dinamis: Distribusi Infak Umum Berbasis Wilayah -->
    <section id="distribusi-infak-umum" class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 bg-white border-t border-b border-slate-200/80">
        <div class="max-w-7xl mx-auto space-y-10 sm:space-y-12">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
                <div class="space-y-2 max-w-2xl">
                    <span class="inline-flex items-center gap-1.5 bg-emerald-100 text-emerald-800 px-3.5 py-1 rounded-full text-xs sm:text-sm font-extrabold uppercase tracking-wider">
                        <span class="material-symbols-outlined text-base">pie_chart</span>
                        Alokasi Otomatis &amp; Transparansi 100%
                    </span>
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">Distribusi Dinamis 'Infak Umum' Berbasis Wilayah</h2>
                    <p class="text-base sm:text-lg text-slate-600 leading-relaxed">Setiap rupiah dari donasi <strong>Infak Umum</strong> otomatis dipecah dan didistribusikan ke 5 Pilar program WIZ sesuai persentase kebutuhan cabang operasional.</p>
                </div>
                
                <!-- Wilayah Switcher Tabs -->
                <div class="flex items-center gap-1 bg-slate-100 p-1.5 rounded-2xl border border-slate-200 shrink-0">
                    <button type="button" onclick="switchInfakUmumWilayah('Pangkalpinang', this)" class="infak-tab-btn active px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all bg-emerald-700 text-white shadow-xs cursor-pointer">Pangkalpinang</button>
                    <button type="button" onclick="switchInfakUmumWilayah('Sungailiat', this)" class="infak-tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-600 hover:text-emerald-700 cursor-pointer">Sungailiat</button>
                    <button type="button" onclick="switchInfakUmumWilayah('Semua', this)" class="infak-tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-600 hover:text-emerald-700 cursor-pointer">Semua Wilayah</button>
                </div>
            </div>

            <!-- Main Grid Container: Donut Chart + Pillars Breakdown -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center bg-slate-50 p-6 sm:p-10 rounded-3xl border border-slate-200 shadow-sm">
                
                <!-- Left Column: Interactive SVG Donut Chart & Simulator -->
                <div class="lg:col-span-5 flex flex-col items-center justify-center space-y-6">
                    <div id="home-infak-chart-container" class="relative flex items-center justify-center w-full min-h-[220px]">
                    </div>

                    <!-- Live Nominal Simulator -->
                    <div class="w-full bg-white p-5 rounded-2xl border border-slate-200 space-y-3 shadow-2xs">
                        <label class="block text-xs sm:text-sm font-bold text-slate-900 flex items-center justify-between">
                            <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-base text-emerald-700">calculate</span> Simulasikan Nominal Infak Anda:</span>
                            <span class="text-xs text-slate-500 font-semibold">Real-Time</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">Rp</span>
                            <input type="number" id="home-sim-amount" value="100000" min="10000" step="10000" oninput="handleHomeSimulationChange(this.value)"
                                class="w-full pl-11 pr-3 py-3 text-base sm:text-lg font-bold font-mono text-emerald-800 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-emerald-600 focus:bg-white transition-all">
                        </div>
                        <div class="flex gap-2 pt-1">
                            <button type="button" onclick="setHomeSimAmount(50000)" class="flex-1 py-1.5 text-xs sm:text-sm font-bold rounded-lg bg-slate-100 border border-slate-200 hover:border-emerald-600 text-slate-700 transition-colors cursor-pointer">50rb</button>
                            <button type="button" onclick="setHomeSimAmount(100000)" class="flex-1 py-1.5 text-xs sm:text-sm font-bold rounded-lg bg-slate-100 border border-slate-200 hover:border-emerald-600 text-slate-700 transition-colors cursor-pointer">100rb</button>
                            <button type="button" onclick="setHomeSimAmount(250000)" class="flex-1 py-1.5 text-xs sm:text-sm font-bold rounded-lg bg-slate-100 border border-slate-200 hover:border-emerald-600 text-slate-700 transition-colors cursor-pointer">250rb</button>
                            <button type="button" onclick="setHomeSimAmount(500000)" class="flex-1 py-1.5 text-xs sm:text-sm font-bold rounded-lg bg-slate-100 border border-slate-200 hover:border-emerald-600 text-slate-700 transition-colors cursor-pointer">500rb</button>
                        </div>
                    </div>

                    <a id="home-infak-cta-btn" href="/donasi?type=Infak%20Umum&wilayah=Pangkalpinang" class="w-full bg-[#F7941D] hover:bg-[#ea7e00] text-white py-4 px-6 rounded-2xl text-base sm:text-lg font-extrabold text-center flex items-center justify-center gap-2 shadow-md transition-all">
                        <span class="material-symbols-outlined text-xl">volunteer_activism</span>
                        <span>Salurkan Infak Umum (Pangkalpinang)</span>
                    </a>
                </div>

                <!-- Right Column: 5 Pillars Detailed Breakdown List -->
                <div class="lg:col-span-7 space-y-3.5" id="home-infak-pillars-container">
                </div>

            </div>
        </div>
    </section>

    <!-- Live Social Proof: Donatur Terbaru & Terverifikasi Real-Time -->
    <section id="donatur-terbaru" class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 bg-slate-50 border-t border-b border-slate-200/80">
        <div class="max-w-7xl mx-auto space-y-8 sm:space-y-10">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
                <div class="space-y-2">
                    <span class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 px-3.5 py-1 rounded-full text-xs sm:text-sm font-extrabold uppercase tracking-wider">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
