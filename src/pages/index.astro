    <!-- Page Scripts matching index.html -->
    <script is:inline>
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        let currentShareArticle = null;

        function shareArticle(platform) {
            if (!currentShareArticle) return;
            const activeRef = (typeof getActiveAffiliateRef === 'function' ? getActiveAffiliateRef() : '') || (new URLSearchParams(window.location.search).get('ref') || '');
            const baseOrigin = window.location.origin;
            const title = currentShareArticle.title || 'Berita WIZ Bangka Belitung';

            const articleUrl = new URL(`${baseOrigin}/berita/${encodeURIComponent(currentShareArticle.id)}`);
            if (activeRef) {
                articleUrl.searchParams.set('ref', activeRef);
            }

            const finalShareUrl = articleUrl.toString();
            if (platform === 'wa') {
                if (typeof window.showWhatsAppShareToast === 'function') {
                    window.showWhatsAppShareToast('Tunggu 1–2 detik di WhatsApp hingga kartu preview gambar muncul sebelum kirim Status ✨');
                }
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(finalShareUrl)}`, '_blank');
            } else if (platform === 'fb') {
                window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(finalShareUrl)}`, '_blank');
            } else if (platform === 'tw') {
                window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(finalShareUrl)}`, '_blank');
            } else if (platform === 'tg') {
                window.open(`https://t.me/share/url?url=${encodeURIComponent(finalShareUrl)}&text=${encodeURIComponent(title)}`, '_blank');
            } else if (platform === 'copy') {
                navigator.clipboard.writeText(finalShareUrl).then(() => {
                    const toast = document.getElementById('share-toast');
                    if (toast) {
                        toast.classList.remove('hidden');
                        setTimeout(() => toast.classList.add('hidden'), 3000);
                    } else {
                        alert('Tautan berita berhasil disalin ke clipboard!');
                    }
                });
            }
        }

        let isFetchingHomeNews = false;
        async function fetchFreshNewsDirectly() {
            if (isFetchingHomeNews) return;
            isFetchingHomeNews = true;
            try {
                if (window.wizSupabase && window.wizSupabase.isConfigured()) {
                    const res = await window.wizSupabase.select('news', { select: 'id,title,category,content,image_url,gallery,event_date,status,author,created_at,updated_at', order: 'created_at.desc' });
                    if (res && Array.isArray(res.data) && res.data.length > 0) {
                        const mapped = res.data.map(n => {
                            const mainImg = (n.image_url || (Array.isArray(n.gallery) && n.gallery.length > 0 ? n.gallery[0] : '') || n.imageUrl || '').trim();
                            return {
                                id: String(n.id),
                                title: n.title,
                                category: n.category || 'Kegiatan & Penyaluran',
                                content: n.content,
                                imageUrl: mainImg,
                                image_url: mainImg,
                                gallery: Array.isArray(n.gallery) ? n.gallery : [],
                                eventDate: n.event_date || n.eventDate || n.created_at,
                                event_date: n.event_date || n.eventDate || n.created_at,
                                status: n.status || 'published',
                                author: n.author || 'Admin WIZ Babel',
                                createdAt: n.created_at || n.createdAt || new Date().toISOString(),
                                created_at: n.created_at || n.createdAt || new Date().toISOString(),
                                updatedAt: n.updated_at || n.updatedAt || new Date().toISOString(),
                                updated_at: n.updated_at || n.updatedAt || new Date().toISOString()
                            };
                        });
                        mapped.sort((a, b) => {
                            const timeA = new Date(a.createdAt || a.created_at || a.updatedAt || a.updated_at || a.eventDate || a.event_date || 0).getTime();
                            const timeB = new Date(b.createdAt || b.created_at || b.updatedAt || b.updated_at || b.eventDate || b.event_date || 0).getTime();
                            return timeB - timeA;
                        });
                        localStorage.setItem('wiz_news', JSON.stringify(mapped));
                        renderPublicNews();
                    }
                }
            } catch(e) {}
            finally {
                isFetchingHomeNews = false;
            }
        }

        function renderPublicNews() {
            if (!window.wizStore) return;
            const allPublished = wizStore.news.getPublished();
            const publishedNews = (allPublished || []).slice(0, 6);
            const grid = document.getElementById('public-news-grid');
            if (!grid) return;

            if (publishedNews.length === 0) {
                fetchFreshNewsDirectly();
                grid.innerHTML = `
                <div class="col-span-1 md:col-span-3 text-center py-xl bg-surface-container-low rounded-2xl border border-dashed border-outline-variant/50 p-lg space-y-sm">
                    <span class="material-symbols-outlined text-4xl text-primary/60">feed</span>
                    <p class="font-headline-md text-on-surface font-bold">Belum Ada Berita Terbaru</p>
                    <p class="font-caption text-caption text-on-surface-variant max-w-md mx-auto">Dokumentasi kegiatan dan berita penyaluran akan segera diperbarui.</p>
                </div>`;
                return;
            }

            const defaultImg = '/assets/images/sedekah-beras-dhuafa.jpg';

            grid.innerHTML = publishedNews.map(n => {
                const galCount = Array.isArray(n.gallery) ? n.gallery.filter(Boolean).length : 0;
                const rawImg = (n.imageUrl || n.image_url || '').trim();
                const firstGal = (Array.isArray(n.gallery) && n.gallery.length > 0 && typeof n.gallery[0] === 'string') ? n.gallery[0].trim() : '';
                const cardImg = rawImg || firstGal || defaultImg;

                return `
                <article class="bg-surface rounded-2xl overflow-hidden shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all border border-surface-variant flex flex-col group">
                    <div onclick="openPublicNewsModal('${n.id}')" class="relative aspect-video overflow-hidden bg-surface-container cursor-pointer w-full">
                        <img src="${cardImg}" onerror="this.src='${defaultImg}'" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 block" style="object-fit: cover; width: 100%; height: 100%; display: block;" alt="${n.title}" loading="lazy">
                        <span class="absolute top-3 left-3 bg-[#006834] text-white text-[11px] px-3 py-1 rounded-full font-bold shadow-sm">${n.category || 'Kegiatan & Penyaluran'}</span>
                        ${galCount > 0 ? `
                        <span class="absolute bottom-3 right-3 bg-black/75 backdrop-blur-xs text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold shadow-sm flex items-center gap-1">
                            <span class="material-symbols-outlined text-xs">collections</span>
                            <span>+${galCount} foto</span>
                        </span>` : ''}
                    </div>
                    <div class="p-4 sm:p-5 flex flex-col flex-grow space-y-2">
                        <div class="flex items-center text-[#006834] text-xs font-semibold gap-1.5 flex-wrap">
                            <span class="material-symbols-outlined text-sm">event</span>
                            <span>Kegiatan: ${wizStore.utils.formatDate(n.eventDate || n.event_date || n.createdAt || n.created_at)}</span>
                            <span class="text-slate-400">• Oleh: ${n.author || 'Super Admin 1 (WIZ Babel)'}</span>
                        </div>
                        <h3 onclick="openPublicNewsModal('${n.id}')" class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-[#008444] transition-colors line-clamp-2 cursor-pointer leading-snug">${n.title}</h3>
                        <p onclick="openPublicNewsModal('${n.id}')" class="text-xs sm:text-[13px] text-slate-600 line-clamp-3 flex-grow cursor-pointer whitespace-pre-line leading-relaxed">${n.content}</p>
                        
                        <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-2">
                            <button onclick="openPublicNewsModal('${n.id}')" class="text-[#008444] text-xs font-bold flex items-center gap-1 hover:underline cursor-pointer">
                                <span>Baca Selengkapnya</span>
                                <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
                            </button>
                            <button onclick="currentShareArticle = wizStore.news.getById('${n.id}'); shareArticle('wa');" title="Bagikan ke WhatsApp" class="text-slate-400 hover:text-[#25D366] transition-colors p-1.5 rounded-lg flex items-center justify-center cursor-pointer hover:bg-slate-100">
                                <span class="material-symbols-outlined text-base">share</span>
                            </button>
                        </div>
                    </div>
                </article>`;
            }).join('');
        }

        function openPublicNewsModal(id) {
            if (!window.wizStore) return;
            const article = wizStore.news.getById(id);
            if (!article) return;
            currentShareArticle = article;

            const defaultImg = '/assets/images/sedekah-beras-dhuafa.jpg';
            const rawImg = (article.imageUrl || article.image_url || '').trim();
            const firstGal = (Array.isArray(article.gallery) && article.gallery.length > 0 && typeof article.gallery[0] === 'string') ? article.gallery[0].trim() : '';
            const modalImg = rawImg || firstGal || defaultImg;

            const imgEl = document.getElementById('pub-modal-image');
            if (imgEl) {
                imgEl.src = modalImg;
                imgEl.onerror = () => { imgEl.src = defaultImg; };
            }

            const catEl = document.getElementById('pub-news-category');
            if (catEl) catEl.textContent = article.category || 'Kegiatan & Event';
            
            const dateEl = document.getElementById('pub-news-event-date');
            if (dateEl) dateEl.textContent = `📅 ${wizStore.utils.formatDate(article.eventDate || article.createdAt)}`;
            
            const titleEl = document.getElementById('pub-news-title');
            if (titleEl) titleEl.textContent = article.title;
            
            const metaEl = document.getElementById('pub-news-meta');
            if (metaEl) metaEl.textContent = `Dipublikasikan pada ${wizStore.utils.formatDate(article.createdAt)} • Oleh ${article.author || 'Admin WIZ Babel'}`;

            const contentEl = document.getElementById('pub-news-content');
            if (contentEl) contentEl.textContent = article.content || '';

            const gal = Array.isArray(article.gallery) ? article.gallery.filter(Boolean) : [];
            const galWrapper = document.getElementById('pub-news-gallery-wrapper');
            const galGrid = document.getElementById('pub-news-gallery-grid');
            
            if (gal.length > 0 && galWrapper && galGrid) {
                galWrapper.classList.remove('hidden');
                galGrid.innerHTML = gal.map(imgUrl => `
                    <div class="overflow-hidden rounded-xl border border-outline-variant/30 shadow-sm aspect-video bg-surface-container">
                        <img src="${imgUrl}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300 block" alt="Dokumentasi Tambahan">
                    </div>
                `).join('');
            } else if (galWrapper) {
                galWrapper.classList.add('hidden');
            }

            const modal = document.getElementById('public-news-modal');
            if (modal) {
                modal.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
        }

        function closePublicNewsModal() {
            const modal = document.getElementById('public-news-modal');
            if (modal) {
                modal.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        function openDonationModal(programName) {
            const refCode = (typeof getActiveAffiliateRef === 'function' ? getActiveAffiliateRef() : '') || (new URLSearchParams(window.location.search).get('ref') || '');
            let url = '/donasi';
            if (programName && programName !== 'Donasi Umum') {
                url += `?type=Infak%20Terikat&program=${encodeURIComponent(programName)}`;
                if (refCode) url += `&ref=${encodeURIComponent(refCode)}`;
            } else if (refCode) {
                url += `?ref=${encodeURIComponent(refCode)}`;
            }
            window.location.href = url;
        }

        function closeDonationModal() {
            const modal = document.getElementById('donation-modal');
            if (modal) {
                modal.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        function setNominal(value) {
            const numVal = parseInt(value) || 0;
            const nominalInput = document.getElementById('nominal-input');
            if (nominalInput) {
                nominalInput.value = numVal > 0 ? numVal : '';
            }
        }

        function handleDonationSubmit(event) {
            event.preventDefault();
            const nominalInput = document.getElementById('nominal-input');
            const nominal = nominalInput ? nominalInput.value : '50000';
            const name = document.getElementById('donor-name')?.value || 'Hamba Allah';
            const phone = document.getElementById('donor-phone')?.value || '';
            const msg = document.getElementById('donor-message')?.value || '';
            const modalTitle = document.getElementById('modal-program-title');
            const prog = modalTitle ? modalTitle.textContent : 'Donasi';

            const text = `Bismillah, saya *${name}* (%2B${phone}) ingin berdonasi untuk *${prog}* sebesar *Rp ${Number(nominal).toLocaleString('id-ID')}*.%0A%0ANiat/Doa: ${msg || '-'}`;
            window.open(`https://wa.me/6282380830808?text=${text}`, '_blank');
            closeDonationModal();
        }

        function calculateZakat() {
            const incomeInput = document.getElementById('zakat-income');
            const zakatResult = document.getElementById('zakat-result');
            const zakatAmount = document.getElementById('zakat-amount');

            const val = parseFloat(incomeInput?.value) || 0;
            if (val > 0) {
                const zakat = Math.round(val * 0.025);
                if (zakatAmount) zakatAmount.textContent = `Rp ${zakat.toLocaleString('id-ID')}`;
                if (zakatResult) zakatResult.classList.remove('hidden');
            } else {
                alert('Silakan masukkan nominal penghasilan atau simpanan Anda.');
            }
        }

        function payZakatFromCalc() {
            const zakatAmountText = document.getElementById('zakat-amount')?.textContent || '';
            openDonationModal(`Zakat Maal / Penghasilan (${zakatAmountText})`);
        }

        function copyToClipboard(text, msg) {
            const clean = String(text || '').trim();
            const successMsg = msg || `Nomor rekening ${clean} berhasil disalin!`;
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(clean).then(() => {
                    alert(successMsg);
                }).catch(() => {
                    alert(successMsg);
                });
            } else {
                alert(successMsg);
            }
        }

        function updateDynamicProgramCards() {
            if (!window.wizStore) return;
            const fmt = wizStore.utils.formatRupiahCompact;

            document.querySelectorAll('article.program-card, article[data-title]').forEach(card => {
                const titleEl = card.querySelector('h3, h4');
                if (!titleEl) return;

                const progTitle = (card.getAttribute('data-title') || titleEl.textContent).trim();
                if (!progTitle) return;

                let progObj = null;
                if (window.wizStore && window.wizStore.programs && typeof window.wizStore.programs.getAll === 'function') {
                    const allProgs = window.wizStore.programs.getAll();
                    progObj = allProgs.find(p => (window.wizStore.utils && window.wizStore.utils.isProgramMatching) 
                        ? (window.wizStore.utils.isProgramMatching(p.title, progTitle) || window.wizStore.utils.isProgramMatching(p.slug, progTitle) || window.wizStore.utils.isProgramMatching(p.id, progTitle))
                        : (p.title && p.title.toLowerCase() === progTitle.toLowerCase()));
                }

                if (progObj) {
                    if (titleEl && progObj.title) titleEl.textContent = progObj.title;
                    const descEl = card.querySelector('p.font-body-md, p.card-desc, p.line-clamp-2, p.line-clamp-3, p.line-clamp-4');
                    if (descEl && progObj.description) {
                        descEl.textContent = progObj.description;
                    }
                    if (progObj.targetAmount) {
                        card.dataset.target = progObj.targetAmount;
                    }
                }

                const targetVal = Number(card.dataset.target) || (progObj ? progObj.targetAmount : 50000000) || 50000000;
                const stats = wizStore.finance.getSpecificProgramStats(progTitle, 0, targetVal);

                const terkumpulStrong = card.querySelector('.space-y-xs strong, .mb-lg strong');
                if (terkumpulStrong) {
                    terkumpulStrong.textContent = fmt(stats.terkumpul);
                }

                const percentSpan = card.querySelector('.space-y-xs span.text-primary, .space-y-xs span.font-semibold, .mb-lg .font-semibold');
                if (percentSpan && !percentSpan.textContent.includes('Terkumpul')) {
                    percentSpan.textContent = `${stats.percent}%`;
                }

                const progressBar = card.querySelector('.bg-tertiary-container, .bg-primary');
                if (progressBar) {
                    progressBar.style.width = `${stats.percent}%`;
                }

                const customImg = (progObj && progObj.imageUrl) ? progObj.imageUrl : ((wizStore.allocationRulesManager) ? wizStore.allocationRulesManager.getSpecificProgramImage(progTitle) : '');
                if (customImg && !customImg.includes('placeholder')) {
                    const imgEl = card.querySelector('img');
                    if (imgEl) {
                        imgEl.src = customImg;
                        imgEl.onerror = () => { imgEl.src = '/assets/images/foto-utama-wiz.jpg'; };
                    }
                }
            });
        }

        function renderVerifiedDonors(containerId = 'verified-donors-container') {
            if (!window.wizStore || !wizStore.donations) return;
            const container = document.getElementById(containerId);
            if (!container) return;

            const donors = (typeof wizStore.donations.getRecentVerified === 'function') 
                ? wizStore.donations.getRecentVerified(10)
                : [];
            const fmt = wizStore.utils.formatRupiahCompact;

            if (donors.length === 0) {
                container.innerHTML = `
                    <div class="col-span-1 md:col-span-2 text-center py-xl bg-surface-container-low rounded-2xl border border-dashed border-outline-variant/50 p-lg text-on-surface-variant text-xs">
                        <span class="material-symbols-outlined text-3xl text-outline mb-1">volunteer_activism</span>
                        <p class="font-bold text-on-surface">Belum Ada Donasi Terverifikasi Baru</p>
                        <p class="text-caption text-outline">Jadilah yang pertama menyalurkan kebaikan hari ini!</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = donors.map((d, index) => {
                const initials = d.isAnonymous
                    ? 'HA'
                    : (d.donorName.split(' ').slice(0, 2).map(n => n[0]).join('').toUpperCase() || 'W');
                
                const avatarColors = [
                    'bg-emerald-100 text-emerald-800 border-emerald-300',
                    'bg-amber-100 text-amber-800 border-amber-300',
                    'bg-blue-100 text-blue-800 border-blue-300',
                    'bg-purple-100 text-purple-800 border-purple-300',
                    'bg-teal-100 text-teal-800 border-teal-300'
                ];
                const colorClass = avatarColors[index % avatarColors.length];

                return `
                <div class="p-md bg-surface-container-low hover:bg-surface-container transition-all duration-300 rounded-2xl border border-outline-variant/30 flex items-center justify-between gap-md shadow-xs hover:shadow-sm group">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-11 h-11 rounded-full ${colorClass} border flex items-center justify-center font-bold text-xs shrink-0 shadow-xs">
                            ${initials}
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="font-bold text-on-surface text-sm truncate">${d.donorName}</span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                    ✅ Terverifikasi
                                </span>
                            </div>
                            <p class="font-caption text-caption text-on-surface-variant truncate mt-0.5">
                                Berdonasi untuk: <strong class="text-primary font-bold">${d.program}</strong>
                            </p>
                            <span class="text-[11px] text-outline flex items-center gap-1 mt-0.5">
                                <span class="material-symbols-outlined text-[12px]">schedule</span> ${d.timeAgo}
                                <span>•</span>
                                <span class="font-semibold text-on-surface-variant">${d.wilayah}</span>
                            </span>
                        </div>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="font-label-md text-sm font-extrabold text-primary font-mono block tracking-tight">
                            ${fmt(d.amount)}
                        </span>
                        <span class="text-[10px] text-outline uppercase font-semibold">${d.method}</span>
                    </div>
                </div>`;
            }).join('');
        }

        let currentInfakWilayah = 'Pangkalpinang';
        let currentSimAmount = 100000;

        function switchInfakUmumWilayah(wilayah, btn) {
            currentInfakWilayah = wilayah;
            document.querySelectorAll('.infak-tab-btn').forEach(b => {
                b.className = 'infak-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-on-surface-variant hover:text-primary';
            });
            if (btn) {
                btn.className = 'infak-tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all bg-primary text-white shadow-xs';
            }
            renderInfakUmumDistributionWidget();
        }

        function handleHomeSimulationChange(val) {
            currentSimAmount = Number(val) || 0;
            renderInfakUmumDistributionWidget();
        }

        function setHomeSimAmount(val) {
            currentSimAmount = Number(val) || 0;
            const input = document.getElementById('home-sim-amount');
            if (input) input.value = currentSimAmount;
            renderInfakUmumDistributionWidget();
        }

        function renderInfakUmumDistributionWidget() {
            if (!window.wizStore) return;
            const chartContainer = document.getElementById('home-infak-chart-container');
            const pillarsContainer = document.getElementById('home-infak-pillars-container');
            const ctaBtn = document.getElementById('home-infak-cta-btn');
            if (!chartContainer || !pillarsContainer) return;

            const fmt = wizStore.utils.formatRupiahCompact;
            const wilayah = currentInfakWilayah;

            if (ctaBtn) {
                ctaBtn.href = `/donasi?type=Infak%20Umum&wilayah=${encodeURIComponent(wilayah === 'Semua' ? 'Pangkalpinang' : wilayah)}`;
                ctaBtn.querySelector('span:last-child').textContent = `Salurkan Infak Umum (${wilayah === 'Semua' ? 'Bangka Belitung' : wilayah})`;
            }

            const allocItems = wizStore.calcInfakUmumAllocation(currentSimAmount, wilayah === 'Semua' ? 'Pangkalpinang' : wilayah) || [];
            
            const pillarMeta = {
                'Berkah Hidayah': { label: 'Dakwah & Pembinaan', color: '#047857', bg: 'bg-emerald-50 border-emerald-200 text-emerald-950', dot: 'bg-emerald-600', icon: 'auto_stories' },
                'Berkah Juara': { label: 'Pendidikan & Beasiswa', color: '#0284c7', bg: 'bg-sky-50 border-sky-200 text-sky-950', dot: 'bg-sky-600', icon: 'school' },
                'Berkah Peduli': { label: 'Sosial & Kemanusiaan', color: '#ea580c', bg: 'bg-amber-50 border-amber-200 text-amber-950', dot: 'bg-amber-600', icon: 'favorite' },
                'Berkah Sehat': { label: 'Kesehatan & Ambulance', color: '#0d9488', bg: 'bg-teal-50 border-teal-200 text-teal-950', dot: 'bg-teal-600', icon: 'medical_services' },
                'Berkah Mandiri': { label: 'Ekonomi & Pemberdayaan', color: '#7e22ce', bg: 'bg-purple-50 border-purple-200 text-purple-950', dot: 'bg-purple-600', icon: 'storefront' },
                'Dana Saving': { label: 'Dana Cadangan Program', color: '#475569', bg: 'bg-slate-50 border-slate-200 text-slate-900', dot: 'bg-slate-600', icon: 'savings' },
                'Operasional': { label: 'Operasional Cabang', color: '#64748b', bg: 'bg-slate-50 border-slate-200 text-slate-900', dot: 'bg-slate-600', icon: 'settings' }
            };

            const circumference = 2 * Math.PI * 65;
            let accumulatedOffset = 0;
            const totalPct = allocItems.reduce((sum, item) => sum + (Number(item.percent) || 0), 0) || 100;

            const strokeSegments = allocItems.map(item => {
                const pct = Number(item.percent) || 0;
                const strokeLength = (pct / totalPct) * circumference;
                const meta = pillarMeta[item.key] || { color: '#008444' };
                const seg = `<circle cx="80" cy="80" r="65" fill="none" stroke="${meta.color}" stroke-width="22" 
                    stroke-dasharray="${strokeLength.toFixed(1)} ${(circumference - strokeLength).toFixed(1)}" 
                    stroke-dashoffset="${(-accumulatedOffset).toFixed(1)}" class="transition-all duration-700 hover:opacity-85 cursor-pointer"></circle>`;
                accumulatedOffset += strokeLength;
                return seg;
            }).join('');

            chartContainer.innerHTML = `
                <div class="relative flex items-center justify-center">
                    <svg width="200" height="200" viewBox="0 0 160 160" class="transform -rotate-90">
                        <circle cx="80" cy="80" r="65" fill="none" stroke="#f1f5f9" stroke-width="22"></circle>
                        ${strokeSegments}
                    </svg>
                    <div class="absolute flex flex-col items-center justify-center text-center p-2">
                        <span class="font-caption text-[11px] text-on-surface-variant font-semibold">Infak Disimulasikan</span>
                        <span class="font-headline-md font-extrabold text-primary text-base">${fmt(currentSimAmount)}</span>
                        <span class="text-[10px] text-outline font-semibold">Alokasi 100% Valid</span>
                    </div>
                </div>
            `;

            pillarsContainer.innerHTML = allocItems.map(item => {
                const meta = pillarMeta[item.key] || { label: item.key, bg: 'bg-slate-50 border-slate-200 text-slate-900', dot: 'bg-primary', icon: 'category' };
                const subItems = item.subAllocation && item.subAllocation.items ? item.subAllocation.items.map(si => si.key).slice(0, 3).join(', ') : '';

                return `
                <div class="p-3.5 rounded-2xl border ${meta.bg} flex items-center justify-between gap-3 shadow-xs hover:shadow-sm transition-all">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-white/80 border border-white flex items-center justify-center shrink-0 text-primary shadow-xs">
                            <span class="material-symbols-outlined text-xl">${meta.icon}</span>
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <h4 class="font-bold text-xs sm:text-sm text-on-surface truncate">${item.key}</h4>
                                <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-white border border-outline-variant/40 text-primary shrink-0">${item.percent}%</span>
                            </div>
                            <p class="text-[11px] opacity-80 truncate mt-0.5">${meta.label} ${subItems ? `• <span class="italic text-[10px]">(${subItems})</span>` : ''}</p>
                        </div>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="text-[10px] uppercase opacity-75 font-semibold block">Porsi Dana</span>
                        <span class="font-headline-md font-mono font-bold text-xs sm:text-sm text-primary block">${fmt(item.amount)}</span>
                    </div>
                </div>`;
            }).join('');
        }

        function renderHomeFeaturedPrograms() {
            const grid = document.getElementById('home-featured-programs-grid');
            if (!grid || !window.wizStore) return;

            let displayList = [];

            if (window.wizStore.programs && typeof window.wizStore.programs.getPublished === 'function') {
                const published = window.wizStore.programs.getPublished();
                if (published && published.length > 0) {
                    displayList = published.slice(0, 6).map(p => ({
                        title: p.title,
                        pillar: p.pillar,
                        desc: p.description || `Salurkan kepedulian dan donasi terbaik Anda untuk program ${p.title} bersama WIZ Babel.`,
                        img: p.imageUrl || (window.wizStore.allocationRulesManager ? window.wizStore.allocationRulesManager.getSpecificProgramImage(p.title, p.pillar) : '/assets/images/foto-utama-wiz.jpg'),
                        targetAmount: p.targetAmount || 50000000
                    }));
                }
            }

            if (displayList.length === 0) {
                const basePrograms = [
                    { title: 'Sedekah Beras Dhuafa', pillar: 'Sosial', desc: 'Bantuan kebutuhan pokok untuk lansia dan keluarga pra-sejahtera.', defaultImg: '/assets/images/sedekah-beras-dhuafa.jpg' },
                    { title: "Beasiswa Tahfidz Qur'an", pillar: 'Pendidikan', desc: 'Beasiswa penuh bagi santri penghafal Al-Qur\'an yatim dhuafa.', defaultImg: '/assets/images/beasiswa-tahfidz.jpg' },
                    { title: 'Beasiswa Pendidikan Juara', pillar: 'Pendidikan', desc: 'Bantuan biaya sekolah dan kelengkapan perlengkapan belajar.', defaultImg: '/assets/images/beasiswa-pendidikan-juara.jpg' }
                ];

                basePrograms.forEach(b => {
                    displayList.push({
                        title: b.title,
                        pillar: b.pillar,
                        desc: b.desc,
                        img: b.defaultImg,
                        targetAmount: 50000000
                    });
                });
            }

            if (displayList.length > 0) {
                grid.innerHTML = displayList.map(item => {
                    const stats = (window.wizStore && window.wizStore.finance) 
                        ? window.wizStore.finance.getSpecificProgramStats(item.title, 0, item.targetAmount || 15000000) 
                        : { percent: 0, saldo: 0, terkumpul: 0 };
                    const fmt = (window.wizStore && window.wizStore.utils) 
                        ? window.wizStore.utils.formatRupiahCompact 
                        : (v => 'Rp 0');

                    return `
                    <article data-title="${escapeHtml(item.title)}" class="program-card bg-surface rounded-xl overflow-hidden shadow-level-1 hover:shadow-level-2 transition-all border border-surface-variant flex flex-col">
                        <div class="relative aspect-video overflow-hidden">
                            <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" src="${escapeHtml(item.img)}" onerror="this.onerror=null; this.src='/assets/images/foto-utama-wiz.jpg';" alt="${escapeHtml(item.title)}"/>
                            <span class="absolute top-sm left-sm bg-primary text-on-primary font-caption text-caption px-sm py-xs rounded-full font-semibold">${escapeHtml(item.pillar)}</span>
                        </div>
                        <div class="p-lg flex flex-col flex-grow">
                            <h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-xs">${escapeHtml(item.title)}</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant mb-md flex-grow line-clamp-2">${escapeHtml(item.desc)}</p>
                            <div class="mb-lg space-y-xs">
                                <div class="flex justify-between font-caption text-caption text-on-surface-variant">
                                    <span>Terkumpul: <strong>${fmt(stats.terkumpul || stats.saldo)}</strong></span>
                                    <span class="font-semibold text-primary">${stats.percent}%</span>
                                </div>
                                <div class="w-full bg-surface-variant rounded-full h-2">
                                    <div class="bg-primary h-2 rounded-full" style="width: ${stats.percent}%"></div>
                                </div>
                            </div>
                            <div class="mt-auto">
                                <button onclick="openDonationModal('${escapeHtml(item.title)}')" class="w-full bg-[#F7941D] text-white font-label-md text-label-md py-sm rounded-lg hover:opacity-90 transition-opacity font-bold cursor-pointer">Donasi Sekarang</button>
                            </div>
                        </div>
                    </article>`;
                }).join('');
            }
        }

        document.addEventListener('DOMContentLoaded', async () => {
            if (typeof initDynamicSiteImages === 'function') initDynamicSiteImages();
            renderPublicNews();
            fetchFreshNewsDirectly();
            renderHomeFeaturedPrograms();
            updateDynamicProgramCards();
            renderVerifiedDonors();
            renderInfakUmumDistributionWidget();

            const urlParams = new URLSearchParams(window.location.search);
            const targetNewsId = urlParams.get('newsId');
            if (targetNewsId) {
                setTimeout(() => openPublicNewsModal(targetNewsId), 200);
            }

            if (window.wizStore && window.wizStore.syncFromCloud) {
                try {
                    await window.wizStore.syncFromCloud(true);
                } catch(e) {}
                if (typeof initDynamicSiteImages === 'function') initDynamicSiteImages();
                renderPublicNews();
                renderHomeFeaturedPrograms();
                updateDynamicProgramCards();
                renderVerifiedDonors();
                renderInfakUmumDistributionWidget();
                if (typeof window.applySiteSettings === 'function') window.applySiteSettings();
                if (targetNewsId) {
                    openPublicNewsModal(targetNewsId);
                }
            }
        });

        window.addEventListener('wiz-sync-complete', () => {
            if (typeof initDynamicSiteImages === 'function') initDynamicSiteImages();
            renderPublicNews();
            renderHomeFeaturedPrograms();
            if (typeof updateDynamicProgramCards === 'function') updateDynamicProgramCards();
            if (typeof renderVerifiedDonors === 'function') renderVerifiedDonors();
            if (typeof renderInfakUmumDistributionWidget === 'function') renderInfakUmumDistributionWidget();
        });

        window.addEventListener('wiz-news-changed', () => {
            renderPublicNews();
        });

        window.addEventListener('wiz-programs-changed', () => {
            if (typeof initDynamicSiteImages === 'function') initDynamicSiteImages();
            renderHomeFeaturedPrograms();
            if (typeof updateDynamicProgramCards === 'function') updateDynamicProgramCards();
            if (typeof renderInfakUmumDistributionWidget === 'function') renderInfakUmumDistributionWidget();
        });
    </script>
</BaseLayout>
