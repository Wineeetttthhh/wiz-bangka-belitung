        function handleDonationSubmit(event) {
            event.preventDefault();
            const nominalInput = document.getElementById('shared-nominal-input') || document.getElementById('nominal-input');
            const nominal = nominalInput ? (nominalInput.value || '50000') : '50000';
            const name = document.getElementById('shared-donor-name')?.value || document.getElementById('donor-name')?.value || 'Hamba Allah';
            const phone = document.getElementById('shared-donor-phone')?.value || document.getElementById('donor-phone')?.value || '';
            const msg = document.getElementById('shared-donor-message')?.value || document.getElementById('donor-message')?.value || '';
            const modalTitle = document.getElementById('modal-program-title');
            const prog = modalTitle ? modalTitle.textContent : 'Donasi';

            const cleanProg = prog.replace('Formulir Donasi', '').replace('Donasi Program:', '').trim() || 'Infak Umum';
            const targetUrl = `/donasi?program=${encodeURIComponent(cleanProg)}&nominal=${encodeURIComponent(nominal)}&name=${encodeURIComponent(name)}&phone=${encodeURIComponent(phone)}&msg=${encodeURIComponent(msg)}`;
            
            closeDonationModal();
            window.location.href = targetUrl;
        }

        function calculateZakat() {
            const incomeInput = document.getElementById('zakat-income');
            const zakatResult = document.getElementById('zakat-result');
            const zakatAmount = document.getElementById('zakat-amount');

            const val = parseFloat(incomeInput?.value) || 0;
            if (val > 0) {
                const zakat = Math.round(val * 0.025);
                if (zakatAmount) zakatAmount.textContent = `Rp ${zakat.toLocaleString('id-ID')}`;
                if (zakatResult) zakatResult.classList.remove('hidden');
            } else {
                alert('Silakan masukkan nominal penghasilan atau simpanan Anda.');
            }
        }

