                        <h3 class="text-base sm:text-lg font-black text-slate-900 line-clamp-1 group-hover:text-emerald-700 transition-colors" title="${escapeHtml(item.displayTitle || item.title)}">${escapeHtml(item.displayTitle || item.title)}</h3>
                        <p class="text-xs sm:text-sm text-slate-600 flex-grow line-clamp-2 leading-relaxed">${escapeHtml(item.desc)}</p>
                        <div class="space-y-1 pt-1">
                            <div class="flex justify-between text-xs text-slate-600 font-semibold">
                                <span>Terkumpul: <strong class="text-slate-900">${fmt(stats.terkumpul || stats.saldo || 0)}</strong></span>
                                <span class="font-bold text-emerald-700">${stats.percent || 0}%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                <div class="${item.barColor} h-2 rounded-full transition-all duration-500" style="width: ${Math.min(100, stats.percent || 0)}%"></div>
                            </div>
                        </div>
                        <a href="${donasiUrl}" class="w-full block bg-[#F7941D] hover:bg-[#ea7e00] text-white py-2.5 sm:py-3 rounded-xl hover:opacity-95 transition-opacity font-extrabold text-xs sm:text-sm text-center cursor-pointer shadow-xs active:scale-98">Donasi Sekarang</a>
                    </div>
                </article>`;
            }).join('');
        }

        document.addEventListener('DOMContentLoaded', async () => {
            if (typeof initDynamicSiteImages === 'function') initDynamicSiteImages();
            renderPublicNews();
            fetchFreshNewsDirectly();
            renderHomeFeaturedPrograms();
            updateDynamicProgramCards();
            renderVerifiedDonors();
            renderInfakUmumDistributionWidget();

            const urlParams = new URLSearchParams(window.location.search);
            const targetNewsId = urlParams.get('newsId');
            if (targetNewsId) {
                setTimeout(() => openPublicNewsModal(targetNewsId), 200);
            }

            if (window.wizStore && window.wizStore.syncFromCloud) {
                try {
                    await window.wizStore.syncFromCloud(true);
                } catch(e) {}
                if (typeof initDynamicSiteImages === 'function') initDynamicSiteImages();
                renderPublicNews();
                renderHomeFeaturedPrograms();
                updateDynamicProgramCards();
                renderVerifiedDonors();
                renderInfakUmumDistributionWidget();
                if (typeof window.applySiteSettings === 'function') window.applySiteSettings();
                if (targetNewsId) {
                    openPublicNewsModal(targetNewsId);
                }
            }
        });

        window.addEventListener('wiz-sync-complete', () => {
            if (typeof initDynamicSiteImages === 'function') initDynamicSiteImages();
            renderPublicNews();
            renderHomeFeaturedPrograms();
            if (typeof updateDynamicProgramCards === 'function') updateDynamicProgramCards();
            if (typeof renderVerifiedDonors === 'function') renderVerifiedDonors();
            if (typeof renderInfakUmumDistributionWidget === 'function') renderInfakUmumDistributionWidget();
        });

        window.addEventListener('wiz-news-changed', () => {
            renderPublicNews();
        });

        window.addEventListener('wiz-programs-changed', () => {
            if (typeof initDynamicSiteImages === 'function') initDynamicSiteImages();
            renderHomeFeaturedPrograms();
            if (typeof updateDynamicProgramCards === 'function') updateDynamicProgramCards();
            if (typeof renderInfakUmumDistributionWidget === 'function') renderInfakUmumDistributionWidget();
        });
    </script>
</BaseLayout>
