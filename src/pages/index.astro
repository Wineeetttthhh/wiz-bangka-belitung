    <!-- Page Scripts matching index.html -->
    <script is:inline>
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        let currentShareArticle = null;

        function shareArticle(platform) {
            if (!currentShareArticle) return;
            const activeRef = (typeof getActiveAffiliateRef === 'function' ? getActiveAffiliateRef() : '') || (new URLSearchParams(window.location.search).get('ref') || '');
            const baseOrigin = window.location.origin;
            const title = currentShareArticle.title || 'Berita WIZ Bangka Belitung';

            const articleUrl = new URL(`${baseOrigin}/berita/${encodeURIComponent(currentShareArticle.id)}`);
            if (activeRef) {
                articleUrl.searchParams.set('ref', activeRef);
            }

            const finalShareUrl = articleUrl.toString();
            if (platform === 'wa') {
                if (typeof window.showWhatsAppShareToast === 'function') {
                    window.showWhatsAppShareToast('Tunggu 1–2 detik di WhatsApp hingga kartu preview gambar muncul sebelum kirim Status ✨');
                }
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(finalShareUrl)}`, '_blank');
            } else if (platform === 'fb') {
                window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(finalShareUrl)}`, '_blank');
            } else if (platform === 'tw') {
                window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(finalShareUrl)}`, '_blank');
            } else if (platform === 'tg') {
                window.open(`https://t.me/share/url?url=${encodeURIComponent(finalShareUrl)}&text=${encodeURIComponent(title)}`, '_blank');
            } else if (platform === 'copy') {
                navigator.clipboard.writeText(finalShareUrl).then(() => {
                    const toast = document.getElementById('share-toast');
                    if (toast) {
                        toast.classList.remove('hidden');
                        setTimeout(() => toast.classList.add('hidden'), 3000);
                    } else {
                        alert('Tautan berita berhasil disalin ke clipboard!');
                    }
                });
            }
        }

        let isFetchingHomeNews = false;
        async function fetchFreshNewsDirectly() {
            if (isFetchingHomeNews) return;
            isFetchingHomeNews = true;
            try {
                let fetchedNews = null;

                // 1. Try Supabase REST query
                if (window.wizSupabase && window.wizSupabase.isConfigured()) {
                    try {
                        const res = await window.wizSupabase.select('news', { select: 'id,title,category,content,image_url,gallery,event_date,status,author,created_at,updated_at', order: 'created_at.desc' });
                        if (res && Array.isArray(res.data) && res.data.length > 0) {
                            fetchedNews = res.data;
                        }
                    } catch(e) {}
                }

                // 2. Fallback to /api/sync if Supabase was empty
                if (!fetchedNews) {
                    try {
                        const syncRes = await fetch('/api/sync', { cache: 'no-cache' });
                        if (syncRes.ok) {
                            const json = await syncRes.json();
                            const newsArr = json.data ? json.data.news : json.news;
                            if (Array.isArray(newsArr) && newsArr.length > 0) {
                                fetchedNews = newsArr;
                            }
                        }
                    } catch(e) {}
                }

                if (Array.isArray(fetchedNews) && fetchedNews.length > 0) {
                    const mapped = fetchedNews.map(n => {
                        const mainImg = (n.image_url || (Array.isArray(n.gallery) && n.gallery.length > 0 ? n.gallery[0] : '') || n.imageUrl || '').trim();
                        return {
                            id: String(n.id),
                            title: n.title,
                            category: n.category || 'Kegiatan & Penyaluran',
                            content: n.content,
                            imageUrl: mainImg,
                            image_url: mainImg,
                            gallery: Array.isArray(n.gallery) ? n.gallery : [],
                            eventDate: n.event_date || n.eventDate || n.created_at || n.createdAt,
                            event_date: n.event_date || n.eventDate || n.created_at || n.createdAt,
                            status: n.status || 'published',
                            author: n.author || 'Super Admin 1 (WIZ Babel)',
                            createdAt: n.created_at || n.createdAt || new Date().toISOString(),
                            created_at: n.created_at || n.createdAt || new Date().toISOString(),
                            updatedAt: n.updated_at || n.updatedAt || new Date().toISOString(),
                            updated_at: n.updated_at || n.updatedAt || new Date().toISOString()
                        };
                    });
                    mapped.sort((a, b) => {
                        const timeA = new Date(a.eventDate || a.event_date || a.createdAt || a.created_at || 0).getTime();
                        const timeB = new Date(b.eventDate || b.event_date || b.createdAt || b.created_at || 0).getTime();
                        return timeB - timeA;
                    });
                    localStorage.setItem('wiz_news', JSON.stringify(mapped));
                    if (window.wizStore && window.wizStore.news) {
                        renderPublicNews();
                    }
                }
            } catch(e) {
                console.warn('[News Sync Warning]', e);
            } finally {
                isFetchingHomeNews = false;
            }
        }
        function renderPublicNews() {
            if (!window.wizStore) return;
            const allPublished = wizStore.news.getPublished();
            const publishedNews = (allPublished || []).slice(0, 6);
            const grid = document.getElementById('public-news-grid');
            if (!grid) return;

            if (publishedNews.length === 0) {
                fetchFreshNewsDirectly();
                grid.innerHTML = `
                <div class="col-span-1 md:col-span-3 text-center py-xl bg-surface-container-low rounded-2xl border border-dashed border-outline-variant/50 p-lg space-y-sm">
                    <span class="material-symbols-outlined text-4xl text-primary/60">feed</span>
                    <p class="font-headline-md text-on-surface font-bold">Belum Ada Berita Terbaru</p>
                    <p class="font-caption text-caption text-on-surface-variant max-w-md mx-auto">Dokumentasi kegiatan dan berita penyaluran akan segera diperbarui.</p>
                </div>`;
                return;
            }

            const defaultImg = '/assets/images/sedekah-beras-dhuafa.jpg';

            grid.innerHTML = publishedNews.map(n => {
                const galCount = Array.isArray(n.gallery) ? n.gallery.filter(Boolean).length : 0;
                const rawImg = (n.imageUrl || n.image_url || '').trim();
                const firstGal = (Array.isArray(n.gallery) && n.gallery.length > 0 && typeof n.gallery[0] === 'string') ? n.gallery[0].trim() : '';
                const cardImg = rawImg || firstGal || defaultImg;
                const articleUrl = `/berita/${encodeURIComponent(n.slug || n.id)}`;

                return `
                <article class="bg-surface rounded-2xl overflow-hidden shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all border border-surface-variant flex flex-col group">
                    <a href="${articleUrl}" class="relative aspect-video overflow-hidden bg-surface-container block w-full">
                        <img src="${cardImg}" onerror="this.src='${defaultImg}'" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 block" style="object-fit: cover; width: 100%; height: 100%; display: block;" alt="${n.title}" loading="lazy">
                        <span class="absolute top-3 left-3 bg-[#006834] text-white text-[11px] px-3 py-1 rounded-full font-bold shadow-sm">${n.category || 'Kegiatan & Penyaluran'}</span>
                        ${galCount > 0 ? `
                        <span class="absolute bottom-3 right-3 bg-black/75 backdrop-blur-xs text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold shadow-sm flex items-center gap-1">
                            <span class="material-symbols-outlined text-xs">collections</span>
                            <span>+${galCount} foto</span>
                        </span>` : ''}
                    </a>
                    <div class="p-4 sm:p-5 flex flex-col flex-grow space-y-2">
                        <div class="flex items-center text-[#006834] text-xs font-semibold gap-1.5 flex-wrap">
                            <span class="material-symbols-outlined text-sm">event</span>
                            <span>Kegiatan: ${wizStore.utils.formatDate(n.eventDate || n.event_date || n.createdAt || n.created_at)}</span>
                            <span class="text-slate-400">• Oleh: ${n.author || 'Super Admin 1 (WIZ Babel)'}</span>
                        </div>
                        <h3 class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-[#008444] transition-colors line-clamp-2 leading-snug">
                            <a href="${articleUrl}">${n.title}</a>
                        </h3>
                        <p class="text-xs sm:text-[13px] text-slate-600 line-clamp-3 flex-grow leading-relaxed">
                            <a href="${articleUrl}" class="text-slate-600 hover:text-slate-900">${n.content}</a>
                        </p>
                        
                        <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-2">
                            <a href="${articleUrl}" class="text-[#008444] text-xs font-bold flex items-center gap-1 hover:underline cursor-pointer">
                                <span>Baca Selengkapnya</span>
                                <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
                            </a>
                            <button type="button" onclick="currentShareArticle = wizStore.news.getById('${n.id}'); shareArticle('wa');" title="Bagikan ke WhatsApp" class="text-slate-400 hover:text-[#25D366] transition-colors p-1.5 rounded-lg flex items-center justify-center cursor-pointer hover:bg-slate-100">
                                <span class="material-symbols-outlined text-base">share</span>
                            </button>
                        </div>
                    </div>
                </article>`;
            }).join('');
        }

        function openPublicNewsModal(id) {
            if (!window.wizStore) return;
            const article = wizStore.news.getById(id);
            if (!article) return;
            currentShareArticle = article;

            const defaultImg = '/assets/images/sedekah-beras-dhuafa.jpg';
            const rawImg = (article.imageUrl || article.image_url || '').trim();
            const firstGal = (Array.isArray(article.gallery) && article.gallery.length > 0 && typeof article.gallery[0] === 'string') ? article.gallery[0].trim() : '';
            const modalImg = rawImg || firstGal || defaultImg;

            const imgEl = document.getElementById('pub-modal-image');
