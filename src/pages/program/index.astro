---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MASTER_PROGRAMS } from '../../lib/programs-data';
---

<BaseLayout
    title="Daftar Program - WIZ Bangka Belitung"
    description="Jelajahi berbagai program kebaikan Wahdah Inspirasi Zakat (WIZ) Bangka Belitung dalam bidang Dakwah, Sosial, Pendidikan, Kesehatan, dan Ekonomi."
    image="/assets/images/foto-utama-wiz.jpg"
>
    <!-- Header Section -->
    <header class="bg-surface-container-low py-xxl border-b border-surface-variant">
        <div class="max-w-container-max mx-auto px-margin-mobile md:px-lg text-center flex flex-col items-center">
            <span class="inline-flex items-center gap-xs bg-primary-container/10 text-primary-container px-md py-xs rounded-full font-label-md text-caption uppercase tracking-wider mb-sm font-bold">
                <span class="material-symbols-outlined text-sm">auto_awesome</span>
                Kebaikan Berkelanjutan
            </span>
            <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-background mb-md font-bold">
                Jelajahi Program Kebaikan
            </h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto mb-lg">
                Salurkan niat baik Anda melalui berbagai program unggulan yang kami jalankan dengan amanah, transparan, dan profesional untuk kemaslahatan umat.
            </p>

            <!-- Search and Filter -->
            <div class="w-full max-w-2xl mx-auto space-y-md">
                <div class="relative w-full">
                    <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline">search</span>
                    <input id="program-search" class="w-full bg-surface border border-outline-variant rounded-full py-sm pl-xxl pr-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all shadow-sm" placeholder="Cari program donasi (misal: Tahfidz, Sembako, Mualaf)..." type="text"/>
                </div>
                
                <div class="flex flex-row flex-wrap justify-center items-center gap-2 mt-md" id="category-filter-buttons">
                    <button data-category="all" class="category-btn active inline-flex items-center whitespace-nowrap px-4 py-1.5 rounded-full border border-primary bg-primary text-on-primary text-sm font-semibold transition-colors shadow-sm cursor-pointer">Semua Kategori</button>
                    <button data-category="dakwah" class="category-btn inline-flex items-center whitespace-nowrap px-4 py-1.5 rounded-full border border-outline-variant bg-surface text-on-surface-variant text-sm font-semibold hover:border-primary hover:text-primary transition-colors cursor-pointer">Dakwah</button>
                    <button data-category="sosial" class="category-btn inline-flex items-center whitespace-nowrap px-4 py-1.5 rounded-full border border-outline-variant bg-surface text-on-surface-variant text-sm font-semibold hover:border-primary hover:text-primary transition-colors cursor-pointer">Sosial</button>
                    <button data-category="pendidikan" class="category-btn inline-flex items-center whitespace-nowrap px-4 py-1.5 rounded-full border border-outline-variant bg-surface text-on-surface-variant text-sm font-semibold hover:border-primary hover:text-primary transition-colors cursor-pointer">Pendidikan</button>
                    <button data-category="kesehatan" class="category-btn inline-flex items-center whitespace-nowrap px-4 py-1.5 rounded-full border border-outline-variant bg-surface text-on-surface-variant text-sm font-semibold hover:border-primary hover:text-primary transition-colors cursor-pointer">Kesehatan</button>
                    <button data-category="ekonomi" class="category-btn inline-flex items-center whitespace-nowrap px-4 py-1.5 rounded-full border border-outline-variant bg-surface text-on-surface-variant text-sm font-semibold hover:border-primary hover:text-primary transition-colors cursor-pointer">Ekonomi</button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="w-full pb-xxl flex-grow">

        <!-- Section 1: Berkah Hidayah (Dakwah) -->
        <section class="program-section max-w-container-max mx-auto px-margin-mobile md:px-lg py-xl" data-section-category="dakwah">
            <div class="flex items-center gap-sm mb-lg">
                <span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">mosque</span>
                <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold">BERKAH HIDAYAH <span class="font-body-md text-body-md text-on-surface-variant ml-xs font-normal">(Dakwah &amp; Pembinaan)</span></h2>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
                {MASTER_PROGRAMS.filter(p => p.pillar.includes('Dakwah') || p.pillar.includes('Hidayah')).map(program => {
                    const col = Number(program.collected || 0);
                    const tgt = Number(program.target || 1);
                    const pct = Math.min(100, Math.round((col / tgt) * 100));
                    return (
                        <article class="program-card bg-surface rounded-xl overflow-hidden shadow-ambient-1 hover:shadow-ambient-2 transition-all duration-300 border border-surface-variant flex flex-col h-full" data-category="dakwah" data-title={program.title}>
                            <div class="relative overflow-hidden aspect-[3/4] bg-slate-100">
                                <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt={program.title} src={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} onerror="this.onerror=null; this.src='/assets/images/default-program-wiz.jpg';" alt={program.title}/>
                                <span class="absolute top-sm left-sm bg-primary/90 text-on-primary font-caption text-caption px-sm py-xs rounded-full font-semibold">Dakwah</span>
                            </div>
                            <div class="p-lg flex flex-col flex-grow">
                                <h3 class="font-headline-md text-headline-md text-on-surface mb-xs font-bold">{program.title}</h3>
                                <p class="font-body-md text-body-md text-on-surface-variant mb-md flex-grow line-clamp-3">{program.description}</p>
                                <div class="mb-lg space-y-xs">
                                    <div class="flex justify-between font-caption text-caption text-on-surface-variant">
                                        <span>Terkumpul: <strong>Rp {col.toLocaleString('id-ID')}</strong></span>
                                        <span class="font-semibold text-primary">{pct}%</span>
                                    </div>
                                    <div class="w-full bg-surface-variant rounded-full h-2 overflow-hidden">
                                        <div class="bg-tertiary-container h-2 rounded-full transition-all duration-500" style={`width: ${pct}%`}></div>
                                    </div>
                                    <div class="text-right font-caption text-caption text-outline">Target: Rp {tgt.toLocaleString('id-ID')}</div>
                                </div>
                                <div class="mt-auto flex items-center gap-2">
                                    <a href={`/donasi?program=${encodeURIComponent(program.slug)}`} class="flex-1 block bg-secondary-container text-on-secondary font-label-md text-label-md py-sm rounded-lg hover:bg-secondary transition-colors text-center shadow-sm font-bold">Donasi Sekarang</a>
                                    <button type="button" class="program-card-share-btn inline-flex items-center justify-center p-2.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 transition-colors shrink-0 shadow-xs cursor-pointer" data-slug={program.slug} data-title={program.title} data-pillar={program.pillar} data-image={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} data-desc={program.description} title="Bagikan Link Mitra">
                                        <span class="material-symbols-outlined text-[20px]">share</span>
                                    </button>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
        </section>

        <!-- Section 2: Berkah Peduli (Sosial) -->
        <section class="program-section max-w-container-max mx-auto px-margin-mobile md:px-lg py-xl border-t border-surface-variant/50" data-section-category="sosial">
            <div class="flex items-center gap-sm mb-lg">
                <span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold">BERKAH PEDULI <span class="font-body-md text-body-md text-on-surface-variant ml-xs font-normal">(Sosial &amp; Kemanusiaan)</span></h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
                {MASTER_PROGRAMS.filter(p => p.pillar.includes('Sosial') || p.pillar.includes('Peduli')).map(program => {
                    const col = Number(program.collected || 0);
                    const tgt = Number(program.target || 1);
                    const pct = Math.min(100, Math.round((col / tgt) * 100));
                    return (
                        <article class="program-card bg-surface rounded-xl overflow-hidden shadow-ambient-1 hover:shadow-ambient-2 transition-all duration-300 border border-surface-variant flex flex-col h-full" data-category="sosial" data-title={program.title}>
                            <div class="relative overflow-hidden aspect-[3/4] bg-slate-100">
                                <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt={program.title} src={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} onerror="this.onerror=null; this.src='/assets/images/default-program-wiz.jpg';" alt={program.title}/>
                                <span class="absolute top-sm left-sm bg-tertiary-container/90 text-on-tertiary font-caption text-caption px-sm py-xs rounded-full font-semibold">Sosial</span>
                            </div>
                            <div class="p-lg flex flex-col flex-grow">
                                <h3 class="font-headline-md text-headline-md text-on-surface mb-xs font-bold">{program.title}</h3>
                                <p class="font-body-md text-body-md text-on-surface-variant mb-md flex-grow line-clamp-3">{program.description}</p>
                                <div class="mb-lg space-y-xs">
                                    <div class="flex justify-between font-caption text-caption text-on-surface-variant">
                                        <span>Terkumpul: <strong>Rp {col.toLocaleString('id-ID')}</strong></span>
                                        <span class="font-semibold text-primary">{pct}%</span>
                                    </div>
                                    <div class="w-full bg-surface-variant rounded-full h-2 overflow-hidden">
                                        <div class="bg-tertiary-container h-2 rounded-full transition-all duration-500" style={`width: ${pct}%`}></div>
                                    </div>
                                    <div class="text-right font-caption text-caption text-outline">Target: Rp {tgt.toLocaleString('id-ID')}</div>
                                </div>
                                <div class="mt-auto flex items-center gap-2">
                                    <a href={`/donasi?program=${encodeURIComponent(program.slug)}`} class="flex-1 block bg-secondary-container text-on-secondary font-label-md text-label-md py-sm rounded-lg hover:bg-secondary transition-colors text-center shadow-sm font-bold">Donasi Sekarang</a>
                                    <button type="button" class="program-card-share-btn inline-flex items-center justify-center p-2.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 transition-colors shrink-0 shadow-xs cursor-pointer" data-slug={program.slug} data-title={program.title} data-pillar={program.pillar} data-image={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} data-desc={program.description} title="Bagikan Link Mitra">
                                        <span class="material-symbols-outlined text-[20px]">share</span>
                                    </button>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
        </section>

        <!-- Section 3: Berkah Juara (Pendidikan) -->
        <section class="program-section max-w-container-max mx-auto px-margin-mobile md:px-lg py-xl border-t border-surface-variant/50" data-section-category="pendidikan">
            <div class="flex items-center gap-sm mb-lg">
                <span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">school</span>
                <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold">BERKAH JUARA <span class="font-body-md text-body-md text-on-surface-variant ml-xs font-normal">(Pendidikan &amp; Beasiswa)</span></h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
                {MASTER_PROGRAMS.filter(p => p.pillar.includes('Pendidikan') || p.pillar.includes('Juara')).map(program => {
                    const col = Number(program.collected || 0);
                    const tgt = Number(program.target || 1);
                    const pct = Math.min(100, Math.round((col / tgt) * 100));
                    return (
                        <article class="program-card bg-surface rounded-xl overflow-hidden shadow-ambient-1 hover:shadow-ambient-2 transition-all duration-300 border border-surface-variant flex flex-col h-full" data-category="pendidikan" data-title={program.title}>
                            <div class="relative overflow-hidden aspect-[3/4] bg-slate-100">
                                <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt={program.title} src={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} onerror="this.onerror=null; this.src='/assets/images/default-program-wiz.jpg';" alt={program.title}/>
                                <span class="absolute top-sm left-sm bg-primary/90 text-on-primary font-caption text-caption px-sm py-xs rounded-full font-semibold">Pendidikan</span>
                            </div>
                            <div class="p-lg flex flex-col flex-grow">
                                <h3 class="font-headline-md text-headline-md text-on-surface mb-xs font-bold">{program.title}</h3>
                                <p class="font-body-md text-body-md text-on-surface-variant mb-md flex-grow line-clamp-3">{program.description}</p>
                                <div class="mb-lg space-y-xs">
                                    <div class="flex justify-between font-caption text-caption text-on-surface-variant">
                                        <span>Terkumpul: <strong>Rp {col.toLocaleString('id-ID')}</strong></span>
                                        <span class="font-semibold text-primary">{pct}%</span>
                                    </div>
                                    <div class="w-full bg-surface-variant rounded-full h-2 overflow-hidden">
                                        <div class="bg-tertiary-container h-2 rounded-full transition-all duration-500" style={`width: ${pct}%`}></div>
                                    </div>
                                    <div class="text-right font-caption text-caption text-outline">Target: Rp {tgt.toLocaleString('id-ID')}</div>
                                </div>
                                <div class="mt-auto flex items-center gap-2">
                                    <a href={`/donasi?program=${encodeURIComponent(program.slug)}`} class="flex-1 block bg-secondary-container text-on-secondary font-label-md text-label-md py-sm rounded-lg hover:bg-secondary transition-colors text-center shadow-sm font-bold">Donasi Sekarang</a>
                                    <button type="button" class="program-card-share-btn inline-flex items-center justify-center p-2.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 transition-colors shrink-0 shadow-xs cursor-pointer" data-slug={program.slug} data-title={program.title} data-pillar={program.pillar} data-image={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} data-desc={program.description} title="Bagikan Link Mitra">
                                        <span class="material-symbols-outlined text-[20px]">share</span>
                                    </button>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
        </section>

        <!-- Section 4: Berkah Sehat (Kesehatan) -->
        <section class="program-section max-w-container-max mx-auto px-margin-mobile md:px-lg py-xl border-t border-surface-variant/50" data-section-category="kesehatan">
            <div class="flex items-center gap-sm mb-lg">
                <span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">medical_services</span>
                <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold">BERKAH SEHAT <span class="font-body-md text-body-md text-on-surface-variant ml-xs font-normal">(Kesehatan &amp; Ambulans)</span></h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
                {MASTER_PROGRAMS.filter(p => p.pillar.includes('Kesehatan') || p.pillar.includes('Sehat')).map(program => {
                    const col = Number(program.collected || 0);
                    const tgt = Number(program.target || 1);
                    const pct = Math.min(100, Math.round((col / tgt) * 100));
                    return (
                        <article class="program-card bg-surface rounded-xl overflow-hidden shadow-ambient-1 hover:shadow-ambient-2 transition-all duration-300 border border-surface-variant flex flex-col h-full" data-category="kesehatan" data-title={program.title}>
                            <div class="relative overflow-hidden aspect-[3/4] bg-slate-100">
                                <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt={program.title} src={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} onerror="this.onerror=null; this.src='/assets/images/default-program-wiz.jpg';" alt={program.title}/>
                                <span class="absolute top-sm left-sm bg-tertiary-container/90 text-on-tertiary font-caption text-caption px-sm py-xs rounded-full font-semibold">Kesehatan</span>
                            </div>
                            <div class="p-lg flex flex-col flex-grow">
                                <h3 class="font-headline-md text-headline-md text-on-surface mb-xs font-bold">{program.title}</h3>
                                <p class="font-body-md text-body-md text-on-surface-variant mb-md flex-grow line-clamp-3">{program.description}</p>
                                <div class="mb-lg space-y-xs">
                                    <div class="flex justify-between font-caption text-caption text-on-surface-variant">
                                        <span>Terkumpul: <strong>Rp {col.toLocaleString('id-ID')}</strong></span>
                                        <span class="font-semibold text-primary">{pct}%</span>
                                    </div>
                                    <div class="w-full bg-surface-variant rounded-full h-2 overflow-hidden">
                                        <div class="bg-tertiary-container h-2 rounded-full transition-all duration-500" style={`width: ${pct}%`}></div>
                                    </div>
                                    <div class="text-right font-caption text-caption text-outline">Target: Rp {tgt.toLocaleString('id-ID')}</div>
                                </div>
                                <div class="mt-auto flex items-center gap-2">
                                    <a href={`/donasi?program=${encodeURIComponent(program.slug)}`} class="flex-1 block bg-secondary-container text-on-secondary font-label-md text-label-md py-sm rounded-lg hover:bg-secondary transition-colors text-center shadow-sm font-bold">Donasi Sekarang</a>
                                    <button type="button" class="program-card-share-btn inline-flex items-center justify-center p-2.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 transition-colors shrink-0 shadow-xs cursor-pointer" data-slug={program.slug} data-title={program.title} data-pillar={program.pillar} data-image={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} data-desc={program.description} title="Bagikan Link Mitra">
                                        <span class="material-symbols-outlined text-[20px]">share</span>
                                    </button>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
        </section>

        <!-- Section 5: Berkah Mandiri (Ekonomi & Bencana) -->
        <section class="program-section max-w-container-max mx-auto px-margin-mobile md:px-lg py-xl border-t border-surface-variant/50" data-section-category="ekonomi">
            <div class="flex items-center gap-sm mb-lg">
                <span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">storefront</span>
                <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold">BERKAH MANDIRI <span class="font-body-md text-body-md text-on-surface-variant ml-xs font-normal">(Ekonomi &amp; Pemberdayaan)</span></h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
                {MASTER_PROGRAMS.filter(p => p.pillar.includes('Ekonomi') || p.pillar.includes('Mandiri')).map(program => {
                    const col = Number(program.collected || 0);
                    const tgt = Number(program.target || 1);
                    const pct = Math.min(100, Math.round((col / tgt) * 100));
                    return (
                        <article class="program-card bg-surface rounded-xl overflow-hidden shadow-ambient-1 hover:shadow-ambient-2 transition-all duration-300 border border-surface-variant flex flex-col h-full" data-category="ekonomi" data-title={program.title}>
                            <div class="relative overflow-hidden aspect-[3/4] bg-slate-100">
                                <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt={program.title} src={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} onerror="this.onerror=null; this.src='/assets/images/default-program-wiz.jpg';" alt={program.title}/>
                                <span class="absolute top-sm left-sm bg-primary/90 text-on-primary font-caption text-caption px-sm py-xs rounded-full font-semibold">Ekonomi</span>
                            </div>
                            <div class="p-lg flex flex-col flex-grow">
                                <h3 class="font-headline-md text-headline-md text-on-surface mb-xs font-bold">{program.title}</h3>
                                <p class="font-body-md text-body-md text-on-surface-variant mb-md flex-grow line-clamp-3">{program.description}</p>
                                <div class="mb-lg space-y-xs">
                                    <div class="flex justify-between font-caption text-caption text-on-surface-variant">
                                        <span>Terkumpul: <strong>Rp {col.toLocaleString('id-ID')}</strong></span>
                                        <span class="font-semibold text-primary">{pct}%</span>
                                    </div>
                                    <div class="w-full bg-surface-variant rounded-full h-2 overflow-hidden">
                                        <div class="bg-tertiary-container h-2 rounded-full transition-all duration-500" style={`width: ${pct}%`}></div>
                                    </div>
                                    <div class="text-right font-caption text-caption text-outline">Target: Rp {tgt.toLocaleString('id-ID')}</div>
                                </div>
                                <div class="mt-auto flex items-center gap-2">
                                    <a href={`/donasi?program=${encodeURIComponent(program.slug)}`} class="flex-1 block bg-secondary-container text-on-secondary font-label-md text-label-md py-sm rounded-lg hover:bg-secondary transition-colors text-center shadow-sm font-bold">Donasi Sekarang</a>
                                    <button type="button" class="program-card-share-btn inline-flex items-center justify-center p-2.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 transition-colors shrink-0 shadow-xs cursor-pointer" data-slug={program.slug} data-title={program.title} data-pillar={program.pillar} data-image={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'} data-desc={program.description} title="Bagikan Link Mitra">
                                        <span class="material-symbols-outlined text-[20px]">share</span>
                                    </button>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
        </section>

    </main>

    <!-- Interactive Filtering, Search & Admin Live Sync Script -->
    <script is:inline>
        const searchInput = document.getElementById('program-search');
        const filterButtons = document.querySelectorAll('.category-btn');
        const sections = document.querySelectorAll('.program-section');
        let activeCategory = 'all';

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function renderCustomDynamicPrograms() {
            if (!window.wizStore) return;

            let published = [];
            if (window.wizStore.programs && typeof window.wizStore.programs.getPublished === 'function') {
                published = window.wizStore.programs.getPublished();
            }

            if (!published || published.length === 0) return;

            // Enforce Dai program title, description & image if stale in cache
            published.forEach(p => {
                if (!p) return;
                const cleanTitle = (p.title || '').toLowerCase().trim();
                const cleanSlug = (p.slug || '').toLowerCase().trim();
                if (p.id === 'prog-dai-pelosok' || cleanSlug === 'keberangkatan-kepulangan-dai' || cleanTitle.includes('keberangkatan kepulangan dai') || (cleanTitle.includes('keberangkatan') && cleanTitle.includes('dai')) || cleanTitle.includes('pencerah umat')) {
                    p.title = 'Hadirkan Pencerah Umat, Dukung Perjuangan Dai';
                    p.description = "Mari berpartisipasi memfasilitasi operasional keberangkatan Dai pengabdian ke pelosok Bangka Belitung, serta dukung pendidikan syar'i calon Dai ke Makassar untuk mencetak generasi pendakwah masa depan.";
                    p.imageUrl = '/assets/images/keberangkatan-dai.png';
                    p.image_url = '/assets/images/keberangkatan-dai.png';
                }
            });

            const fmt = (window.wizStore.utils && window.wizStore.utils.formatRupiahCompact) 
                ? window.wizStore.utils.formatRupiahCompact 
                : (v => 'Rp ' + Number(v||0).toLocaleString('id-ID'));

            const PROGRAM_IMG_MAP = {
                'keberangkatan-kepulangan-dai': '/assets/images/keberangkatan-dai.png',
                'hadirkan-pencerah-umat-dukung-perjuangan-dai': '/assets/images/keberangkatan-dai.png',
                'pray-for-ntt': '/assets/images/default-program-wiz.jpg',
                'tebar-sembako': '/assets/images/tebar-sembako.png',
                'sedekah-beras-dhuafa': '/assets/images/sedekah-beras-dhuafa.png',
                'sedekah-jumat': '/assets/images/sedekah-Jumat.png',
                'santunan-yatim': '/assets/images/santunan-yatim.png',
                'tebar-quran-nusantara': '/assets/images/tebar-qur\'an-nusantara.png',
                'tebar-iftar-nusantara': '/assets/images/tebar-iftar-nusantara.png',
                'pembangunan-markaz': '/assets/images/pembangunan-markaz-dakwah.png',
                'pembangunan-markaz-dakwah': '/assets/images/pembangunan-markaz-dakwah.png',
                'pengadaan-perbaikan-kendaraan': '/assets/images/pengadaan-&-perbaikan-kendaraan.png',
                'santunan-mualaf': '/assets/images/santunan-mualaf.png',
                'tahfidz': '/assets/images/tahfidz.png',
                'beasiswa-pendidikan-juara': '/assets/images/beasiswa-pendidikan-juara.png',
                'beasiswa-tahfidz-dan-dhuafa': '/assets/images/tahfidz.png',
                'perlengkapan-belajar-yatim': '/assets/images/perlengkapan-belajar-yatim.png',
                'khitanan-massal-dhuafa': '/assets/images/khitanan-massal-dhuafa.png',
                'layanan-pengobatan-gratis': '/assets/images/layanan-pengobatan-gratis.png',
                'ambulance-gratis-ummat': '/assets/images/ambulance-gratis-ummat.png',
                'modal-usaha-dhuafa': '/assets/images/modal-usaha-dhuafa.png',
                'pelatihan-keterampilan-wirausaha': '/assets/images/pelatihan-keterampilan-wirausaha.png'
            };

            const categorySections = [
                { catKey: 'dakwah', pillars: ['Berkah Hidayah', 'Dakwah & Pembinaan', 'Dakwah'] },
                { catKey: 'sosial', pillars: ['Berkah Peduli', 'Sosial & Kemanusiaan', 'Sosial'] },
                { catKey: 'pendidikan', pillars: ['Berkah Juara', 'Pendidikan & Beasiswa', 'Pendidikan'] },
                { catKey: 'kesehatan', pillars: ['Berkah Sehat', 'Kesehatan Masyarakat', 'Kesehatan'] },
                { catKey: 'ekonomi', pillars: ['Berkah Mandiri', 'Ekonomi & Pemberdayaan', 'Ekonomi'] }
            ];

            categorySections.forEach(({ catKey, pillars }) => {
                const section = document.querySelector(`.program-section[data-section-category="${catKey}"]`);
                if (!section) return;
                const grid = section.querySelector('.grid');
                if (!grid) return;

                const categoryPrograms = published.filter(p => pillars.includes(p.pillar) || pillars.includes(p.category));
                if (categoryPrograms.length === 0) return;

                grid.innerHTML = categoryPrograms.map(p => {
                    const stats = (window.wizStore.finance && typeof window.wizStore.finance.getSpecificProgramStats === 'function')
                        ? window.wizStore.finance.getSpecificProgramStats(p.title, 0, p.targetAmount || 15000000)
                        : { percent: 0, saldo: 0 };

                    const slug = p.slug || (p.title ? p.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : 'program');
                    const pCleanTitle = (p.title || '').toLowerCase().trim();
                    let dynamicImg = PROGRAM_IMG_MAP[slug];
                    if (!dynamicImg) {
                        if (pCleanTitle.includes('pembangunan markaz') || slug.includes('pembangunan-markaz')) {
                            dynamicImg = '/assets/images/pembangunan-markaz-dakwah.png';
                        } else if (pCleanTitle.includes('perlengkapan belajar') || slug.includes('perlengkapan-belajar')) {
                            dynamicImg = '/assets/images/perlengkapan-belajar-yatim.png';
                        } else {
                            const rawImg = p.image_url || p.imageUrl || (window.wizStore.allocationRulesManager && typeof window.wizStore.allocationRulesManager.getSpecificProgramImage === 'function' ? window.wizStore.allocationRulesManager.getSpecificProgramImage(p.title, p.pillar) : '') || '/assets/images/default-program-wiz.jpg';
                            dynamicImg = rawImg ? (rawImg.startsWith('/') || rawImg.startsWith('http') || rawImg.startsWith('data:') ? rawImg : `/${rawImg}`) : '/assets/images/default-program-wiz.jpg';
                        }
                    }
                    if (!dynamicImg || (typeof dynamicImg === 'string' && dynamicImg.startsWith('data:image') && (pCleanTitle.includes('perlengkapan belajar') || pCleanTitle.includes('pembangunan markaz')))) {
                        dynamicImg = pCleanTitle.includes('perlengkapan belajar') ? '/assets/images/perlengkapan-belajar-yatim.png' : '/assets/images/pembangunan-markaz-dakwah.png';
                    }

                    const targetLabel = p.target || (`Rp ${(p.targetAmount || 15000000).toLocaleString('id-ID')}`);

                    return `
                    <article class="program-card bg-surface rounded-xl overflow-hidden shadow-ambient-1 hover:shadow-ambient-2 transition-all duration-300 border border-surface-variant flex flex-col h-full cursor-pointer" data-category="${catKey}" data-title="${escapeHtml(p.title)}" data-target="${p.targetAmount || 15000000}">
                        <div class="relative overflow-hidden aspect-[3/4] bg-slate-100">
                            <img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt="${escapeHtml(p.title)}" src="${escapeHtml(dynamicImg)}" onerror="this.onerror=null; this.src='/assets/images/default-program-wiz.jpg';" alt="${escapeHtml(p.title)}"/>
                            <span class="absolute top-sm left-sm bg-primary/90 text-on-primary font-caption text-caption px-sm py-xs rounded-full font-semibold">${escapeHtml(p.pillar)}</span>
                            ${p.urgent ? '<span class="absolute top-sm right-sm bg-error text-on-error font-caption text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider animate-pulse shadow-sm">Mendesak</span>' : ''}
                        </div>
                        <div class="p-lg flex flex-col flex-grow">
                            <h3 class="font-headline-md text-headline-md text-on-surface mb-1 font-bold">${escapeHtml(p.title)}</h3>
                            <div class="flex items-center gap-1 text-[11px] font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-md w-fit mb-2 border border-emerald-200">
                                <span class="material-symbols-outlined text-xs">pin_drop</span>
                                <span class="truncate">${escapeHtml(p.location || 'Kepulauan Bangka Belitung')}</span>
                            </div>
                            <p class="font-body-md text-body-md text-on-surface-variant mb-md flex-grow line-clamp-3">${escapeHtml(p.description || `Salurkan kepedulian dan donasi terbaik Anda untuk program ${p.title} bersama WIZ Babel.`)}</p>
                            <div class="mb-lg space-y-xs">
                                <div class="flex justify-between font-caption text-caption text-on-surface-variant">
                                    <span>Terkumpul: <strong class="text-primary">${fmt(stats.saldo)}</strong></span>
                                    <span class="font-semibold text-primary">${stats.percent}%</span>
                                </div>
                                <div class="w-full bg-surface-variant rounded-full h-2 overflow-hidden">
                                    <div class="bg-primary h-2 rounded-full transition-all duration-500" style="width: ${stats.percent}%"></div>
                                </div>
                                <div class="text-right font-caption text-caption text-outline">Target: ${escapeHtml(targetLabel)}</div>
                            </div>
                            <div class="mt-auto flex items-center gap-2">
                                <a href="/donasi?program=${encodeURIComponent(slug)}" class="flex-1 block bg-secondary-container text-on-secondary font-label-md text-label-md py-sm rounded-lg hover:bg-secondary transition-colors text-center shadow-sm font-bold">Donasi Sekarang</a>
                                <button type="button" class="program-card-share-btn inline-flex items-center justify-center p-2.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 transition-colors shrink-0 shadow-xs cursor-pointer" data-slug="${escapeHtml(slug)}" data-title="${escapeHtml(p.title)}" data-pillar="${escapeHtml(p.pillar)}" data-image="${escapeHtml(dynamicImg)}" data-desc="${escapeHtml(p.description || '')}" title="Bagikan Link Mitra">
                                    <span class="material-symbols-outlined text-[20px]">share</span>
                                </button>
                            </div>
                        </div>
                    </article>`;
                }).join('');
            });

            filterPrograms();
            initProgramCardShare();
        }

        function filterPrograms() {
            const query = (searchInput ? searchInput.value : '').toLowerCase().trim();

            sections.forEach(section => {
                const sectionCategory = section.getAttribute('data-section-category');
                const matchesCategory = activeCategory === 'all' || activeCategory === sectionCategory;

                let visibleCardsInSection = 0;
                const cards = section.querySelectorAll('.program-card');

                cards.forEach(card => {
                    const title = (card.getAttribute('data-title') || '').toLowerCase();
                    const desc = (card.querySelector('p')?.textContent || '').toLowerCase();
                    const matchesSearch = query === '' || title.includes(query) || desc.includes(query);

                    if (matchesCategory && matchesSearch) {
                        card.style.display = 'flex';
                        visibleCardsInSection++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (visibleCardsInSection > 0) {
                    section.style.display = 'block';
                } else {
                    section.style.display = 'none';
                }
            });
        }

        if (searchInput) {
            searchInput.addEventListener('input', filterPrograms);
        }

        filterButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                filterButtons.forEach(b => {
                    b.classList.remove('active', 'bg-primary', 'text-on-primary', 'border-primary');
                    b.classList.add('bg-surface', 'text-on-surface-variant', 'border-outline-variant');
                });
                btn.classList.add('active', 'bg-primary', 'text-on-primary', 'border-primary');
                btn.classList.remove('bg-surface', 'text-on-surface-variant', 'border-outline-variant');

                activeCategory = btn.getAttribute('data-category') || 'all';
                filterPrograms();
            });
        });

        
        function initProgramCardShare() {
            document.querySelectorAll('.program-card-share-btn').forEach((btn) => {
                if (btn._hasShareListener) return;
                btn._hasShareListener = true;

                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();

                    const el = e.currentTarget;
                    const slug = el.getAttribute('data-slug') || '';
                    const title = el.getAttribute('data-title') || 'Program Kebaikan';
                    const pillar = el.getAttribute('data-pillar') || 'Dakwah & Pembinaan';
                    const image = el.getAttribute('data-image') || '';
                    const desc = el.getAttribute('data-desc') || '';

                    // Resolve affiliate ref
                    let ref = '';
                    try {
                        const logged = localStorage.getItem('wiz_logged_affiliate');
                        if (logged) {
                            const parsed = JSON.parse(logged);
                            if (parsed && (parsed.referral_code || parsed.affiliate_id || parsed.id)) {
                                ref = parsed.referral_code || parsed.affiliate_id || parsed.id;
                            }
                        }
                        if (!ref) {
                            ref = localStorage.getItem('wiz_active_affiliate') || '';
                        }
                    } catch (err) {}

                    const origin = window.location.origin || 'https://www.wizbangkabelitung.or.id';
                    const shareUrl = `${origin}/program/${slug}${ref ? `?ref=${encodeURIComponent(ref)}` : ''}`;

                    if (typeof window.openUniversalShareModal === 'function') {
                        window.openUniversalShareModal(title, pillar, image, desc, shareUrl);
                    } else if (typeof window.showWhatsAppShareToast === 'function') {
                        window.showWhatsAppShareToast('✨ Membuka WhatsApp... Kartu preview donasi akan otomatis muncul!');
                        const waText = `*${title}*\n\n${desc}\n\nSalurkan donasi terbaik Anda melalui tautan resmi:\n👉 ${shareUrl}`;
                        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(waText)}`, '_blank');
                    } else {
                        navigator.clipboard.writeText(shareUrl).then(() => {
                            alert(`✅ Link Program (${title}) berhasil disalin:\n\n${shareUrl}`);
                        }).catch(() => {
                            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareUrl)}`, '_blank');
                        });
                    }
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initProgramCardShare();
            renderCustomDynamicPrograms();
            setTimeout(renderCustomDynamicPrograms, 500);
            setTimeout(renderCustomDynamicPrograms, 1500);
        });

        window.addEventListener('storage', (e) => {
            if (e.key && (e.key.includes('program') || e.key.includes('wiz_') || e.key.includes('image'))) {
                renderCustomDynamicPrograms();
            }
        });
    </script>
</BaseLayout>
