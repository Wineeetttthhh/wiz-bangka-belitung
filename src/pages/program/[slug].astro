                </div>

                <!-- Mitra & Relawan Integrated Professional Toolkit Widget -->
                <div class="bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-900 text-white rounded-3xl p-6 shadow-xl flex flex-col items-stretch gap-4 border border-emerald-700/40">
                    <div>
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-800/80 border border-emerald-500/50 text-[11px] font-bold text-emerald-200 mb-2">
                            <span class="material-symbols-outlined text-[15px] text-amber-300">handshake</span>
                            <span>Portal Mitra &amp; Duta Kebaikan</span>
                        </div>
                        <h4 class="font-bold text-base text-amber-300">Toolkit Profesional Relawan &amp; Mitra</h4>
                        <p class="text-xs text-emerald-100/90 mt-1 leading-relaxed">
                            {isSerdang 
                                ? 'Jalankan amanah penghimpunan Aksi Dusun Serdang Gelombang 2 secara profesional. Gunakan teks broadcast resmi, poster HD, dan tautan berkode mitra Anda.'
                                : 'Sebarkan program ini. Setiap kebaikan yang dilakukan orang lain lewat ajakan Anda bernilai pahala jariyah serta tercatat otomatis ke KPI Mitra.'}
                        </p>
                    </div>

                    <!-- Active Mitra Code Badge -->
                    <div id="active-mitra-badge-wrap" class="hidden p-3 bg-emerald-900/60 rounded-2xl border border-emerald-600/50 text-center space-y-1">
                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-300">
                            <span class="material-symbols-outlined text-sm text-emerald-400">verified</span>
                            <span>ID Mitra Aktif: <strong id="active-mitra-code-display" class="font-mono text-white text-sm"></strong></span>
                        </span>
                        <p class="text-[10px] text-emerald-200">Hak insentif 6% &amp; atribusi KPI otomatis tersambung</p>
                    </div>

                    <div class="grid grid-cols-1 gap-2.5">
                        <!-- Broadcast WA Full Text -->
                        <button
                            type="button"
                            id="share-program-btn"
                            data-slug={program.slug}
                            data-title={displayTitle}
                            data-pillar={program.pillar}
                            data-image={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'}
                            data-desc={program.description}
                            class="w-full py-3.5 px-4 rounded-2xl bg-[#25D366] hover:bg-[#1fa851] text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md transition-all hover:scale-[1.01] active:scale-[0.99] cursor-pointer"
                        >
                            <span class="material-symbols-outlined text-lg">chat</span>
                            <span>Bagikan Broadcast WA Resmi</span>
                        </button>

                        <div class="grid grid-cols-2 gap-2">
                            <!-- WA Status Link -->
                            <button
                                type="button"
                                id="status-program-btn"
                                data-slug={program.slug}
                                data-title={displayTitle}
                                class="py-2.5 px-3 rounded-xl bg-emerald-800/80 hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 border border-emerald-600/40 transition-all cursor-pointer"
                                title="Buat Status WhatsApp dengan kartu preview gambar otomatis"
                            >
                                <span class="material-symbols-outlined text-base">history_toggle_off</span>
                                <span>Status WA</span>
                            </button>

                            <!-- Copy Link -->
                            <button
                                type="button"
                                id="copy-program-link-btn"
                                data-slug={program.slug}
                                data-title={displayTitle}
                                class="py-2.5 px-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs flex items-center justify-center gap-1.5 border border-white/20 transition-all cursor-pointer"
                            >
                                <span class="material-symbols-outlined text-base">content_copy</span>
                                <span>Salin Link</span>
                            </button>
                        </div>

                        <!-- Copy Full Broadcast Copytext -->
                        <button
                            type="button"
                            id="copy-broadcast-text-btn"
                            data-slug={program.slug}
                            class="w-full py-2.5 px-3 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-emerald-200 font-bold text-xs flex items-center justify-center gap-1.5 border border-slate-700 transition-all cursor-pointer"
                        >
                            <span class="material-symbols-outlined text-base text-amber-300">description</span>
                            <span>Salin Teks Broadcast Lengkap (Clipboard)</span>
                        </button>

                        <!-- Download Official HD Poster Button -->
                        <a
                            href={program.image_url || program.imageUrl || '/assets/images/pray-for-dusun-serdang.jpg'}
                            download={isSerdang ? "Poster-Pray-For-Dusun-Serdang-Gelombang-2-WIZ.jpg" : `Poster-${program.slug}.jpg`}
                            class="w-full py-2.5 px-3 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 font-bold text-xs flex items-center justify-center gap-1.5 border border-amber-500/40 transition-all no-underline text-center cursor-pointer"
                        >
                            <span class="material-symbols-outlined text-base">download</span>
                            <span>Unduh Poster Resmi HD (Siap Sebar)</span>
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </div>
</BaseLayout>

<script>
    import { getActiveAffiliate } from '../../lib/affiliate-tracker';

    const checkoutBtn = document.getElementById('checkout-donate-btn') as HTMLAnchorElement;
    const programSlug = checkoutBtn?.getAttribute('data-slug') || '';
    const isSerdangSlug = programSlug.includes('serdang') || programSlug.includes('ntt');

    // Resolve Active Mitra / Referral Code
    const activeRef = getActiveAffiliate();

    // Show badge if referral code is active
    if (activeRef) {
        const badgeWrap = document.getElementById('active-mitra-badge-wrap');
        const codeDisplay = document.getElementById('active-mitra-code-display');
        if (badgeWrap && codeDisplay) {
            codeDisplay.textContent = activeRef;
            badgeWrap.classList.remove('hidden');
        }
    }

    function updateCheckoutUrl() {
        if (checkoutBtn && programSlug) {
            const params = new URLSearchParams();
            params.set('program', programSlug);
            if (activeRef) params.set('ref', activeRef);
            checkoutBtn.href = `/donasi?${params.toString()}`;
        }
    }

    // Initialize checkout URL on page load
    updateCheckoutUrl();

    // Build Share URL
    function getShareUrl(slug: string) {
        const baseUrl = window.location.origin || 'https://www.wizbangkabelitung.or.id';
        const ref = getActiveAffiliate();
        return `${baseUrl}/program/${slug}${ref ? `?ref=${encodeURIComponent(ref)}` : ''}`;
    }

    function buildBroadcastText(slug: string, ref: string): string {
        const shareUrl = getShareUrl(slug);
        const refDisplay = ref ? `ID Mitra: ${ref}` : 'Mitra Resmi WIZ Babel';

        if (slug.includes('serdang') || slug.includes('ntt')) {
            return `🚨 *PRAY FOR DUSUN SERDANG — GELOMBANG 2* 🚨\n_Kolaborasi Kemanusiaan Lintas Lembaga & Relawan Bangka Belitung_\n\nInnalillahi wa inna ilaihi raji'un. Duka saudara-saudara kita penyintas musibah kebakaran di Dusun Serdang, Kab. Bangka Selatan adalah duka kita bersama. Aksi kemanusiaan *GELOMBANG 2* kini resmi dibuka untuk pemenuhan kebutuhan darurat dan fase pemulihan.\n\n🤝 *ALIANSI LEMBAGA KOLABORATOR:*\n• Wahdah Inspirasi Zakat (WIZ) Bangka Belitung\n• DEMA IAIN Syaikh Abdurrahman Siddik Bangka Belitung\n• DPW Serikat Buruh Sejahtera Indonesia (SBSI) Bangka Belitung\n• BEM Politeknik Manufaktur Negeri Bangka Belitung\n• Palang Merah Indonesia (PMI) Bangka Belitung\n• Politeknik Manufaktur Negeri Bangka Belitung\n\n📦 *7 KEBUTUHAN MENDESAK (GELOMBANG 2):*\n1. 🌾 Sembako / Makanan Kering\n2. 💵 Donasi Tunai / Transfer\n3. 🛁 Handuk Bersih\n4. 🛏️ Selimut Hangat\n5. 🎒 Perlengkapan Sekolah (SD, SMP, dan SMA)\n6. 👕 Pakaian Dalam Baru (Pria & Wanita)\n7. 🍼 Susu Balita (0 s.d. 3 Tahun)\n\n💳 *REKENING SEDEKAH RESMI:*\nBank Syariah Indonesia (BSI)\nNo. Rekening: *716-800-800-1*\nA.n: *WIZ Bangka Belitung*\n\n📲 *LAYANAN INFORMASI & KONFIRMASI:*\nWhatsApp / SMS: *0823-8083-0808*\n\n🌐 *SALURKAN DONASI ONLINE RESMI:*\n👇👇👇\n${shareUrl}\n\n_Penyaluran terverifikasi melalui ${refDisplay}. Semoga Allah membalas setiap kebaikan dengan keberkahan berlipat ganda. Aamiin._`;
        }

        return `*Program Kebaikan: WIZ Bangka Belitung*\n\nMari alirkan kebaikan dan raih pahala jariyah terbaik melalui tautan resmi terverifikasi berikut:\n👇👇👇\n${shareUrl}\n\n_Dikelola amanah oleh Wahdah Inspirasi Zakat (SK Kemenag RI No. 805)._`;
    }

    // Share Button with Professional Broadcast WhatsApp Text
    const shareBtn = document.getElementById('share-program-btn');
    if (shareBtn) {
        shareBtn.addEventListener('click', () => {
            const slug = shareBtn.getAttribute('data-slug') || '';
            const broadcastText = buildBroadcastText(slug, activeRef);
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(broadcastText)}`, '_blank');
        });
    }

    // Status WA Button
    const statusBtn = document.getElementById('status-program-btn');
    if (statusBtn) {
        statusBtn.addEventListener('click', () => {
            const slug = statusBtn.getAttribute('data-slug') || '';
            const shareUrl = getShareUrl(slug);
            if (typeof (window as any).showWhatsAppShareToast === 'function') {
                (window as any).showWhatsAppShareToast('✨ Membuka WhatsApp... Kartu poster donasi akan muncul!');
            }
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareUrl)}`, '_blank');
        });
    }

    // Copy Referral Link Button
    const copyLinkBtn = document.getElementById('copy-program-link-btn');
    if (copyLinkBtn) {
        copyLinkBtn.addEventListener('click', () => {
            const slug = copyLinkBtn.getAttribute('data-slug') || '';
            const shareUrl = getShareUrl(slug);

            navigator.clipboard.writeText(shareUrl).then(() => {
                alert(`✅ Link Program Donasi berhasil disalin!\n\n${shareUrl}\n\n(Tercatat resmi ke ID Mitra Anda: ${activeRef || 'WIZ'})`);
            }).catch(() => {
                alert(`Tautan Program:\n${shareUrl}`);
            });
        });
    }

    // Copy Full Broadcast Copytext Button
    const copyBroadcastBtn = document.getElementById('copy-broadcast-text-btn');
    if (copyBroadcastBtn) {
        copyBroadcastBtn.addEventListener('click', () => {
            const slug = copyBroadcastBtn.getAttribute('data-slug') || '';
            const text = buildBroadcastText(slug, activeRef);

            navigator.clipboard.writeText(text).then(() => {
                alert(`✅ Teks Broadcast Lengkap Berhasil Disalin ke Clipboard!\n\nAnda dapat langsung mem-paste teks ini ke WhatsApp Grup, Instagram Caption, Facebook, atau Telegram bersama poster resminya.`);
            }).catch(() => {
                alert(`Gagal menyalin teks.`);
            });
        });
    }

    // Copy BSI Rekening Button
    const copyBsiBtn = document.getElementById('copy-bsi-rek-btn');
    if (copyBsiBtn) {
        copyBsiBtn.addEventListener('click', () => {
            navigator.clipboard.writeText('7168008001').then(() => {
                alert(`✅ Nomor Rekening BSI Berhasil Disalin:\n\n7168008001\na.n. WIZ Bangka Belitung\n\nSilakan lanjutkan transfer melalui m-Banking atau ATM Anda.`);
            });
        });
    }
</script>
