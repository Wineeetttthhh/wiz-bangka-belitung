                                    <span class="material-symbols-outlined text-amber-300 text-xl">account_balance</span>
                                    <h3 class="text-base sm:text-lg font-extrabold text-white">Rekening Sedekah Resmi & Posko Bantuan</h3>
                                </div>
                                <span class="text-[11px] font-bold text-emerald-200 bg-white/10 px-2.5 py-0.5 rounded-full border border-white/20">Amanah &amp; Terverifikasi</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
                                <div class="bg-white/10 rounded-2xl p-4 border border-white/15 backdrop-blur-xs space-y-1.5">
                                    <span class="text-[11px] text-emerald-200 font-bold uppercase tracking-wider block">Bank Syariah Indonesia (BSI)</span>
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="text-lg sm:text-xl font-mono font-black text-amber-300">716-800-800-1</span>
                                        <button type="button" id="copy-bsi-rek-btn" class="px-2.5 py-1 bg-white/20 hover:bg-white/30 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1 cursor-pointer" title="Salin No. Rekening">
                                            <span class="material-symbols-outlined text-sm">content_copy</span> Salin Rekening
                                        </button>
                                    </div>
                                    <span class="text-xs text-emerald-100 block">a.n. WIZ Bangka Belitung</span>
                                </div>
                                <div class="space-y-2">
                                    <div class="text-xs text-emerald-100 leading-relaxed">
                                        <strong>Informasi Posko & Konfirmasi Transfer:</strong>
                                        <p class="text-amber-200 font-mono font-bold text-sm mt-0.5">0823-8083-0808 (SMS/WA)</p>
                                    </div>
                                    <a href="https://wa.me/6282380830808?text=Bismillah,%20saya%20ingin%20konfirmasi%20bantuan%20untuk%20Pray%20For%20Dusun%20Serdang%20(Gelombang%202)" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#25D366] hover:bg-[#1ebd5a] text-white text-xs font-bold transition-all shadow-xs cursor-pointer no-underline">
