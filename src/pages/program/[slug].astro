---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MASTER_PROGRAMS } from '../../lib/programs-data';
import { formatRupiah } from '../../lib/affiliate-tracker';

export const prerender = true; // static — program data is code-defined

export function getStaticPaths() {
    const paths = MASTER_PROGRAMS.map((program) => ({
        params: { slug: program.slug },
        props: { program }
    }));
    // Alias legacy pray-for-ntt to pray-for-dusun-serdang
    const serdang = MASTER_PROGRAMS.find(p => p.slug === 'pray-for-dusun-serdang');
    if (serdang) {
        paths.push({
            params: { slug: 'pray-for-ntt' },
            props: { program: serdang }
        });
    }
    return paths;
}

const { program } = Astro.props;

if (!program) {
    return Astro.redirect('/program');
}

const isSerdang = (program.slug || '').includes('serdang') || (program.title || '').toLowerCase().includes('serdang') || (program.slug || '').includes('ntt');
const displayTitle = isSerdang ? 'Pray For Dusun Serdang (Gelombang 2)' : (program.judul || program.title);
const percentage = Math.min(100, Math.round((program.collected / program.target) * 100));
const ogTitle = displayTitle;
const ogDescription = program.deskripsi_singkat || program.description;
// High-speed static 1200x630 OG image (< 120KB) for instant WhatsApp & Social Media Preview Cards
const cleanOgSlug = (program.slug || 'default-program-wiz').replace(/&/g, 'dan').replace(/[']/g, '');
const ogImgFile = `/assets/images/og/${cleanOgSlug}.jpg?v=20261013v2`;
const ogImageUrl = new URL(ogImgFile, Astro.site || Astro.url.origin).href;
const canonicalUrl = new URL(`/program/${program.slug}`, Astro.site || Astro.url.origin).href;
---

<BaseLayout
    title={`${ogTitle} | WIZ Bangka Belitung`}
    description={ogDescription}
    image={ogImageUrl}
    url={canonicalUrl}
    type="article"
>
    <Fragment slot="head">
        <!-- WhatsApp & Social Open Graph Preview -->
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImageUrl} />
    </Fragment>

    <!-- Breadcrumb -->
    <div class="bg-slate-100 py-3 border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs text-slate-500 flex items-center gap-2">
            <a href="/" class="hover:text-emerald-700">Beranda</a>
            <span>/</span>
            <a href="/program" class="hover:text-emerald-700">Program</a>
            <span>/</span>
            <span class="text-slate-800 font-semibold truncate">{displayTitle}</span>
        </div>
    </div>

    <!-- Main Content Container -->
    <div class="py-10 sm:py-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            
            <!-- Left 7 Cols: Image, Header & Story -->
            <div class="lg:col-span-7 space-y-8">
                
                <!-- Main Image -->
                <div class="relative w-full rounded-3xl overflow-hidden shadow-lg border border-slate-200 bg-slate-950 flex items-center justify-center p-2 sm:p-4">
                    <img
                        src={program.image_url || program.imageUrl || '/assets/images/default-program-wiz.jpg'}
                        alt={displayTitle}
                        class="w-full max-h-[680px] object-contain rounded-2xl block mx-auto"
                        onerror={`if(!this.dataset.triedP1){this.dataset.triedP1='1';this.src='/images/programs/keberangkatan-dai.png';}else if(!this.dataset.triedP2){this.dataset.triedP2='1';this.src='/images/keberangkatan-dai.png';}else if(!this.dataset.triedOg){this.dataset.triedOg='1';this.src='${ogImgFile}';}else{this.src='/assets/images/default-program-wiz.jpg';}`}
                    />
                    <div class="absolute top-4 left-4">
                        <span class="px-3.5 py-1.5 rounded-full bg-slate-900/80 backdrop-blur-md text-amber-300 text-xs font-bold border border-slate-700 shadow-md">
                            {program.pillar}
                        </span>
                    </div>
                    {isSerdang && (
                        <div class="absolute top-4 right-4 z-10">
                            <span class="px-3.5 py-1.5 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 text-xs font-black tracking-wider uppercase shadow-xl border border-amber-300/60 flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm font-black">emergency</span>
                                GELOMBANG 2
                            </span>
                        </div>
                    )}
                </div>

                <!-- Title & Meta Badges -->
                <div class="space-y-4">
                    <div class="flex flex-wrap items-center gap-2">
                        {isSerdang && (
                            <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-900 bg-amber-100 px-3 py-1 rounded-full border border-amber-300 shadow-2xs">
                                <span class="material-symbols-outlined text-[15px] text-amber-700">bolt</span>
                                Gelombang 2 (Tanggap Darurat &amp; Pemulihan)
                            </span>
                        )}
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                            <span class="material-symbols-outlined text-[15px] text-emerald-600">verified</span>
                            Program Terverifikasi
                        </span>
                        {program.location && (
                            <span class="inline-flex items-center gap-1 text-xs text-slate-600 bg-slate-100 px-3 py-1 rounded-full">
                                <span class="material-symbols-outlined text-[15px] text-slate-500">location_on</span>
                                {program.location}
                            </span>
                        )}
                        {program.beneficiaries && (
                            <span class="inline-flex items-center gap-1 text-xs text-slate-600 bg-slate-100 px-3 py-1 rounded-full">
                                <span class="material-symbols-outlined text-[15px] text-slate-500">group</span>
                                {program.beneficiaries}
                            </span>
                        )}
                    </div>

                    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 leading-tight">
                        {displayTitle}
                    </h1>

                    {isSerdang && (
                        <div class="p-3.5 sm:p-4 rounded-2xl bg-gradient-to-r from-amber-50 via-orange-50 to-emerald-50 border border-amber-200/80 flex flex-wrap items-center gap-2.5 shadow-2xs">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-600 text-white font-extrabold text-xs tracking-wide uppercase">
                                <span class="material-symbols-outlined text-sm">groups</span>
                                Kolaborasi Lintas Lembaga
                            </span>
                            <span class="text-xs text-slate-700 font-medium leading-relaxed">
                                Sinergi kemanusiaan terpadu WIZ Babel, DEMA IAIN SAS, SBSI Babel, BEM Polman Babel, Palang Merah Indonesia (PMI), dan Polman Babel.
                            </span>
                        </div>
                    )}
                </div>

                <!-- Story & Description Section -->
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm space-y-6">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2 pb-4 border-b border-slate-100">
                        <span class="material-symbols-outlined text-emerald-600">article</span>
                        Deskripsi & Rencana Penyaluran
                    </h2>

                    <div class="prose prose-slate max-w-none text-sm sm:text-base leading-relaxed text-slate-700 space-y-4">
                        <p>{program.description}</p>
                        {program.fullDescription && <p>{program.fullDescription}</p>}
                        
                        <div class="p-4 bg-emerald-50 rounded-2xl border border-emerald-200 text-xs sm:text-sm text-emerald-950 font-medium space-y-1">
                            <span class="font-bold block text-emerald-800">Standar Akuntabilitas & Transparansi</span>
                            Setiap donasi Anda dikelola dengan standar akuntabilitas Lembaga Amil Zakat Nasional (SK Kemenag RI No. 805) dan disalurkan secara profesional bersama mitra relawan resmi di Bangka Belitung.
                        </div>
                    </div>
                </div>

                {isSerdang && (
                    <>
                        <!-- Partner Coalition Showcase -->
                        <div class="bg-slate-50/90 rounded-3xl p-6 sm:p-7 border border-slate-200 space-y-4">
                            <div class="flex items-center justify-between flex-wrap gap-2 pb-3 border-b border-slate-200">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-emerald-700 text-xl">handshake</span>
                                    <h3 class="text-base sm:text-lg font-extrabold text-slate-900">Aliansi Lembaga Kolaborator (Gelombang 2)</h3>
                                </div>
                                <span class="text-[11px] font-bold text-emerald-800 bg-emerald-100/90 px-3 py-1 rounded-full border border-emerald-300">Resmi Terintegrasi</span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Aksi kemanusiaan ini diselenggarakan bersama aliansi ormas buruh, eksekutif mahasiswa, institusi manufaktur, serta korps kemanusiaan:
                            </p>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-1">
                                <div class="bg-white p-3.5 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col items-center text-center gap-1.5 hover:border-emerald-500 transition-all">
                                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-black text-xs border border-emerald-200">WIZ</div>
                                    <span class="text-xs font-bold text-slate-900 leading-tight">WIZ Bangka Belitung</span>
                                    <span class="text-[10px] text-slate-500 font-medium">Inisiator & Penyalur</span>
                                </div>
                                <div class="bg-white p-3.5 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col items-center text-center gap-1.5 hover:border-emerald-500 transition-all">
                                    <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center font-black text-xs border border-teal-200">DEMA</div>
                                    <span class="text-xs font-bold text-slate-900 leading-tight">DEMA IAIN SAS Babel</span>
                                    <span class="text-[10px] text-slate-500 font-medium">Eksekutif Mahasiswa</span>
                                </div>
                                <div class="bg-white p-3.5 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col items-center text-center gap-1.5 hover:border-emerald-500 transition-all">
                                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-800 flex items-center justify-center font-black text-xs border border-amber-200">SBSI</div>
                                    <span class="text-xs font-bold text-slate-900 leading-tight">DPW SBSI Babel</span>
                                    <span class="text-[10px] text-slate-500 font-medium">Serikat Buruh Sejahtera</span>
                                </div>
                                <div class="bg-white p-3.5 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col items-center text-center gap-1.5 hover:border-emerald-500 transition-all">
                                    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-800 flex items-center justify-center font-black text-xs border border-blue-200">BEM</div>
                                    <span class="text-xs font-bold text-slate-900 leading-tight">BEM Polman Babel</span>
                                    <span class="text-[10px] text-slate-500 font-medium">Mahasiswa Polman</span>
                                </div>
                                <div class="bg-white p-3.5 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col items-center text-center gap-1.5 hover:border-emerald-500 transition-all">
                                    <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-700 flex items-center justify-center font-black text-xs border border-rose-200">PMI</div>
                                    <span class="text-xs font-bold text-slate-900 leading-tight">PMI Bangka Belitung</span>
                                    <span class="text-[10px] text-slate-500 font-medium">Palang Merah Indonesia</span>
                                </div>
                                <div class="bg-white p-3.5 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col items-center text-center gap-1.5 hover:border-emerald-500 transition-all">
                                    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center font-black text-xs border border-indigo-200">POLMAN</div>
                                    <span class="text-xs font-bold text-slate-900 leading-tight">Polman Negeri Babel</span>
                                    <span class="text-[10px] text-slate-500 font-medium">Akademisi & Relawan</span>
                                </div>
                            </div>
                        </div>

                        <!-- 7 Essential Needs Matrix -->
                        <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-sm space-y-4">
                            <div class="flex items-center justify-between flex-wrap gap-2 pb-3 border-b border-slate-100">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-orange-600 text-xl">inventory_2</span>
                                    <h3 class="text-base sm:text-lg font-extrabold text-slate-900">Bantuan yang Dibutuhkan (Gelombang 2)</h3>
                                </div>
                                <span class="text-[11px] font-bold text-amber-800 bg-amber-100 px-3 py-1 rounded-full border border-amber-200">Prioritas Lapangan</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                                    <span class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl font-bold shrink-0">🌾</span>
                                    <div>
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900">Sembako / Makanan Kering</h4>
                                        <p class="text-[11px] text-slate-500">Beras, mie instan, minyak goreng, biskuit</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                                    <span class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl font-bold shrink-0">💵</span>
                                    <div>
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900">Uang (Cash / Transfer)</h4>
                                        <p class="text-[11px] text-slate-500">Operasional darurat &amp; pemulihan hunian</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                                    <span class="w-10 h-10 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center text-xl font-bold shrink-0">🛁</span>
                                    <div>
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900">Handuk Bersih</h4>
                                        <p class="text-[11px] text-slate-500">Sanitasi &amp; higienitas warga terdampak</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                                    <span class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-800 flex items-center justify-center text-xl font-bold shrink-0">🛏️</span>
                                    <div>
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900">Selimut Hangat</h4>
                                        <p class="text-[11px] text-slate-500">Perlindungan tidur di tenda pengungsian</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                                    <span class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl font-bold shrink-0">🎒</span>
                                    <div>
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900">Perlengkapan Sekolah</h4>
                                        <p class="text-[11px] text-slate-500">Buku, alat tulis, seragam SD, SMP, dan SMA</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                                    <span class="w-10 h-10 rounded-xl bg-purple-100 text-purple-800 flex items-center justify-center text-xl font-bold shrink-0">👕</span>
                                    <div>
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900">Pakaian Dalam Baru</h4>
                                        <p class="text-[11px] text-slate-500">Pakaian dalam baru untuk pria dan wanita</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80 sm:col-span-2">
                                    <span class="w-10 h-10 rounded-xl bg-rose-100 text-rose-800 flex items-center justify-center text-xl font-bold shrink-0">🍼</span>
                                    <div>
                                        <h4 class="text-xs sm:text-sm font-bold text-slate-900">Susu Balita (Usia 0 s.d. 3 Tahun)</h4>
                                        <p class="text-[11px] text-slate-500">Nutrisi esensial bagi bayi dan balita di posko</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Official Bank Account & Hotline Card -->
                        <div class="bg-gradient-to-br from-[#004d26] via-[#006834] to-slate-900 text-white rounded-3xl p-6 sm:p-7 shadow-xl space-y-4 border border-emerald-600/30">
                            <div class="flex items-center justify-between flex-wrap gap-2 pb-3 border-b border-white/10">
