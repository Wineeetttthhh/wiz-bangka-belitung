---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Laporan Transparansi Keuangan - WIZ Babel"
    description="Laporan transparansi keuangan dana amil zakat, infak, sedekah secara real-time Wahdah Inspirasi Zakat (WIZ) Bangka Belitung."
    image="/assets/images/foto-utama-wiz.jpg"
>
    <main class="max-w-container-max mx-auto px-margin-mobile md:px-gutter py-xl md:py-xxl space-y-xxl flex-grow">

        <!-- Header & Real-time Indicator -->
        <section class="flex flex-col md:flex-row justify-between items-start md:items-end gap-md">
            <div>
                <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary font-bold mb-sm">Transparansi Keuangan</h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant">Laporan transparansi dana amanah umat secara real-time dan terverifikasi.</p>
            </div>
            <div class="flex items-center gap-sm bg-surface-container-high px-md py-xs rounded-full border border-outline-variant shadow-sm">
                <span class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-fixed opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"></span>
                </span>
                <span class="font-caption text-caption text-on-surface-variant font-medium">Update Terakhir: <strong id="live-time">Real-time</strong></span>
            </div>
        </section>

        <!-- Dashboard Metrics (Bento Grid) -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md md:gap-lg">
            <div class="bg-surface-container-lowest p-md sm:p-lg rounded-xl shadow-level-1 border border-outline-variant/30 flex flex-col gap-xs hover:shadow-level-2 transition-all min-w-0 overflow-hidden">
                <div class="flex items-center gap-xs sm:gap-sm text-primary">
                    <span class="material-symbols-outlined text-lg sm:text-xl">account_balance_wallet</span>
                    <span class="font-label-md text-xs sm:text-sm font-bold">Total Dana Masuk</span>
                </div>
                <div class="font-bold text-on-surface text-lg sm:text-xl md:text-2xl tracking-tight truncate min-w-0 w-full" id="pub-total-masuk" title="Total Dana Masuk">Rp 0</div>
                <span class="font-caption text-[11px] sm:text-caption text-on-surface-variant">Donasi terverifikasi sah</span>
            </div>

            <div class="bg-surface-container-lowest p-md sm:p-lg rounded-xl shadow-level-1 border border-outline-variant/30 flex flex-col gap-xs hover:shadow-level-2 transition-all min-w-0 overflow-hidden">
                <div class="flex items-center gap-xs sm:gap-sm text-tertiary-container">
                    <span class="material-symbols-outlined text-lg sm:text-xl">volunteer_activism</span>
                    <span class="font-label-md text-xs sm:text-sm font-bold">Total Tersalurkan</span>
                </div>
                <div class="font-bold text-on-surface text-lg sm:text-xl md:text-2xl tracking-tight truncate min-w-0 w-full" id="pub-total-salur" title="Total Tersalurkan">Rp 0</div>
                <span class="font-caption text-[11px] sm:text-caption text-on-surface-variant">Telah disalurkan ke penerima</span>
            </div>

            <div class="bg-surface-container-lowest p-md sm:p-lg rounded-xl shadow-level-1 border border-outline-variant/30 flex flex-col gap-xs hover:shadow-level-2 transition-all min-w-0 overflow-hidden">
                <div class="flex items-center gap-xs sm:gap-sm text-[#F7941D]">
                    <span class="material-symbols-outlined text-lg sm:text-xl">account_balance</span>
                    <span class="font-label-md text-xs sm:text-sm font-bold">Saldo Saat Ini</span>
                </div>
                <div class="font-bold text-on-surface text-lg sm:text-xl md:text-2xl tracking-tight truncate min-w-0 w-full" id="pub-saldo" title="Saldo Saat Ini">Rp 0</div>
                <span class="font-caption text-[11px] sm:text-caption text-on-surface-variant">Sisa saldo amanah program</span>
            </div>

            <div class="bg-surface-container-lowest p-md sm:p-lg rounded-xl shadow-level-1 border border-outline-variant/30 flex flex-col gap-xs hover:shadow-level-2 transition-all min-w-0 overflow-hidden">
                <div class="flex items-center gap-xs sm:gap-sm text-secondary-container">
                    <span class="material-symbols-outlined text-lg sm:text-xl">groups</span>
                    <span class="font-label-md text-xs sm:text-sm font-bold">Jumlah Donatur</span>
                </div>
                <div class="font-bold text-on-surface text-lg sm:text-xl md:text-2xl tracking-tight truncate min-w-0 w-full" id="pub-donatur-count" title="Jumlah Donatur">0</div>
                <span class="font-caption text-[11px] sm:text-caption text-on-surface-variant">Donatur terverifikasi</span>
            </div>
        </section>

        <!-- Diagram Lingkaran Distribusi Pilar (5 Berkah WIZ) -->
        <section class="bg-surface-container-lowest rounded-xl shadow-level-1 border border-outline-variant/30 p-lg space-y-md">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md">
                <div>
                    <h2 class="font-headline-md text-headline-md font-bold text-primary flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">pie_chart</span>
                        <span>Diagram Lingkaran Distribusi Alokasi Dana WIZ</span>
                    </h2>
                    <p id="chart-section-subtitle" class="font-body-md text-caption text-on-surface-variant">Proporsi dan persentase realisasi penyaluran dana per 5 Berkah WIZ berdasarkan riwayat pengeluaran aktual.</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <div class="inline-flex p-1 bg-surface-container-high rounded-xl border border-outline-variant/30 text-xs font-bold">
                        <button type="button" id="btn-chart-masuk" onclick="setChartMetric('masuk')" class="px-3 py-1.5 rounded-lg transition-all text-on-surface-variant hover:text-on-surface font-semibold cursor-pointer">
                            📥 Pemasukan
                        </button>
                        <button type="button" id="btn-chart-salur" onclick="setChartMetric('salur')" class="px-3 py-1.5 rounded-lg transition-all bg-primary text-on-primary font-bold shadow-xs cursor-pointer">
                            📤 Penyaluran
                        </button>
                    </div>
                    <select id="pub-filter-wilayah" onchange="renderPublicReport()" class="bg-surface border border-outline-variant rounded-lg px-3 py-2 font-caption text-caption text-on-surface font-bold outline-none cursor-pointer">
                        <option value="Semua" selected>Wilayah: Konsolidasi (Semua)</option>
                        <option value="Pangkalpinang">Wilayah: Pangkalpinang</option>
                        <option value="Sungailiat">Wilayah: Sungailiat</option>
                    </select>
                </div>
            </div>

            <!-- Donut Chart & Legend Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg items-center pt-sm">
                <div class="lg:col-span-5 flex flex-col items-center justify-center p-md bg-surface-container-low rounded-xl border border-outline-variant/20 relative min-h-[260px]" id="pillar-chart-container">
                </div>

                <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-sm" id="pillar-legend-container">
                </div>
            </div>
        </section>

        <!-- Public Penyaluran Log / Transparansi Penyaluran Terbaru -->
        <section class="bg-surface-container-lowest rounded-xl shadow-level-1 border border-outline-variant/30 p-lg space-y-md">
            <h2 class="font-headline-md text-headline-md font-bold text-primary flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">history_edu</span>
                <span>Riwayat Penyaluran Dana Terbaru</span>
            </h2>
            <div id="disbursement-history-list" class="space-y-sm divide-y divide-outline-variant/20"></div>
        </section>

    </main>

    <!-- Script from laporan.html -->
    <script is:inline>
        const liveTime = document.getElementById('live-time');
        if (liveTime) {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
            liveTime.textContent = `Hari ini, ${timeStr} WIB`;
        }

        let currentChartMetric = 'salur';

        function setChartMetric(metric) {
            currentChartMetric = metric;
            const btnSalur = document.getElementById('btn-chart-salur');
            const btnMasuk = document.getElementById('btn-chart-masuk');
            
            if (btnSalur && btnMasuk) {
                if (metric === 'salur') {
                    btnSalur.className = 'px-3 py-1.5 rounded-lg transition-all bg-primary text-on-primary font-bold shadow-xs cursor-pointer';
                    btnMasuk.className = 'px-3 py-1.5 rounded-lg transition-all text-on-surface-variant hover:text-on-surface font-semibold cursor-pointer';
                } else {
                    btnMasuk.className = 'px-3 py-1.5 rounded-lg transition-all bg-primary text-on-primary font-bold shadow-xs cursor-pointer';
                    btnSalur.className = 'px-3 py-1.5 rounded-lg transition-all text-on-surface-variant hover:text-on-surface font-semibold cursor-pointer';
                }
            }
            renderPublicReport();
        }

        function renderPublicReport() {
            if (!window.wizStore) return;

            const filterWilayah = document.getElementById('pub-filter-wilayah') ? document.getElementById('pub-filter-wilayah').value : 'Semua';
            const stats = wizStore.finance.getOverviewStats(filterWilayah);
            const fmt = wizStore.utils.formatRupiahCompact;

            const elMasuk = document.getElementById('pub-total-masuk');
            const elSalur = document.getElementById('pub-total-salur');
            const elSaldo = document.getElementById('pub-saldo');
            const elDonatur = document.getElementById('pub-donatur-count');

            if (elMasuk) elMasuk.textContent = fmt(stats.totalMasuk);
            if (elSalur) elSalur.textContent = fmt(stats.totalTersalurkan);
            if (elSaldo) elSaldo.textContent = fmt(stats.saldo);
            if (elDonatur) elDonatur.textContent = stats.totalDonatur.toLocaleString('id-ID');

            let disbList = wizStore.disbursements ? wizStore.disbursements.getAll() : [];
            if (filterWilayah && filterWilayah !== 'Semua') {
                disbList = disbList.filter(d => (d.wilayah || 'Pangkalpinang') === filterWilayah);
            }
            disbList = disbList.slice(0, 6);

            const disbContainer = document.getElementById('disbursement-history-list');
            if (disbContainer) {
                if (disbList.length === 0) {
                    disbContainer.innerHTML = `<p class="font-caption text-on-surface-variant p-sm">Belum ada riwayat penyaluran terbaru${filterWilayah !== 'Semua' ? ' untuk ' + filterWilayah : ''}.</p>`;
                } else {
                    disbContainer.innerHTML = disbList.map(d => `
                        <div class="pt-sm flex flex-col sm:flex-row justify-between sm:items-center gap-xs">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-caption text-caption font-bold text-tertiary-container uppercase">${d.program}</span>
                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">${d.wilayah || 'Pangkalpinang'}</span>
                                </div>
                                <p class="font-body-md text-on-surface font-semibold">${d.description}</p>
                                <p class="font-caption text-caption text-on-surface-variant">${wizStore.utils.formatDate(d.disbursedAt)}</p>
                            </div>
                            <div class="font-headline-md text-headline-md text-tertiary-container font-bold shrink-0">
                                ${fmt(d.amount)}
                            </div>
                        </div>`).join('');
                }
            }

            renderPillarDonutChart(filterWilayah, stats);
        }

        function renderPillarDonutChart(filterWilayah, overviewStats) {
            const containerChart = document.getElementById('pillar-chart-container');
            const containerLegend = document.getElementById('pillar-legend-container');
            if (!containerChart || !containerLegend || !window.wizStore) return;

            const fmt = wizStore.utils.formatRupiahCompact;
            const perPillars = wizStore.finance.getPerProgram(filterWilayah);

            const pillarDefs = [
                { key: 'Berkah Hidayah', label: 'Berkah Hidayah', color: '#047857', bg: 'bg-emerald-50 border-emerald-200 text-emerald-900', dot: 'bg-emerald-600' },
                { key: 'Berkah Juara', label: 'Berkah Juara', color: '#1d4ed8', bg: 'bg-blue-50 border-blue-200 text-blue-900', dot: 'bg-blue-600' },
                { key: 'Berkah Peduli', label: 'Berkah Peduli', color: '#d97706', bg: 'bg-amber-50 border-amber-200 text-amber-900', dot: 'bg-amber-600' },
                { key: 'Berkah Sehat', label: 'Berkah Sehat', color: '#be123c', bg: 'bg-rose-50 border-rose-200 text-rose-900', dot: 'bg-rose-600' },
                { key: 'Berkah Mandiri', label: 'Berkah Mandiri', color: '#7e22ce', bg: 'bg-purple-50 border-purple-200 text-purple-900', dot: 'bg-purple-600' }
            ];

            let grandTotal = 0;
            const pillarStats = pillarDefs.map(p => {
                const pData = perPillars.find(pp => pp.key === p.key);
                const amount = currentChartMetric === 'salur' 
                    ? (pData ? Number(pData.tersalurkan) || 0 : 0)
                    : (pData ? Number(pData.masuk) || 0 : 0);
                grandTotal += amount;
                return { ...p, amount };
            });

            const circumference = 2 * Math.PI * 65;
            let accumulatedOffset = 0;

            const strokeSegments = pillarStats.map(item => {
                const pct = grandTotal > 0 ? (item.amount / grandTotal) * 100 : 20;
                const strokeLength = (pct / 100) * circumference;
                const seg = `<circle cx="80" cy="80" r="65" fill="none" stroke="${item.color}" stroke-width="22" 
                    stroke-dasharray="${strokeLength.toFixed(1)} ${(circumference - strokeLength).toFixed(1)}" 
                    stroke-dashoffset="${(-accumulatedOffset).toFixed(1)}" class="transition-all duration-700 hover:opacity-85 cursor-pointer"></circle>`;
                accumulatedOffset += strokeLength;
                return seg;
            }).join('');

            containerChart.innerHTML = `
                <div class="relative flex items-center justify-center">
                    <svg width="200" height="200" viewBox="0 0 160 160" class="transform -rotate-90">
                        <circle cx="80" cy="80" r="65" fill="none" stroke="#f1f5f9" stroke-width="22"></circle>
                        ${strokeSegments}
                    </svg>
                    <div class="absolute flex flex-col items-center justify-center text-center p-2">
                        <span class="font-caption text-[11px] text-on-surface-variant font-semibold">${currentChartMetric === 'salur' ? 'Total Disalurkan' : 'Total Masuk'}</span>
                        <span class="font-headline-md font-extrabold text-primary text-base">${fmt(grandTotal)}</span>
                    </div>
                </div>
            `;

            containerLegend.innerHTML = pillarStats.map(item => {
                const pct = grandTotal > 0 ? Math.round((item.amount / grandTotal) * 100) : 0;
                return `
                <div class="p-3.5 rounded-xl border ${item.bg} flex items-center justify-between gap-3 shadow-xs">
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="w-3 h-3 rounded-full ${item.dot} shrink-0"></span>
                        <div class="min-w-0">
                            <h4 class="font-bold text-xs sm:text-sm text-on-surface truncate">${item.label}</h4>
                            <span class="text-[11px] opacity-75">${fmt(item.amount)}</span>
                        </div>
                    </div>
                    <span class="text-xs font-extrabold px-2 py-0.5 rounded-full bg-white border border-outline-variant/40 text-primary shrink-0">${pct}%</span>
                </div>`;
            }).join('');
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderPublicReport();
            if (window.wizStore && typeof window.wizStore.syncFromCloud === 'function') {
                window.wizStore.syncFromCloud(true).then(() => renderPublicReport()).catch(() => {});
            }
        });

        window.addEventListener('wiz-sync-complete', renderPublicReport);
    </script>
</BaseLayout>
