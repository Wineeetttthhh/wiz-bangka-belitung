    <!-- Script from donasi.html -->
    <script is:inline>
        const SPECIFIC_PROGRAMS = {
            'Berkah Hidayah': [
                "Pembangunan Markaz", "Pengadaan & Perbaikan Kendaraan", "Santunan Mualaf",
                "Pengadaan Celengan Sedekah Subuh", "Tahfidz Weekend", "Pelatihan Public Speaking",
                "Tabligh Akbar Dzhulhijjah", "Pelatihan Guru Dirosa", "Pelatihan Penyelenggaraan Jenazah",
                "Pelatihan Volunteer Media Dakwah", "Lomba Desain Poster Dakwah", "Kantor DPW WI Babel dan WIZ",
                "Mukerwil/Mukernas/Muktamar", "Keberangkatan Kepulangan Dai"
            ],
            'Berkah Peduli': [
                "Pray For NTT", "Tebar Sembako", "Sedekah Beras & Sembako Dhuafa", "Sedekah Beras Dhuafa",
                "Sedekah Jumat", "Santunan Yatim", "Tebar Iftar Nusantara", "Tebar Qur'an Nusantara",
                "Bahagiakan Guru Ngaji", "Sedekah Air Bersih", "Sedekah Air"
            ],
            'Berkah Juara': [
                "Beasiswa Pendidikan Juara", "Perlengkapan Belajar Yatim"
            ],
            'Berkah Sehat': [
                "Khitanan Massal Dhuafa", "Khitanan Massal", "Layanan Pengobatan Gratis", "Layanan Ambulance Ummat", "Ambulance Gratis Ummat"
            ],
            'Berkah Mandiri': [
                "Modal Usaha Mandiri Dhuafa", "Modal Usaha Dhuafa", "Bantuan Usaha Mikro", "Pelatihan Keterampilan Wirausaha"
            ]
        };

        function getProgramMap() {
            let map = JSON.parse(JSON.stringify(SPECIFIC_PROGRAMS));
            try {
                if (window.wizStore && window.wizStore.programs && typeof window.wizStore.programs.getPublished === 'function') {
                    const published = window.wizStore.programs.getPublished();
                    published.forEach(p => {
                        const pPillar = p.pillar || 'Berkah Peduli';
                        if (!map[pPillar]) map[pPillar] = [];
                        if (!map[pPillar].includes(p.title)) {
                            map[pPillar].unshift(p.title);
                        }
                    });
                }
            } catch(e) {}
            return map;
        }

        function findProgramDetails(inputName) {
            if (!inputName) return null;
            const clean = decodeURIComponent(inputName).trim();
            const lower = clean.toLowerCase();
            const slugified = lower.replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
            const spacified = lower.replace(/-/g, ' ').replace(/\s+/g, ' ');
            
            const staticList = (typeof window.STATIC_MASTER_PROGRAMS !== 'undefined' && Array.isArray(window.STATIC_MASTER_PROGRAMS))
                ? window.STATIC_MASTER_PROGRAMS
                : [];
            
            // 1. Check exact slug or title match in MASTER_PROGRAMS
            let match = staticList.find(p => {
                const pSlug = (p.slug || '').toLowerCase();
                const pTitle = (p.title || '').toLowerCase();
                const pTitleSlug = pTitle.replace(/[^a-z0-9]/g, '-');
                return pSlug === lower || pSlug === slugified || pTitle === lower || pTitle === spacified || pTitleSlug === slugified;
            });
            if (match) return match;

            // 2. Check partial contains match in MASTER_PROGRAMS
            match = staticList.find(p => {
                const pSlug = (p.slug || '').toLowerCase();
                const pTitle = (p.title || '').toLowerCase();
                return pSlug.includes(slugified) || slugified.includes(pSlug) || pTitle.includes(spacified) || spacified.includes(pTitle);
            });
            if (match) return match;

            // 3. Check published programs in local wizStore
            try {
                if (window.wizStore && window.wizStore.programs && typeof window.wizStore.programs.getAll === 'function') {
                    const all = window.wizStore.programs.getAll();
                    let storeMatch = all.find(p => {
                        const pSlug = (p.slug || '').toLowerCase();
                        const pTitle = (p.title || '').toLowerCase();
                        return pSlug === lower || pSlug === slugified || pTitle === lower || pTitle === spacified;
                    });
                    if (storeMatch) return storeMatch;
                }
            } catch(e) {}

            // 4. Check SPECIFIC_PROGRAMS dictionary
            const map = getProgramMap();
            for (const [cat, progs] of Object.entries(map)) {
                for (const p of progs) {
                    const pLower = p.toLowerCase();
                    const pSlug = pLower.replace(/[^a-z0-9]/g, '-');
                    if (pLower === lower || pLower === spacified || pSlug === slugified || pLower.includes(spacified) || spacified.includes(pLower)) {
                        let customImg = '/assets/images/foto-utama-wiz.jpg';
                        if (pLower.includes('pembangunan markaz') || pSlug.includes('pembangunan-markaz') || pLower.includes('markaz')) {
                            customImg = '/assets/images/pembangunan-markaz-dakwah.png';
                        } else if (pLower.includes('perlengkapan belajar') || pSlug.includes('perlengkapan-belajar')) {
                            customImg = '/assets/images/perlengkapan-belajar-yatim.png';
                        }
                        return {
                            title: p,
                            pillar: cat,
                            category: cat,
                            description: `Program kebaikan ${p} dalam pilar ${cat} yang dikelola secara amanah dan transparan oleh WIZ Bangka Belitung.`,
                            imageUrl: customImg,
                            location: 'Kepulauan Bangka Belitung',
                            beneficiaries: 'Mustahik & Santri'
                        };
                    }
                }
            }

            // Fallback object: format readable title from slug
            const formatted = clean.includes('-')
                ? clean.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')
                : clean;

            let customImg = '/assets/images/foto-utama-wiz.jpg';
            if (slugified.includes('pembangunan-markaz') || spacified.includes('pembangunan markaz') || spacified.includes('markaz')) {
                customImg = '/assets/images/pembangunan-markaz-dakwah.png';
            } else if (slugified.includes('perlengkapan-belajar') || spacified.includes('perlengkapan belajar')) {
                customImg = '/assets/images/perlengkapan-belajar-yatim.png';
            }

            return {
                title: formatted,
                pillar: 'Berkah Hidayah',
                category: 'Dakwah & Syiar',
                description: `Penyaluran donasi khusus program ${formatted} melalui Wahdah Inspirasi Zakat (WIZ) Bangka Belitung.`,
                imageUrl: customImg,
                location: 'Kepulauan Bangka Belitung',
                beneficiaries: 'Mustahik di Bangka Belitung'
            };
        }

        const state = {
            type: 'Infak Umum',
            wilayah: 'Pangkalpinang',
            category: '-',
            program: '-',
            nominal: 0,
            totalDonasi: 0,
            method: 'QRIS',
            donorName: '',
            donorPhone: '',
            donorMessage: '',
            activeRefObj: null,
            isSubmitting: false,
            isProgramLocked: false,
            lockedProgramData: null
        };
        window.donationState = state;

        function formatRupiah(number) {
            const num = Number(number) || 0;
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(num);
        }

        function lockProgram(prog) {
            if (!prog) return;
            state.isProgramLocked = true;
            state.program = prog.title || prog.name || '-';
            state.category = prog.pillar || prog.category || 'Berkah Peduli';
            state.type = 'Infak Terikat';
            state.lockedProgramData = prog;

            // Mark document root class
            document.documentElement.classList.add('has-locked-program');

            // Hide Step 1 Jenis Donasi & Manual Infak Terikat Flow / Notice
            const secJenis = document.getElementById('section-step-jenis');
            if (secJenis) secJenis.classList.add('hidden');

            const flow = document.getElementById('infak-terikat-flow');
            if (flow) flow.classList.add('hidden');

            const notice = document.getElementById('infak-umum-notice');
            if (notice) notice.classList.add('hidden');

            // Show & Populate Locked Program Card
            const lockCard = document.getElementById('locked-program-card');
            if (lockCard) {
                lockCard.classList.remove('hidden');

                const titleEl = document.getElementById('locked-program-title');
                const pillarEl = document.getElementById('locked-pillar-badge');
                const imgEl = document.getElementById('locked-program-img');
                const descEl = document.getElementById('locked-program-desc');
                const locEl = document.getElementById('locked-program-location');
                const benEl = document.getElementById('locked-program-beneficiary');
                const benWrap = document.getElementById('locked-program-beneficiary-wrap');

                if (titleEl) titleEl.textContent = prog.title || prog.name;
                if (pillarEl) pillarEl.textContent = (prog.pillar || prog.category || 'BERKAH PEDULI').toUpperCase();
                if (imgEl) {
                    const pSlug = (prog.slug || '').toLowerCase();
                    const pTitle = (prog.title || prog.name || '').toLowerCase();
                    let finalImg = prog.imageUrl || prog.image_url;
                    if (pSlug.includes('pembangunan-markaz') || pTitle.includes('pembangunan markaz') || pTitle.includes('markaz')) {
                        finalImg = '/assets/images/pembangunan-markaz-dakwah.png';
                    } else if (pSlug.includes('perlengkapan-belajar') || pTitle.includes('perlengkapan belajar')) {
                        finalImg = '/assets/images/perlengkapan-belajar-yatim.png';
                    }
                    imgEl.src = finalImg || '/assets/images/foto-utama-wiz.jpg';
                    imgEl.alt = prog.title || 'Foto Program';
                }
                if (descEl) descEl.textContent = prog.description || prog.fullDescription || 'Salurkan donasi terbaik Anda untuk program kebaikan ini.';
                if (locEl) locEl.textContent = `Lokasi: ${prog.location || 'Kepulauan Bangka Belitung'}`;
                if (benEl && prog.beneficiaries) {
                    benEl.textContent = prog.beneficiaries;
                    if (benWrap) benWrap.classList.remove('hidden');
                } else if (benWrap) {
                    benWrap.classList.add('hidden');
                }
            }

            updateStepNumbers(true);
            updateSummary();
        }
        window.lockProgram = lockProgram;

        function unlockProgramSelection() {
            state.isProgramLocked = false;
            state.program = '-';
            state.category = '-';
            state.type = 'Infak Umum';
            state.lockedProgramData = null;

            // Remove locked root class
            document.documentElement.classList.remove('has-locked-program');

            // Show Step 1 Jenis Donasi
            const secJenis = document.getElementById('section-step-jenis');
            if (secJenis) secJenis.classList.remove('hidden');

            // Hide Locked Program Card
            const lockCard = document.getElementById('locked-program-card');
            if (lockCard) lockCard.classList.add('hidden');

            // Check Infak Umum radio
            const radioUmum = document.querySelector('input[name="donation_type"][value="Infak Umum"]');
            if (radioUmum) {
                radioUmum.checked = true;
                handleTypeChange(radioUmum);
            }

            // Remove program param from URL without reload
            try {
                const url = new URL(window.location.href);
                url.searchParams.delete('program');
                url.searchParams.delete('p');
                url.searchParams.delete('title');
                url.searchParams.delete('slug');
                window.history.replaceState({}, '', url.toString());
            } catch(e) {}

            updateStepNumbers(false);
            updateRadioVisuals();
            updateSummary();
        }
        window.unlockProgramSelection = unlockProgramSelection;

        function updateStepNumbers(isLocked) {
            const numNominal = document.getElementById('step-num-nominal');
            const numWilayah = document.getElementById('step-num-wilayah');
            const numIdentitas = document.getElementById('step-num-identitas');
            const numMetode = document.getElementById('step-num-metode');

            if (isLocked) {
                if (numNominal) numNominal.textContent = '1';
                if (numWilayah) numWilayah.textContent = '2';
                if (numIdentitas) numIdentitas.textContent = '3';
                if (numMetode) numMetode.textContent = '4';
            } else {
                if (numNominal) numNominal.textContent = '2';
                if (numWilayah) numWilayah.textContent = '3';
                if (numIdentitas) numIdentitas.textContent = '4';
                if (numMetode) numMetode.textContent = '5';
            }
        }

        function setPayment(method) {
            state.method = method;
            const methodStr = String(method || '').toUpperCase();
            const isQris = methodStr.includes('QRIS') || (!methodStr.includes('BANK') && !methodStr.includes('TRANSFER'));
            
            const radioQris = document.querySelector('input[name="payment_method"][value="QRIS"]');
            const radioBank = document.querySelector('input[name="payment_method"][value="Bank Transfer"]');
            if (isQris && radioQris) radioQris.checked = true;
            if (!isQris && radioBank) radioBank.checked = true;
            
            updateRadioVisuals();
            updateSummary();
        }
        window.setPayment = setPayment;

        function updateRadioVisuals() {
            // 1. Jenis Donasi
            document.querySelectorAll('input[name="donation_type"]').forEach(radio => {
                const card = radio.closest('.option-card')?.querySelector('.option-card-inner');
                const iconCheck = radio.closest('.option-card')?.querySelector('.icon-check');
                if (card) {
                    if (radio.checked) {
                        card.classList.add('border-emerald-600', 'bg-emerald-50/70', 'ring-2', 'ring-emerald-500/20', 'shadow-sm');
                        card.classList.remove('border-slate-200', 'bg-white');
                        if (iconCheck) {
                            iconCheck.classList.remove('opacity-0', 'text-slate-300');
                            iconCheck.classList.add('opacity-100', 'text-emerald-600');
                        }
                    } else {
                        card.classList.remove('border-emerald-600', 'bg-emerald-50/70', 'ring-2', 'ring-emerald-500/20', 'shadow-sm');
                        card.classList.add('border-slate-200', 'bg-white');
                        if (iconCheck) {
                            iconCheck.classList.add('opacity-0', 'text-slate-300');
                            iconCheck.classList.remove('opacity-100', 'text-emerald-600');
                        }
                    }
                }
            });

            // 2. Wilayah
            document.querySelectorAll('input[name="wilayah"]').forEach(radio => {
                const card = radio.closest('.option-card')?.querySelector('.option-card-inner');
                const iconCheck = radio.closest('.option-card')?.querySelector('.icon-check');
                if (card) {
                    if (radio.checked) {
                        card.classList.add('border-emerald-600', 'bg-emerald-50/70', 'ring-2', 'ring-emerald-500/20', 'shadow-sm');
                        card.classList.remove('border-slate-200', 'bg-white');
                        if (iconCheck) {
                            iconCheck.classList.remove('opacity-0', 'text-slate-300');
                            iconCheck.classList.add('opacity-100', 'text-emerald-600');
                        }
                    } else {
                        card.classList.remove('border-emerald-600', 'bg-emerald-50/70', 'ring-2', 'ring-emerald-500/20', 'shadow-sm');
                        card.classList.add('border-slate-200', 'bg-white');
                        if (iconCheck) {
                            iconCheck.classList.add('opacity-0', 'text-slate-300');
                            iconCheck.classList.remove('opacity-100', 'text-emerald-600');
                        }
                    }
                }
            });

            // 3. Payment Method
            const methodStr = String(state.method || '').toUpperCase();
            const isQris = methodStr.includes('QRIS') || (!methodStr.includes('BANK') && !methodStr.includes('TRANSFER'));
            const cardQris = document.getElementById('payment-card-qris');
            const cardBank = document.getElementById('payment-card-bank');
            const checkQris = document.getElementById('check-qris');
            const checkBank = document.getElementById('check-bank');

            if (cardQris && cardBank) {
                if (isQris) {
                    cardQris.className = 'payment-method-card cursor-pointer relative block border-2 border-emerald-600 bg-emerald-50/70 rounded-2xl p-4 sm:p-5 transition-all shadow-sm ring-2 ring-emerald-500/20';
                    cardBank.className = 'payment-method-card cursor-pointer relative block border-2 border-slate-200 bg-white hover:border-emerald-500/50 rounded-2xl p-4 sm:p-5 transition-all shadow-xs';
                    if (checkQris) checkQris.style.display = 'block';
                    if (checkBank) checkBank.style.display = 'none';
                } else {
                    cardBank.className = 'payment-method-card cursor-pointer relative block border-2 border-emerald-600 bg-emerald-50/70 rounded-2xl p-4 sm:p-5 transition-all shadow-sm ring-2 ring-emerald-500/20';
                    cardQris.className = 'payment-method-card cursor-pointer relative block border-2 border-slate-200 bg-white hover:border-emerald-500/50 rounded-2xl p-4 sm:p-5 transition-all shadow-xs';
                    if (checkBank) checkBank.style.display = 'block';
                    if (checkQris) checkQris.style.display = 'none';
                }
            }
        }

        function renderInfakUmumNotice() {
            const titleEl = document.getElementById('infak-umum-title');
            const breakdownEl = document.getElementById('infak-umum-breakdown');
            const noticeBox = document.getElementById('infak-umum-notice');

            if (state.isProgramLocked || state.type !== 'Infak Umum') {
                if (noticeBox) noticeBox.classList.add('hidden');
                return;
            }

            if (noticeBox) noticeBox.classList.remove('hidden');
            if (titleEl) titleEl.textContent = `Alokasi Otomatis Infak Umum — Wilayah ${state.wilayah}`;

            const currentNominal = Number(state.totalDonasi || state.nominal) || 0;
            let items = [];
            if (window.wizStore && typeof window.wizStore.calcInfakUmumAllocation === 'function') {
                items = window.wizStore.calcInfakUmumAllocation(currentNominal, state.wilayah);
            }

            if (breakdownEl && items.length > 0) {
                breakdownEl.innerHTML = items.map(r => `
                    <div class="bg-white p-3 rounded-xl border border-emerald-200/60 shadow-xs flex flex-col justify-between">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-slate-800 font-bold text-xs truncate" title="${r.key}">${r.key}</span>
                            <span class="text-emerald-700 font-extrabold text-[11px] bg-emerald-100 px-2 py-0.5 rounded-full">${r.percent}%</span>
                        </div>
                        ${currentNominal > 0 ? `<div class="text-right font-mono font-bold text-xs text-emerald-700">${formatRupiah(r.amount)}</div>` : ''}
                    </div>
                `).join('');
            }
        }

        function handleTypeChange(radio) {
            if (state.isProgramLocked) return;
            state.type = radio.value;
            const flow = document.getElementById('infak-terikat-flow');
            const notice = document.getElementById('infak-umum-notice');

            if (state.type === 'Infak Terikat') {
                if (flow) flow.classList.remove('hidden');
                if (notice) notice.classList.add('hidden');
                if (state.category === '-' || !state.category) {
                    setProgramUtama('Berkah Peduli');
                }
            } else {
                if (flow) flow.classList.add('hidden');
                if (state.type === 'Infak Umum') {
                    if (notice) notice.classList.remove('hidden');
                } else {
                    if (notice) notice.classList.add('hidden');
                }
            }
            updateRadioVisuals();
            updateSummary();
        }

        function handleWilayahChange(radio) {
            state.wilayah = radio.value;
            updateRadioVisuals();
            updateSummary();
            if (typeof updateWhatsAppButtons === 'function') updateWhatsAppButtons();
        }

        function setProgramUtama(catName, btn) {
            state.category = catName;
            document.querySelectorAll('#program-utama-buttons .cat-btn').forEach(b => {
                b.classList.remove('active', 'border-emerald-600', 'bg-emerald-600', 'text-white');
                b.classList.add('border-slate-200', 'text-slate-700', 'bg-white');
            });
            if (btn) {
                btn.classList.add('active', 'border-emerald-600', 'bg-emerald-600', 'text-white');
                btn.classList.remove('border-slate-200', 'text-slate-700', 'bg-white');
            } else {
                const targetBtn = Array.from(document.querySelectorAll('#program-utama-buttons .cat-btn')).find(b => b.textContent.includes(catName.toUpperCase()));
                if (targetBtn) {
                    targetBtn.classList.add('active', 'border-emerald-600', 'bg-emerald-600', 'text-white');
                    targetBtn.classList.remove('border-slate-200', 'text-slate-700', 'bg-white');
                }
            }

            const select = document.getElementById('program-spesifik-select');
            if (select) {
                const map = getProgramMap();
                const list = map[catName] || [];
                select.innerHTML = `<option value="">-- Pilih Program Spesifik ${catName} --</option>` + list.map(p => `<option value="${p}">${p}</option>`).join('');
                if (list.length > 0) {
                    select.value = list[0];
                    setProgramSpesifik(list[0]);
                }
            }
            updateSummary();
        }

        function setProgramSpesifik(progName) {
            state.program = progName || '-';
            const detailCard = document.getElementById('program-detail-card');
            if (detailCard) {
                if (progName && progName !== '-') {
                    detailCard.classList.remove('hidden');
                    const titleEl = document.getElementById('detail-card-title');
                    if (titleEl) titleEl.textContent = progName;
                } else {
                    detailCard.classList.add('hidden');
                }
            }
            updateSummary();
        }

        function setNominal(amount) {
            const num = Number(amount) || 0;
            state.nominal = num;
            state.totalDonasi = num;
            const input = document.getElementById('custom_nominal');
            if (input) input.value = num > 0 ? num : '';

            document.querySelectorAll('#nominal-chips-wrap .chip-nominal').forEach(chip => {
                const chipNom = Number(chip.dataset.nominal) || 0;
                if (chipNom === num && num > 0) {
                    chip.className = 'chip-nominal py-3 px-2 border-2 border-emerald-600 bg-emerald-50 text-emerald-800 font-extrabold rounded-xl text-sm transition-all text-center cursor-pointer ring-2 ring-emerald-500/20 shadow-xs';
                } else {
                    chip.className = 'chip-nominal py-3 px-2 border-2 border-slate-200 bg-white text-slate-800 font-bold rounded-xl text-sm hover:border-emerald-600 hover:bg-emerald-50/40 transition-all text-center cursor-pointer';
                }
            });

            updateSummary();
        }
        window.setNominal = setNominal;

        function updateNominal(val) {
            const num = Number(val) || 0;
            state.nominal = num;
            state.totalDonasi = num;
            document.querySelectorAll('#nominal-chips-wrap .chip-nominal').forEach(chip => {
                const chipNom = Number(chip.dataset.nominal) || 0;
                if (chipNom === num && num > 0) {
                    chip.className = 'chip-nominal py-3 px-2 border-2 border-emerald-600 bg-emerald-50 text-emerald-800 font-extrabold rounded-xl text-sm transition-all text-center cursor-pointer ring-2 ring-emerald-500/20 shadow-xs';
                } else {
                    chip.className = 'chip-nominal py-3 px-2 border-2 border-slate-200 bg-white text-slate-800 font-bold rounded-xl text-sm hover:border-emerald-600 hover:bg-emerald-50/40 transition-all text-center cursor-pointer';
                }
            });
            updateSummary();
        }
        window.updateNominal = updateNominal;

        function toggleAnonymousDonor(checked) {
            const donorInput = document.getElementById('donor-name');
            if (donorInput) {
                if (checked) {
                    donorInput.value = 'Hamba Allah';
                    donorInput.setAttribute('disabled', 'true');
                    state.donorName = 'Hamba Allah';
                } else {
                    donorInput.value = '';
                    donorInput.removeAttribute('disabled');
                    state.donorName = '';
                }
            }
            updateSummary();
        }

        function updateSummary() {
            const sumType = document.getElementById('summary-type');
            const sumCat = document.getElementById('summary-cat');
            const sumProg = document.getElementById('summary-prog');
            const sumWil = document.getElementById('summary-wilayah');
            const sumMethod = document.getElementById('summary-method');
            const sumTotal = document.getElementById('summary-total');
            const mobileSumTotal = document.getElementById('mobile-summary-total');

            const catRow = document.getElementById('summary-cat-row');
            const progRow = document.getElementById('summary-prog-row');

            if (sumType) sumType.textContent = state.isProgramLocked ? 'Infak Terikat' : state.type;
            if (sumWil) sumWil.textContent = state.wilayah;
            if (sumMethod) sumMethod.textContent = state.method === 'QRIS' ? 'QRIS (Instan)' : 'Transfer Bank';
            
            const totalDisplay = (state.nominal && state.nominal > 0) ? formatRupiah(state.nominal) : 'Rp 0';
            if (sumTotal) sumTotal.textContent = totalDisplay;
            if (mobileSumTotal) mobileSumTotal.textContent = totalDisplay;

            if (state.isProgramLocked || (state.type === 'Infak Terikat' && state.program !== '-')) {
                if (catRow) catRow.classList.remove('hidden');
                if (progRow) progRow.classList.remove('hidden');
                if (sumCat) sumCat.textContent = state.category !== '-' ? state.category : 'Berkah Peduli';
                if (sumProg) sumProg.textContent = state.program !== '-' ? state.program : 'Pilih Program';
            } else {
                if (catRow) catRow.classList.add('hidden');
                if (progRow) progRow.classList.add('hidden');
            }

            const activeRef = (typeof getActiveAffiliateRef === 'function') ? getActiveAffiliateRef() : (sessionStorage.getItem('wiz_active_ref_id') || localStorage.getItem('wiz_ref_code') || '');
            const refRow = document.getElementById('summary-ref-row');
            const refName = document.getElementById('summary-ref-name');
            if (refRow && refName) {
                if (activeRef) {
                    refRow.classList.remove('hidden');
                    refName.textContent = activeRef;
                } else {
                    refRow.classList.add('hidden');
                }
            }

            renderInfakUmumNotice();
        }

        function handleCheckoutSubmit(e) {
            if (e) {
                if (typeof e.preventDefault === 'function') e.preventDefault();
                if (typeof e.stopPropagation === 'function') e.stopPropagation();
            }

            const nameEl = document.getElementById('donor-name');
            const phoneEl = document.getElementById('donor-phone');
            const msgEl = document.getElementById('donor-message');
            const nominalInput = document.getElementById('custom_nominal');

            const isAnon = document.getElementById('is-anonymous-donor')?.checked;
            state.donorName = isAnon ? 'Hamba Allah' : (nameEl?.value?.trim() || 'Hamba Allah');
            state.donorPhone = phoneEl?.value?.trim() || '';
            state.donorMessage = msgEl?.value?.trim() || '';

            // Nominal validation - don't default if donor hasn't chosen
            let currentNominal = Number(state.nominal) || 0;
            const inputVal = Number(nominalInput?.value) || 0;
            if (inputVal >= 1000) {
                currentNominal = inputVal;
            }
            if (currentNominal < 1000) {
                alert('⚠️ Mohon masukkan atau pilih nominal donasi terlebih dahulu.');
                if (nominalInput) {
                    nominalInput.focus();
                    nominalInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return false;
            }
            state.nominal = currentNominal;
            state.totalDonasi = currentNominal;

            // Direct check on radio
            const checkedMethod = document.querySelector('input[name="payment_method"]:checked');
            if (checkedMethod && checkedMethod.value) {
                state.method = checkedMethod.value;
            } else if (!state.method) {
                state.method = 'QRIS';
            }

            if (!state.isProgramLocked) {
                const checkedType = document.querySelector('input[name="donation_type"]:checked');
                if (checkedType && checkedType.value) state.type = checkedType.value;
            } else {
                state.type = 'Infak Terikat';
            }

            const checkedWilayah = document.querySelector('input[name="wilayah"]:checked');
            if (checkedWilayah && checkedWilayah.value) state.wilayah = checkedWilayah.value;

            // 🚀 Determine Payment Method (QRIS vs Bank)
            const methodStr = String(state.method || '').toUpperCase();
            const isQris = methodStr.includes('QRIS') || (!methodStr.includes('BANK') && !methodStr.includes('TRANSFER'));

            console.log('[Donasi] Submitting checkout: method=', state.method, 'isQris=', isQris, 'nominal=', state.nominal, 'program=', state.program);

            if (isQris) {
                openQRISModal();
            } else {
                openBankModal();
            }

            // Save donation record to store and Supabase in background
            try {
                if (window.wizStore && window.wizStore.donations) {
                    const activeRef = (typeof getActiveAffiliateRef === 'function') ? getActiveAffiliateRef() : (sessionStorage.getItem('wiz_active_ref_id') || localStorage.getItem('wiz_ref_code') || '');
                    const progName = (state.type === 'Infak Terikat' && state.program !== '-') ? state.program : state.type;
                    window.wizStore.donations.add({
                        donorName: state.donorName,
                        donorPhone: state.donorPhone,
                        amount: state.nominal,
                        program: progName,
                        pillar: (state.category && state.category !== '-') ? state.category : 'Berkah Peduli',
                        type: state.type,
                        method: isQris ? 'QRIS' : 'Transfer Bank (BSI)',
                        wilayah: state.wilayah,
                        message: state.donorMessage,
                        referralCode: activeRef || undefined
                    }).catch(err => console.warn('Background save note:', err));
                }
            } catch(err) {
                console.warn('Background save note:', err);
            }
        }
        window.handleCheckoutSubmit = handleCheckoutSubmit;

