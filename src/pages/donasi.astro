            if (bankModal) {
                bankModal.classList.remove('show', 'active');
                bankModal.style.cssText = 'display: none !important; opacity: 0 !important; visibility: hidden !important; pointer-events: none !important;';
                document.body.style.overflow = '';
            }
        }
        window.closeBankModal = closeBankModal;

        function copyAccount(accNum) {
            const clean = String(accNum || '').trim();
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(clean).then(() => {
                    alert(`✅ Nomor rekening ${clean} berhasil disalin!`);
                }).catch(() => {
                    alert(`✅ Nomor rekening ${clean} berhasil disalin!`);
                });
            } else {
                alert(`✅ Nomor rekening ${clean} berhasil disalin!`);
            }
        }
        window.copyAccount = copyAccount;

        function generateWhatsAppMessage(method) {
            let progText = `• *Jenis*: ${state.type}%0A• *Wilayah*: ${state.wilayah}`;
            if ((state.isProgramLocked || state.type === 'Infak Terikat') && state.program !== '-') {
                progText = `• *Jenis*: Infak Terikat (Program Terpilih)%0A• *Program*: ${state.program}%0A• *Pilar*: ${state.category}%0A• *Wilayah*: ${state.wilayah}`;
            }

            const activeRef = (typeof getActiveAffiliateRef === 'function') ? getActiveAffiliateRef() : (sessionStorage.getItem('wiz_active_ref_id') || localStorage.getItem('wiz_ref_code') || '');
            let refText = '';
            if (activeRef) {
                refText = `%0A• *ID Mitra*: ${activeRef}`;
            }

            return `Bismillah, saya *${state.donorName || 'Hamba Allah'}* (${state.donorPhone || '-'}) ingin mengonfirmasi *${method}*:%0A%0A• *Lembaga*: WIZ Bangka Belitung%0A${progText}%0A• *Nominal*: ${formatRupiah(state.nominal)}${refText}%0A• *Metode*: ${method}%0A• *Doa/Pesan*: ${state.donorMessage || '-'}`;
        }

        function confirmQRISToWhatsApp(e) {
            const branch = getTargetWhatsAppConfig(state.wilayah);
            const text = generateWhatsAppMessage('QRIS (Otomatis & Instan)');
            const targetUrl = `https://wa.me/${branch.waNumber}?text=${text}`;
            const qrisBtn = document.getElementById('qris-wa-btn');
            if (qrisBtn) {
                qrisBtn.href = targetUrl;
            }
        }

        function confirmBankToWhatsApp(e) {
            const branch = getTargetWhatsAppConfig(state.wilayah);
            const text = generateWhatsAppMessage('Transfer Bank Manual');
            const targetUrl = `https://wa.me/${branch.waNumber}?text=${text}`;
            const bankBtn = document.getElementById('bank-wa-btn');
            if (bankBtn) {
                bankBtn.href = targetUrl;
            }
        }

        async function downloadQRISImage() {
            const imgEl = document.getElementById('qris-modal-img');
            const src = imgEl ? imgEl.src : '/assets/images/qris-code-wiz-babel.png';
            try {
                const response = await fetch(src);
                const blob = await response.blob();
                const blobUrl = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = blobUrl;
                a.download = 'QRIS-Donasi-WIZ-Bangka-Belitung.png';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                setTimeout(() => URL.revokeObjectURL(blobUrl), 2000);
            } catch (err) {
                const a = document.createElement('a');
                a.href = src;
                a.download = 'QRIS-Donasi-WIZ-Bangka-Belitung.png';
                a.target = '_blank';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }
        }
        window.downloadQRISImage = downloadQRISImage;

        // Close on Escape key press
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeQRISModal();
                closeBankModal();
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const nominalParam = urlParams.get('nominal') || urlParams.get('amount');
            const programParam = urlParams.get('program') || urlParams.get('title') || urlParams.get('p') || urlParams.get('slug');
            const typeParam = urlParams.get('type') || urlParams.get('t');
            const wilayahParam = urlParams.get('wilayah') || urlParams.get('branch') || urlParams.get('w');
            const refParam = urlParams.get('ref') || urlParams.get('affiliate') || urlParams.get('mitra') || urlParams.get('id');

            if (refParam) {
                sessionStorage.setItem('wiz_active_ref_id', refParam.trim().toUpperCase());
            }

            if (wilayahParam) {
                const radioWil = Array.from(document.querySelectorAll('input[name="wilayah"]')).find(r => r.value.toLowerCase() === wilayahParam.toLowerCase());
                if (radioWil) {
                    radioWil.checked = true;
                    handleWilayahChange(radioWil);
                }
            }

            if (programParam) {
                // Program locked flow!
                const matched = findProgramDetails(programParam);
                if (matched) {
                    lockProgram(matched);
                }
            } else if (typeParam) {
                const radio = Array.from(document.querySelectorAll('input[name="donation_type"]')).find(r => r.value.toLowerCase() === typeParam.toLowerCase());
                if (radio) {
                    radio.checked = true;
                    handleTypeChange(radio);
                }
            }

            if (nominalParam) {
                setNominal(Number(nominalParam));
            } else {
                state.nominal = 0;
                state.totalDonasi = 0;
                const input = document.getElementById('custom_nominal');
                if (input) input.value = '';
                document.querySelectorAll('#nominal-chips-wrap .chip-nominal').forEach(chip => {
                    chip.className = 'chip-nominal py-3 px-2 border-2 border-slate-200 bg-white text-slate-800 font-bold rounded-xl text-sm hover:border-emerald-600 hover:bg-emerald-50/40 transition-all text-center cursor-pointer';
                });
            }

            const nameParam = urlParams.get('name') || urlParams.get('donor');
            const phoneParam = urlParams.get('phone') || urlParams.get('hp');
            const msgParam = urlParams.get('msg') || urlParams.get('message') || urlParams.get('doa');
            if (nameParam) {
                const el = document.getElementById('donor-name');
                if (el) el.value = nameParam;
                state.donorName = nameParam;
            }
            if (phoneParam) {
                const el = document.getElementById('donor-phone');
                if (el) el.value = phoneParam;
                state.donorPhone = phoneParam;
            }
            if (msgParam) {
                const el = document.getElementById('donor-message');
                if (el) el.value = msgParam;
                state.donorMessage = msgParam;
            }

            updateRadioVisuals();
            updateSummary();

            const checkoutBtn = document.getElementById('checkout-submit-btn');
            if (checkoutBtn) {
                checkoutBtn.addEventListener('click', (e) => {
                    handleCheckoutSubmit(e);
                });
            }

            const checkoutForm = document.getElementById('donation-checkout-form');
            if (checkoutForm) {
                checkoutForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    handleCheckoutSubmit(e);
                    return false;
                });
            }
        });
    </script>

    <!-- WIZ MODAL OVERRIDE: Runs LAST, tidak bisa ditimpa script manapun -->
    <script is:inline>
    (function() {
        'use strict';
        function _fmt(n) {
            return new Intl.NumberFormat('id-ID', {style:'currency',currency:'IDR',minimumFractionDigits:0}).format(Number(n)||0);
        }
        function _showModal(id) {
            var m = document.getElementById(id);
            if (!m) { console.error('[WIZ] Modal tidak ditemukan:', id); return; }
            if (m.parentNode !== document.body) document.body.appendChild(m);
            m.style.cssText = [
                'display:flex','position:fixed','inset:0','top:0','left:0','right:0','bottom:0',
                'width:100%','height:100%','z-index:2147483647',
                'background:rgba(0,0,0,0.85)',
                'align-items:center','justify-content:center',
                'padding:1rem','overflow-y:auto',
                'opacity:1','visibility:visible','pointer-events:auto'
            ].join('!important;') + '!important';
            m.classList.add('show','active');
            document.body.style.overflow = 'hidden';
            var d = m.querySelector('.modal-dialog');
            if (d) d.style.cssText = [
                'display:block','position:relative','z-index:2147483647',
                'opacity:1','visibility:visible','max-height:90vh',
                'overflow-y:auto','margin:auto','transform:translateY(0)',
                'background:#fff','border-radius:1.5rem','width:100%',
                'max-width:32rem','box-shadow:0 25px 60px rgba(0,0,0,0.5)'
            ].join('!important;') + '!important';
            console.log('[WIZ] Modal terbuka:', id);
        }
        function _hideModal(id) {
            var m = document.getElementById(id);
            if (m) { m.style.cssText = 'display:none!important;'; m.classList.remove('show','active'); document.body.style.overflow = ''; }
        }

        function _resolveNominal(s) {
            var n = Number(s.nominal || s.totalDonasi) || 0;
            if (n <= 0) {
                var cEl = document.getElementById('custom_nominal');
                if (cEl && Number(cEl.value) >= 1000) n = Number(cEl.value);
            }
            if (n <= 0) {
                var sumEl = document.getElementById('summary-total');
                if (sumEl) {
                    var cleanNom = Number(sumEl.textContent.replace(/[^0-9]/g, ''));
                    if (cleanNom >= 1000) n = cleanNom;
                }
            }
            if (n <= 0) n = 25000;
            s.nominal = n; s.totalDonasi = n;
            return n;
        }

        window.openQRISModal = function() {
            var s = window.donationState || {};
            var n = _resolveNominal(s);
            var el;
            el = document.getElementById('qris-modal-total'); if(el) el.textContent = _fmt(n);
            var progLabel = (s.isProgramLocked || (s.type==='Infak Terikat' && s.program!=='-')) ? s.program : (s.type || 'Infak Umum');
            el = document.getElementById('qris-modal-donor'); if(el) el.textContent = 'Donatur: '+(s.donorName||'Hamba Allah')+' ('+progLabel+')';
            el = document.getElementById('qris-modal-img'); if(el) { el.src = '/assets/images/qris-code-wiz-babel.png'; el.onerror = null; }
            if (typeof updateWhatsAppButtons === 'function') { try { updateWhatsAppButtons(); } catch(e) {} }
            _showModal('qris-modal');
        };
        window.closeQRISModal = function() { _hideModal('qris-modal'); };

        window.openBankModal = function() {
            var s = window.donationState || {};
            var n = _resolveNominal(s);
            var el;
            el = document.getElementById('bank-modal-total'); if(el) el.textContent = _fmt(n);
            var progLabel = (s.isProgramLocked || (s.type==='Infak Terikat' && s.program!=='-')) ? s.program : (s.type || 'Infak Umum');
            el = document.getElementById('bank-modal-donor'); if(el) el.textContent = 'Donatur: '+(s.donorName||'Hamba Allah')+' ('+progLabel+')';
            if (typeof updateWhatsAppButtons === 'function') { try { updateWhatsAppButtons(); } catch(e) {} }
            _showModal('bank-modal');
        };
        window.closeBankModal = function() { _hideModal('bank-modal'); };

        window.handleCheckoutSubmit = function(e) {
            if (e) { if(e.preventDefault) e.preventDefault(); if(e.stopPropagation) e.stopPropagation(); }
            var s = window.donationState;
            if (!s) { s = {method:'QRIS',nominal:0,type:'Infak Umum',wilayah:'Pangkalpinang',donorName:'',donorPhone:'',donorMessage:'',category:'-',program:'-'}; window.donationState = s; }

            var el;
            el = document.getElementById('is-anonymous-donor');
            var isAnon = el && el.checked;
            el = document.getElementById('donor-name');
            s.donorName = isAnon ? 'Hamba Allah' : ((el && el.value.trim()) || 'Hamba Allah');
            el = document.getElementById('donor-phone'); if(el) s.donorPhone = el.value.trim();
            el = document.getElementById('donor-message'); if(el) s.donorMessage = el.value.trim();

            var nom = Number(s.nominal) || 0;
            el = document.getElementById('custom_nominal');
            var customVal = el ? (Number(el.value) || 0) : 0;
            if (customVal > 0) nom = customVal;

            if (nom < 1000) {
                var sumEl = document.getElementById('summary-total');
                if (sumEl) {
                    var cleanNom = Number(sumEl.textContent.replace(/[^0-9]/g, ''));
                    if (cleanNom >= 1000) nom = cleanNom;
                }
            }

            if (nom < 1000) {
                alert('⚠️ Mohon masukkan atau pilih nominal donasi terlebih dahulu.');
                if (el) {
                    el.focus();
                    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return false;
            }

            s.nominal = nom; s.totalDonasi = nom;

            var r;
            r = document.querySelector('input[name="payment_method"]:checked'); if(r) s.method = r.value;
            r = document.querySelector('input[name="wilayah"]:checked'); if(r) s.wilayah = r.value;
            if (!s.isProgramLocked) {
                r = document.querySelector('input[name="donation_type"]:checked'); if(r) s.type = r.value;
            } else {
                s.type = 'Infak Terikat';
            }

            var ms = (s.method||'').toUpperCase();
            var isQris = ms.includes('QRIS') || (!ms.includes('BANK') && !ms.includes('TRANSFER'));
            console.log('[WIZ] Submit: method='+s.method+' isQris='+isQris+' nominal='+nom+' program='+s.program);

            if (isQris) { window.openQRISModal(); } else { window.openBankModal(); }

            try {
                var activeRef = (typeof getActiveAffiliateRef === 'function') ? getActiveAffiliateRef() : (sessionStorage.getItem('wiz_active_ref_id') || localStorage.getItem('wiz_ref_code') || localStorage.getItem('wiz_active_ref_id') || '');
                var finalProg = (s.isProgramLocked || (s.type==='Infak Terikat'&&s.program!=='-')) ? s.program : s.type;
                var refRate = 6;
                var refFee = activeRef ? Math.round(nom * (refRate / 100)) : 0;

                if (window.wizSupabase && typeof window.wizSupabase.saveDonation === 'function') {
                    window.wizSupabase.saveDonation({
                        donor_name: s.donorName,
                        donor_phone: s.donorPhone,
                        program_title: finalProg,
                        program_spesifik: finalProg,
                        donation_type: s.type,
                        amount: nom,
                        payment_method: isQris ? 'QRIS' : 'Transfer Bank (BSI)',
                        notes: s.donorMessage,
                        referral_id: activeRef || null,
                        referral_code: activeRef || null,
                        referral_rate: refRate,
                        referral_fee: refFee,
                        status: 'pending',
                        wilayah: s.wilayah || 'Pangkalpinang'
                    }).catch(function(err){ console.warn('[WIZ] Supabase save note:', err); });
                }

                if (window.wizStore && window.wizStore.donations && window.wizStore.donations.add) {
                    window.wizStore.donations.add({
                        donorName: s.donorName, donorPhone: s.donorPhone, amount: nom,
                        program: finalProg,
                        pillar: (s.category && s.category !== '-') ? s.category : 'Berkah Peduli',
                        type: s.type, method: isQris ? 'QRIS' : 'Transfer Bank (BSI)',
                        wilayah: s.wilayah || 'Pangkalpinang', message: s.donorMessage,
                        referralId: activeRef || null,
                        referralCode: activeRef || null,
                        referral_code: activeRef || null,
                        referralRate: refRate,
                        referralFee: refFee,
                        status: 'pending'
                    }).catch(function(){});
                }
            } catch(err) {}
            return false;
        };

        // Pasang ke tombol menggunakan capture phase - tidak bisa diblokir event lain
        function _attachBtn() {
            var btn = document.getElementById('checkout-submit-btn');
            if (btn) {
                var fresh = btn.cloneNode(true);
                btn.parentNode.replaceChild(fresh, btn);
                fresh.addEventListener('click', function(ev) {
                    ev.preventDefault();
                    ev.stopImmediatePropagation();
                    window.handleCheckoutSubmit(ev);
                    return false;
                }, true);
                console.log('[WIZ] Tombol checkout override terpasang ✓');
            }
            document.addEventListener('keydown', function(ev) {
                if (ev.key === 'Escape') { window.closeQRISModal(); window.closeBankModal(); }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', _attachBtn);
        } else {
            _attachBtn();
        }

        console.log('[WIZ] Override script aktif ✓');
    })();
    </script>
</BaseLayout>
