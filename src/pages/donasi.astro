---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MASTER_PROGRAMS } from '../lib/programs-data';
---

<BaseLayout
    title="WIZ Babel - Form Donasi Online"
    description="Selesaikan donasi Zakat, Infak, dan Sedekah Anda secara aman, cepat, dan transparan bersama Wahdah Inspirasi Zakat (WIZ) Bangka Belitung."
    image="/assets/images/sedekah-beras-dhuafa.jpg"
>
    <!-- CRITICAL INSTANT PROGRAM LOCKING ENGINE (0ms Delay) -->
    <script is:inline define:vars={{ masterPrograms: MASTER_PROGRAMS }}>
        window.STATIC_MASTER_PROGRAMS = masterPrograms || [];
        (function() {
            try {
                var sp = new URLSearchParams(window.location.search);
                var prog = sp.get('program') || sp.get('p') || sp.get('title') || sp.get('slug');
                if (prog && prog.trim()) {
                    document.documentElement.classList.add('has-locked-program');
                }
            } catch(e) {}
        })();
    </script>
    <style is:global>
        html.has-locked-program #section-step-jenis,
        html.has-locked-program #infak-terikat-flow,
        html.has-locked-program #infak-umum-notice {
            display: none !important;
        }
        html.has-locked-program #locked-program-card {
            display: block !important;
        }
    </style>

    <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 lg:pb-16">
        <!-- Hero Banner Header -->
        <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-br from-[#004d26] via-[#006834] to-[#004225] text-white p-6 sm:p-10 mb-8 shadow-xl border border-emerald-600/30">
            <div class="absolute -right-16 -top-16 w-72 h-72 bg-emerald-400/15 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -left-12 -bottom-12 w-64 h-64 bg-teal-400/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10 max-w-3xl">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-emerald-200 text-xs font-bold tracking-wide uppercase mb-3.5 backdrop-blur-md">
                    <span class="material-symbols-outlined text-sm text-emerald-300">verified_user</span>
                    <span>Lembaga Amil Zakat Resmi &amp; Terpercaya</span>
                </div>
                <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-2.5">
                    Salurkan Infaq, Zakat &amp; Sedekah Terbaik Anda
                </h1>
                <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed">
                    Setiap rupiah yang Anda tunaikan akan dikelola secara amanah, transparan, dan disalurkan tepat sasaran kepada para mustahik di Kepulauan Bangka Belitung.
                </p>
            </div>
        </div>

        <form id="donation-checkout-form" onsubmit="handleCheckoutSubmit(event); return false;">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start relative">

                <!-- Left Column: Step-by-Step Form -->
                <div class="lg:col-span-8 space-y-6">

                    <!-- 🔒 Program Terpilih & Terkunci Banner (Shown only when program is locked) -->
                    <div id="locked-program-card" class="hidden bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 border-2 border-emerald-500/40 shadow-md space-y-4 transition-all duration-300 relative overflow-hidden">
                        <div class="absolute -right-10 -bottom-10 w-44 h-44 bg-emerald-100/50 rounded-full blur-2xl pointer-events-none"></div>
                        
                        <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-slate-100 pb-3.5">
                            <div class="flex items-center gap-2.5">
                                <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-sm shadow-2xs border border-emerald-200">
                                    <span class="material-symbols-outlined text-base">lock</span>
                                </span>
                                <span class="text-xs sm:text-sm font-extrabold text-emerald-950 uppercase tracking-wide">Program Kebaikan Terpilih</span>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <span id="locked-pillar-badge" class="bg-emerald-600 text-white text-xs sm:text-sm font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider shadow-2xs">
                                    BERKAH HIDAYAH
                                </span>
                                <button type="button" onclick="unlockProgramSelection()" class="text-xs sm:text-sm font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 px-3 py-1 rounded-lg border border-emerald-200 flex items-center gap-1 cursor-pointer transition-colors" title="Pilih program lain atau jenis donasi umum">
                                    <span class="material-symbols-outlined text-base">swap_horiz</span> Ganti Program
                                </button>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 items-start">
                            <div class="relative w-28 sm:w-36 aspect-[3/4] h-auto rounded-2xl overflow-hidden bg-slate-100 shrink-0 border border-slate-200 shadow-2xs">
                                <img id="locked-program-img" src="/assets/images/foto-utama-wiz.jpg" onerror="this.onerror=null; this.src='/assets/images/foto-utama-wiz.jpg';" alt="Foto Program" class="w-full h-full object-cover">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/30 via-transparent to-transparent"></div>
                            </div>
                            <div class="flex-1 space-y-2.5 min-w-0 w-full">
                                <h3 id="locked-program-title" class="text-xl sm:text-2xl font-extrabold text-slate-900 leading-snug">
                                    Nama Program Kebaikan
                                </h3>
                                
                                <div class="flex flex-wrap items-center gap-2">
                                    <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 border border-emerald-200/80 px-3 py-1 rounded-lg text-xs sm:text-sm font-semibold">
                                        <span class="material-symbols-outlined text-base text-emerald-700">pin_drop</span>
                                        <span id="locked-program-location">Lokasi: Kepulauan Bangka Belitung</span>
                                    </div>
                                    <div id="locked-program-beneficiary-wrap" class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-800 border border-blue-200/80 px-3 py-1 rounded-lg text-xs sm:text-sm font-semibold">
                                        <span class="material-symbols-outlined text-base text-blue-700">group</span>
                                        <span id="locked-program-beneficiary">Mustahik &amp; Santri</span>
                                    </div>
                                </div>

                                <p id="locked-program-desc" class="text-sm sm:text-base text-slate-700 leading-relaxed line-clamp-3 font-normal">
                                    Deskripsi program kebaikan...
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Instant Synchronous Population Script (Executes inline with 0ms delay) -->
                    <script is:inline>
                    (function() {
                        try {
                            var sp = new URLSearchParams(window.location.search);
                            var progParam = sp.get('program') || sp.get('p') || sp.get('title') || sp.get('slug');
                            if (progParam) {
                                var raw = decodeURIComponent(progParam).trim();
                                var slugified = raw.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
                                var spacified = raw.toLowerCase().replace(/-/g, ' ').replace(/\s+/g, ' ');
                                var titleEl = document.getElementById('locked-program-title');
                                var pillarEl = document.getElementById('locked-pillar-badge');
                                var imgEl = document.getElementById('locked-program-img');
                                var descEl = document.getElementById('locked-program-desc');
                                var locEl = document.getElementById('locked-program-location');
                                var benEl = document.getElementById('locked-program-beneficiary');
                                
                                var staticList = window.STATIC_MASTER_PROGRAMS || [];
                                var found = staticList.find(function(p) {
                                    var pSlug = (p.slug || '').toLowerCase();
                                    var pTitle = (p.title || '').toLowerCase();
                                    return pSlug === slugified || pTitle === spacified || pSlug.includes(slugified) || pTitle.includes(spacified);
                                });
                                
                                if (found) {
                                    if (titleEl) titleEl.textContent = found.title;
                                    if (pillarEl) pillarEl.textContent = (found.pillar || found.category || 'BERKAH HIDAYAH').toUpperCase();
                                    var targetImg = found.imageUrl || found.image_url;
                                    if (slugified.includes('pembangunan-markaz') || spacified.includes('pembangunan markaz') || spacified.includes('markaz')) {
                                        targetImg = '/assets/images/pembangunan-markaz-dakwah.png';
                                    } else if (slugified.includes('perlengkapan-belajar') || spacified.includes('perlengkapan belajar')) {
                                        targetImg = '/assets/images/perlengkapan-belajar-yatim.png';
                                    }
                                    if (imgEl && targetImg) imgEl.src = targetImg;
                                    if (descEl) descEl.textContent = found.description || found.fullDescription || 'Salurkan donasi terbaik Anda untuk program kebaikan ini.';
                                    if (locEl) locEl.textContent = 'Lokasi: ' + (found.location || 'Kepulauan Bangka Belitung');
                                    if (benEl) benEl.textContent = found.beneficiaries || 'Mustahik & Santri';
                                } else {
                                    var formatted = raw.includes('-') ? raw.split('-').map(function(w){ return w.charAt(0).toUpperCase() + w.slice(1); }).join(' ') : raw;
                                    if (titleEl) titleEl.textContent = formatted;
                                    if (slugified.includes('pembangunan-markaz') || spacified.includes('pembangunan markaz') || spacified.includes('markaz')) {
                                        if (imgEl) imgEl.src = '/assets/images/pembangunan-markaz-dakwah.png';
                                    } else if (slugified.includes('perlengkapan-belajar') || spacified.includes('perlengkapan belajar')) {
                                        if (imgEl) imgEl.src = '/assets/images/perlengkapan-belajar-yatim.png';
                                    }
                                }
                            }
                        } catch(e) {}
                    })();
                    </script>

                    <!-- Step 1: Jenis Donasi (Hidden when program is locked) -->
                    <section id="section-step-jenis" class="bg-white rounded-2xl p-5 sm:p-7 shadow-sm border border-slate-200/80 transition-all hover:shadow-md">
                        <div class="flex items-center gap-3.5 mb-5 pb-3.5 border-b border-slate-100">
                            <span id="step-num-jenis" class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center text-sm sm:text-base border border-emerald-300">1</span>
                            <div>
                                <h2 class="text-lg sm:text-xl font-bold text-slate-900">Pilih Jenis Donasi</h2>
                                <p class="text-xs sm:text-sm text-slate-500">Tentukan akad dan peruntukan donasi yang ingin Anda tunaikan</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5" id="donation-types-grid">
                            <!-- Infak Umum -->
                            <label class="option-card cursor-pointer relative block group">
                                <input class="peer sr-only" name="donation_type" onchange="handleTypeChange(this)" type="radio" value="Infak Umum" checked />
                                <div class="option-card-inner border-2 border-emerald-600 bg-emerald-50/70 ring-2 ring-emerald-500/20 shadow-sm rounded-2xl p-4 sm:p-5 transition-all duration-200 h-full flex flex-col justify-between">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-200">
                                            <span class="material-symbols-outlined text-2xl">volunteer_activism</span>
                                        </div>
                                        <span class="material-symbols-outlined icon-check text-emerald-600 opacity-100 transition-all text-2xl font-bold">check_circle</span>
                                    </div>
                                    <div>
                                        <span class="font-extrabold text-slate-900 block text-base sm:text-lg mb-1">Infak Umum</span>
                                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Dana umum fleksibel untuk operasional dakwah &amp; sosial.</p>
                                    </div>
                                </div>
                            </label>

                            <!-- Infak Terikat -->
                            <label class="option-card cursor-pointer relative block group">
                                <input class="peer sr-only" name="donation_type" onchange="handleTypeChange(this)" type="radio" value="Infak Terikat" />
                                <div class="option-card-inner border-2 border-slate-200 bg-white hover:border-emerald-500/60 rounded-2xl p-4 sm:p-5 transition-all duration-200 h-full flex flex-col justify-between">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center shrink-0 border border-blue-100">
                                            <span class="material-symbols-outlined text-2xl">handshake</span>
                                        </div>
                                        <span class="material-symbols-outlined icon-check text-slate-300 opacity-0 transition-all text-2xl font-bold">check_circle</span>
                                    </div>
                                    <div>
                                        <span class="font-extrabold text-slate-900 block text-base sm:text-lg mb-1">Infak Terikat</span>
                                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Donasi khusus program tertentu (5 Berkah WIZ).</p>
                                    </div>
                                </div>
                            </label>

                            <!-- Zakat -->
                            <label class="option-card cursor-pointer relative block group">
                                <input class="peer sr-only" name="donation_type" onchange="handleTypeChange(this)" type="radio" value="Zakat" />
                                <div class="option-card-inner border-2 border-slate-200 bg-white hover:border-emerald-500/60 rounded-2xl p-4 sm:p-5 transition-all duration-200 h-full flex flex-col justify-between">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center shrink-0 border border-amber-100">
                                            <span class="material-symbols-outlined text-2xl">calculate</span>
                                        </div>
                                        <span class="material-symbols-outlined icon-check text-slate-300 opacity-0 transition-all text-2xl font-bold">check_circle</span>
                                    </div>
                                    <div>
                                        <span class="font-extrabold text-slate-900 block text-base sm:text-lg mb-1">Zakat</span>
                                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Zakat Maal, Zakat Penghasilan / Profesi, Fitrah.</p>
                                    </div>
                                </div>
                            </label>

                            <!-- Sedekah Jariyah -->
                            <label class="option-card cursor-pointer relative block group">
                                <input class="peer sr-only" name="donation_type" onchange="handleTypeChange(this)" type="radio" value="Sedekah" />
                                <div class="option-card-inner border-2 border-slate-200 bg-white hover:border-emerald-500/60 rounded-2xl p-4 sm:p-5 transition-all duration-200 h-full flex flex-col justify-between">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="w-11 h-11 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center shrink-0 border border-teal-100">
                                            <span class="material-symbols-outlined text-2xl">water_drop</span>
                                        </div>
                                        <span class="material-symbols-outlined icon-check text-slate-300 opacity-0 transition-all text-2xl font-bold">check_circle</span>
                                    </div>
                                    <div>
                                        <span class="font-extrabold text-slate-900 block text-base sm:text-lg mb-1">Sedekah Jariyah</span>
                                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Sedekah air bersih, wakaf Qur'an, yatim dhuafa.</p>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </section>

                    <!-- Conditional Steps for Infak Terikat (Manual Pillar & Program Picker) -->
                    <div class="hidden space-y-6" id="infak-terikat-flow">
                        <!-- Step 3: Program Utama (5 Berkah) -->
                        <section class="bg-white rounded-2xl p-5 sm:p-7 shadow-sm border border-slate-200/80">
                            <div class="flex items-center gap-3.5 mb-4 pb-3.5 border-b border-slate-100">
                                <span class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center text-sm sm:text-base border border-emerald-300">3</span>
                                <div>
                                    <h2 class="text-lg sm:text-xl font-bold text-slate-900">Pilih Pilar Program Utama</h2>
                                    <p class="text-xs sm:text-sm text-slate-500">Pilih salah satu dari 5 pilar kebaikan WIZ</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" id="program-utama-buttons">
                                <button type="button" class="cat-btn p-3.5 border-2 border-slate-200 rounded-xl text-slate-700 hover:border-emerald-600 hover:bg-emerald-50/50 transition-all font-bold text-center flex flex-col items-center gap-2 cursor-pointer" onclick="setProgramUtama('Berkah Hidayah', this)">
                                    <span class="material-symbols-outlined text-primary text-2xl">auto_stories</span>
                                    <span class="text-xs sm:text-sm font-extrabold block">BERKAH HIDAYAH</span>
                                    <span class="text-xs text-slate-500">Dakwah</span>
                                </button>
                                <button type="button" class="cat-btn p-3.5 border-2 border-slate-200 rounded-xl text-slate-700 hover:border-emerald-600 hover:bg-emerald-50/50 transition-all font-bold text-center flex flex-col items-center gap-2 cursor-pointer" onclick="setProgramUtama('Berkah Peduli', this)">
                                    <span class="material-symbols-outlined text-primary text-2xl">favorite</span>
                                    <span class="text-xs sm:text-sm font-extrabold block">BERKAH PEDULI</span>
                                    <span class="text-xs text-slate-500">Sosial</span>
                                </button>
                                <button type="button" class="cat-btn p-3.5 border-2 border-slate-200 rounded-xl text-slate-700 hover:border-emerald-600 hover:bg-emerald-50/50 transition-all font-bold text-center flex flex-col items-center gap-2 cursor-pointer" onclick="setProgramUtama('Berkah Juara', this)">
                                    <span class="material-symbols-outlined text-primary text-2xl">school</span>
                                    <span class="text-xs sm:text-sm font-extrabold block">BERKAH JUARA</span>
                                    <span class="text-xs text-slate-500">Pendidikan</span>
                                </button>
                                <button type="button" class="cat-btn p-3.5 border-2 border-slate-200 rounded-xl text-slate-700 hover:border-emerald-600 hover:bg-emerald-50/50 transition-all font-bold text-center flex flex-col items-center gap-2 cursor-pointer" onclick="setProgramUtama('Berkah Sehat', this)">
                                    <span class="material-symbols-outlined text-primary text-2xl">medical_services</span>
                                    <span class="text-xs sm:text-sm font-extrabold block">BERKAH SEHAT</span>
                                    <span class="text-xs text-slate-500">Kesehatan</span>
                                </button>
                                <button type="button" class="cat-btn p-3.5 border-2 border-slate-200 rounded-xl text-slate-700 hover:border-emerald-600 hover:bg-emerald-50/50 transition-all font-bold text-center flex flex-col items-center gap-2 cursor-pointer" onclick="setProgramUtama('Berkah Mandiri', this)">
                                    <span class="material-symbols-outlined text-primary text-2xl">storefront</span>
                                    <span class="text-xs sm:text-sm font-extrabold block">BERKAH MANDIRI</span>
                                    <span class="text-xs text-slate-500">Ekonomi</span>
                                </button>
                            </div>
                        </section>

                        <!-- Step 4: Program Spesifik -->
                        <section class="bg-white rounded-2xl p-5 sm:p-7 shadow-sm border border-slate-200/80">
                            <div class="flex items-center gap-3.5 mb-4 pb-3.5 border-b border-slate-100">
                                <span class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-emerald-100 text-emerald-800 font-extrabold flex items-center justify-center text-sm sm:text-base border border-emerald-300">4</span>
                                <div>
                                    <h2 class="text-lg sm:text-xl font-bold text-slate-900">Pilih Program Spesifik</h2>
                                    <p class="text-xs sm:text-sm text-slate-500">Tentukan program kebaikan spesifik yang ingin Anda bantu</p>
                                </div>
                            </div>
                            <select id="program-spesifik-select" class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl px-4 py-3.5 text-base sm:text-lg text-slate-900 focus:border-emerald-600 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 outline-none font-bold cursor-pointer transition-all" onchange="setProgramSpesifik(this.value)">
                                <option value="">-- Pilih Program Utama Terlebih Dahulu --</option>
                            </select>
                        </section>

                        <!-- Program Detail Card (For general Infak Terikat picker) -->
                        <div id="program-detail-card" class="hidden bg-white rounded-2xl p-5 sm:p-6 border-2 border-emerald-500/30 shadow-md space-y-4 transition-all duration-300">
                            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-emerald-700 text-xl">verified</span>
                                    <span class="text-sm sm:text-base font-bold text-slate-900">Detail &amp; Lokasi Penyaluran Program</span>
                                </div>
                                <span id="detail-card-pillar" class="bg-emerald-600 text-white text-xs sm:text-sm font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider">BERKAH PEDULI</span>
                            </div>

                            <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-start">
                                <div class="relative w-full sm:w-48 h-36 rounded-xl overflow-hidden bg-slate-100 shrink-0 border border-slate-200 shadow-sm">
                                    <img id="detail-card-img" src="/assets/images/foto-utama-wiz.jpg" onerror="this.onerror=null; this.src='/assets/images/foto-utama-wiz.jpg';" alt="Foto Program" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-1 space-y-2.5 min-w-0 w-full">
                                    <h3 id="detail-card-title" class="text-lg sm:text-xl font-extrabold text-slate-900 leading-snug">Nama Program Kebaikan</h3>
                                    
                                    <div class="flex flex-wrap items-center gap-2">
                                        <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1 rounded-lg text-xs sm:text-sm font-semibold">
                                            <span class="material-symbols-outlined text-base text-emerald-700">pin_drop</span>
                                            <span id="detail-card-location">Lokasi: Kepulauan Bangka Belitung</span>
                                        </div>
                                        <div id="detail-card-beneficiary-wrap" class="hidden inline-flex items-center gap-1.5 bg-blue-50 text-blue-800 border border-blue-200 px-3 py-1 rounded-lg text-xs sm:text-sm font-semibold">
                                            <span class="material-symbols-outlined text-base text-blue-700">group</span>
                                            <span id="detail-card-beneficiary">Mustahik &amp; Santri</span>
                                        </div>
                                    </div>

                                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 text-sm text-slate-700 leading-relaxed">
                                        <p id="detail-card-desc" class="whitespace-pre-line font-normal text-slate-800">Deskripsi lengkap program...</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Transparency Notice 12.5% for Infak Terikat -->
                        <div class="bg-emerald-50/80 border border-emerald-200 rounded-2xl p-4 sm:p-5 text-emerald-900 shadow-xs">
                            <div class="flex items-start gap-3.5">
                                <span class="material-symbols-outlined text-emerald-700 text-2xl shrink-0 mt-0.5">verified_user</span>
                                <div>
                                    <p class="font-bold text-emerald-950 text-sm sm:text-base mb-1">Catatan Transparansi Pengelolaan Dana</p>
