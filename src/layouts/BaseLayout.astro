---
import SEO from '../components/common/SEO.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

export interface Props {
    title?: string;
    description?: string;
    image?: string;
    url?: string;
    type?: string;
    keywords?: string;
}

const {
    title = 'WIZ Bangka Belitung - Tebarkan Kebaikan',
    description = 'Wahdah Inspirasi Zakat (WIZ) Bangka Belitung - Lembaga Amil Zakat Terpercaya. Melayani Zakat, Infak, Sedekah & Wakaf untuk pemberdayaan umat di Bangka Belitung.',
    image = '/assets/images/foto-utama-wiz.jpg',
    url,
    type = 'website',
    keywords = 'WIZ Bangka Belitung, Wahdah Inspirasi Zakat, Zakat Babel, Sedekah Bangka, Donasi Online, Zakat Maal, Beasiswa Tahfidz'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth light">
<head>
    <SEO title={title} description={description} image={image} url={url} type={type} keywords={keywords} />
    <slot name="head" />
    <style is:global>
        html, body {
            overflow-x: hidden !important;
            max-width: 100vw !important;
            width: 100%;
        }
        body { background-color: #f9f9ff; color: #141b2b; }
        .shadow-level-1 { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); }
        .shadow-level-2 { box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08); }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .material-symbols-outlined.filled { font-variation-settings: 'FILL' 1; }
    </style>
</head>
<body class="font-body-md text-body-md antialiased bg-background text-on-background min-h-screen flex flex-col selection:bg-primary-container selection:text-on-primary-container">
    <Header />
    
    <main class="flex-grow pt-20 sm:pt-24">
        <slot />
    </main>

    <Footer />

    <!-- Shared Donation Modal -->
    <div id="donation-modal" class="modal-backdrop">
        <div class="modal-dialog">
            <div class="flex justify-between items-center p-lg border-b border-surface-variant sticky top-0 bg-surface rounded-t-xl z-10">
                <h3 id="modal-program-title" class="font-headline-md text-headline-md font-bold text-primary">Formulir Donasi</h3>
                <button onclick="closeDonationModal()" class="text-outline hover:text-on-surface p-xs focus:outline-none cursor-pointer">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form id="shared-donation-form" class="p-lg space-y-md" onsubmit="handleDonationSubmit(event)">
                <div>
                    <label class="block font-label-md text-label-md text-on-surface font-semibold mb-xs">Pilih Nominal Donasi</label>
                    <div class="grid grid-cols-3 gap-xs mb-sm">
                        <button type="button" data-nominal="50000" onclick="setNominal(50000)" class="chip-nominal p-sm border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:border-primary focus:border-primary transition-all text-center cursor-pointer">Rp 50.000</button>
                        <button type="button" data-nominal="100000" onclick="setNominal(100000)" class="chip-nominal p-sm border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:border-primary focus:border-primary transition-all text-center cursor-pointer">Rp 100.000</button>
                        <button type="button" data-nominal="250000" onclick="setNominal(250000)" class="chip-nominal p-sm border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:border-primary focus:border-primary transition-all text-center cursor-pointer">Rp 250.000</button>
                        <button type="button" data-nominal="500000" onclick="setNominal(500000)" class="chip-nominal p-sm border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:border-primary focus:border-primary transition-all text-center cursor-pointer">Rp 500.000</button>
                        <button type="button" data-nominal="1000000" onclick="setNominal(1000000)" class="chip-nominal p-sm border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:border-primary focus:border-primary transition-all text-center cursor-pointer">Rp 1.000.000</button>
                        <button type="button" data-nominal="" onclick="setNominal('')" class="chip-nominal p-sm border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:border-primary focus:border-primary transition-all text-center cursor-pointer">Lainnya</button>
                    </div>
                    <div class="relative">
                        <span class="absolute left-md top-1/2 -translate-y-1/2 font-bold text-primary">Rp</span>
                        <input type="number" id="shared-nominal-input" min="1" class="w-full pl-xl pr-md py-sm border border-outline-variant rounded-lg font-body-md focus:outline-none focus:border-primary" placeholder="Masukkan nominal donasi (Bebas / Tanpa Minimal)"/>
                    </div>
                </div>

                <div>
                    <label class="block font-label-md text-label-md text-on-surface font-semibold mb-xs">Nama Lengkap Donatur</label>
                    <input type="text" id="shared-donor-name" class="w-full px-md py-sm border border-outline-variant rounded-lg font-body-md focus:outline-none focus:border-primary" placeholder="Nama Anda atau hamba Allah"/>
                </div>

                <div>
                    <label class="block font-label-md text-label-md text-on-surface font-semibold mb-xs">Nomor WhatsApp / HP</label>
                    <input type="tel" id="shared-donor-phone" class="w-full px-md py-sm border border-outline-variant rounded-lg font-body-md focus:outline-none focus:border-primary" placeholder="08xxxxxxxxxx"/>
                </div>

                <div>
                    <label class="block font-label-md text-label-md text-on-surface font-semibold mb-xs">Doa / Pesan Kebaikan (Opsional)</label>
                    <textarea id="shared-donor-message" rows="2" class="w-full px-md py-sm border border-outline-variant rounded-lg font-body-md focus:outline-none focus:border-primary" placeholder="Tuliskan doa atau niat donasi Anda..."></textarea>
                </div>

                <button type="submit" class="w-full bg-[#F7941D] text-white font-label-md text-label-md py-md rounded-lg hover:opacity-90 transition-opacity font-bold shadow-md text-center cursor-pointer">
                    Lanjutkan Pembayaran Donasi
                </button>
            </form>
        </div>
    </div>

    <!-- Rich News Detail Modal Reader with Full Content, Gallery & Social Share -->
    <div id="public-news-modal" class="modal-backdrop">
        <div class="modal-dialog max-h-[90vh] overflow-y-auto rounded-2xl shadow-2xl bg-surface border border-outline-variant/30 w-full max-w-3xl">
            <!-- Main Cover Photo -->
            <div class="relative aspect-video w-full overflow-hidden bg-surface-container shrink-0">
                <img id="pub-modal-image" class="w-full h-full object-cover" src="" alt="Dokumentasi Utama Berita">
                <button onclick="closePublicNewsModal()" class="absolute top-4 right-4 bg-black/60 text-white p-2 rounded-full hover:bg-black transition-colors focus:outline-none z-10 shadow-md flex items-center justify-center cursor-pointer">
                    <span class="material-symbols-outlined">close</span>
                </button>
                <div class="absolute bottom-4 left-4 flex gap-2 flex-wrap z-10">
                    <span id="pub-news-category" class="px-3 py-1 bg-primary text-on-primary rounded-full font-caption text-caption font-bold shadow-xs">Kategori</span>
                    <span id="pub-news-event-date" class="px-3 py-1 bg-tertiary-container text-on-tertiary rounded-full font-caption text-caption font-bold shadow-xs">📅 Tanggal Kegiatan</span>
                </div>
            </div>

            <!-- Article Body, Gallery & Share Options -->
            <div class="p-lg md:p-xl space-y-lg">
                <div class="space-y-xs border-b border-outline-variant/30 pb-md">
                    <h3 id="pub-news-title" class="font-headline-md text-headline-md md:text-headline-lg font-bold text-on-surface leading-snug">Judul Berita</h3>
                    <div class="flex items-center gap-2 font-caption text-caption text-on-surface-variant pt-xs">
                        <span class="material-symbols-outlined text-sm text-primary">person</span>
                        <span id="pub-news-meta">Author & Date</span>
                    </div>
                </div>

                <!-- Full Unclipped Article Content -->
                <div id="pub-news-content" class="font-body-md text-body-md text-on-surface leading-relaxed whitespace-pre-line text-justify space-y-md"></div>
                
                <!-- Multi-Photo Gallery Grid -->
                <div id="pub-news-gallery-wrapper" class="hidden space-y-sm pt-md border-t border-outline-variant/30">
                    <h4 class="font-label-md text-label-md font-bold text-on-surface flex items-center gap-xs">
                        <span class="material-symbols-outlined text-primary text-sm">collections</span>
                        <span>Galeri Dokumentasi Kegiatan</span>
                    </h4>
                    <div id="pub-news-gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-md"></div>
                </div>

                <!-- Social Media Share Bar -->
                <div class="pt-lg border-t border-outline-variant/40 bg-surface-container-low p-md rounded-2xl space-y-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-caption font-bold text-on-surface flex items-center gap-xs">
                            <span class="material-symbols-outlined text-primary text-sm">share</span>
                            <span>Bagikan Berita Ini ke Media Sosial:</span>
                        </span>
                        <span id="share-toast" class="hidden font-caption text-caption text-primary font-bold animate-pulse">✓ Link tersalin!</span>
                    </div>

                    <div class="flex items-center gap-xs flex-wrap">
                        <button id="share-wa-btn" onclick="shareArticle('wa')" class="flex-1 min-w-[110px] bg-[#25D366] text-white px-md py-xs rounded-xl font-caption text-caption font-bold hover:brightness-105 transition-all flex items-center justify-center gap-xs shadow-sm cursor-pointer">
                            <span class="material-symbols-outlined text-sm">send</span>
                            <span>WhatsApp</span>
                        </button>
                        <button id="share-fb-btn" onclick="shareArticle('fb')" class="flex-1 min-w-[110px] bg-[#1877F2] text-white px-md py-xs rounded-xl font-caption text-caption font-bold hover:brightness-105 transition-all flex items-center justify-center gap-xs shadow-sm cursor-pointer">
                            <span class="material-symbols-outlined text-sm">public</span>
                            <span>Facebook</span>
                        </button>
                        <button id="share-tw-btn" onclick="shareArticle('tw')" class="flex-1 min-w-[100px] bg-[#000000] text-white px-md py-xs rounded-xl font-caption text-caption font-bold hover:brightness-105 transition-all flex items-center justify-center gap-xs shadow-sm cursor-pointer">
                            <span class="material-symbols-outlined text-sm">tag</span>
                            <span>Twitter / X</span>
                        </button>
                        <button id="share-tg-btn" onclick="shareArticle('tg')" class="flex-1 min-w-[100px] bg-[#229ED9] text-white px-md py-xs rounded-xl font-caption text-caption font-bold hover:brightness-105 transition-all flex items-center justify-center gap-xs shadow-sm cursor-pointer">
                            <span class="material-symbols-outlined text-sm">near_me</span>
                            <span>Telegram</span>
                        </button>
                        <button id="share-copy-btn" onclick="shareArticle('copy')" class="bg-surface-container-high border border-outline-variant text-on-surface px-md py-xs rounded-xl font-caption text-caption font-bold hover:bg-surface-variant transition-colors flex items-center justify-center gap-xs shadow-sm cursor-pointer">
                            <span class="material-symbols-outlined text-sm">content_copy</span>
                            <span>Salin Link</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Core Scripts with Dynamic Cache Buster -->
    <script is:inline src={`/assets/js/supabase-client.js?v=${Date.now()}`}></script>
    <script is:inline src={`/assets/js/admin-store.js?v=${Date.now()}`}></script>
    <script is:inline src={`/assets/js/main.js?v=${Date.now()}`}></script>
    <script is:inline src={`/assets/js/nav-active.js?v=${Date.now()}`}></script>
</body>
</html>
