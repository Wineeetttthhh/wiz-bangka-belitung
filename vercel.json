{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/og-image", "destination": "/api/og-image" },
    { "source": "/program-image/:slug.jpg", "destination": "/api/og-image?type=program&id=:slug" },
    { "source": "/quote-image/:id.jpg", "destination": "/api/og-image?type=quote&id=:id" },
    { "source": "/news-image/:id.jpg", "destination": "/api/og-image?type=news&id=:id" },
    { "source": "/berita-image/:id.jpg", "destination": "/api/og-image?type=news&id=:id" },
    { "source": "/program/:slug", "destination": "/api/program?slug=:slug" },
    { "source": "/quote/:id", "destination": "/api/quote?id=:id" },
    { "source": "/flyer/:id", "destination": "/api/quote?id=:id" }
  ]
}